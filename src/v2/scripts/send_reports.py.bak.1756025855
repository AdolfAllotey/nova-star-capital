import os, sys, pathlib

# Kill switch anti-spam : si le fichier .reports.disabled existe, on sort.

if pathlib.Path("/root/Bot_crypto_ultra/.reports.disabled").exists() or os.getenv("NOVA_SKIP_REPORTS") == "1":

    print("⚠ Envoi des rapports désactivé (kill switch).")

    sys.exit(0)

#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import json
from datetime import datetime, timezone
from pathlib import Path

# Utilitaires internes
from src.v2.utils.file_utils import get_logger
from src.v2.utils.email_utils import send_email_report
from src.v2.utils.telegram_utils import send_telegram_message

def ensure_dir(path: Path):
    """Crée le dossier s’il n’existe pas."""
    path.mkdir(parents=True, exist_ok=True)

# Dossiers
ROOT_DIR = Path(__file__).resolve().parents[3]  # .../Bot_crypto_ultra
DATA_DIR = ROOT_DIR / "src" / "v2" / "data"
REPORTS_DIR = DATA_DIR / "reports"
RISK_DIR = DATA_DIR / "risk"
SIMU_DIR = DATA_DIR / "simulation"
LOGS_DIR = ROOT_DIR / "src" / "v2" / "logs"

ensure_dir(LOGS_DIR)
logger = get_logger("send_reports")

def load_json(p: Path, default):
    try:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                return json.load(f)
    except Exception as e:
        logger.warning(f"⚠️ Impossible de lire {p}: {e}")
    return default

def human_int(n):
    try:
        return f"{int(n):,}".replace(",", " ")
    except Exception:
        return str(n)

def build_message():
    daily = load_json(REPORTS_DIR / "daily_report.json", default={})
    monthly = load_json(REPORTS_DIR / "monthly_pnl.json", default={})
    worst_summary = load_json(RISK_DIR / "worst_trades_summary.json", default={})
    trades = load_json(SIMU_DIR / "trade_simulation.json", default=[])

    date = daily.get("date") or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    pnl_total = daily.get("pnl_total", "N/A")
    win_rate = daily.get("win_rate", "N/A")

    tg = daily.get("telegram_messages", 0)
    tw = daily.get("twitter_posts", 0)
    rd = daily.get("reddit_posts", 0)

    top_tokens = daily.get("top_tokens", [])
    worst_tokens = daily.get("worst_tokens", [])

    llm_summary = worst_summary.get("summary") if isinstance(worst_summary, dict) else None
    if not llm_summary:
        llm_summary = daily.get("summary") or {}

    parts = []
    parts.append(f"📊 Rapport quotidien — Nova Star Capital\n")
    parts.append(f"📅 Date : {date}")
    parts.append(f"💶 PnL total : {pnl_total}")
    parts.append(f"✅ Win Rate : {win_rate}\n")

    parts.append("📣 Activité sociale")
    parts.append(f"• Telegram : {human_int(tg)}")
    parts.append(f"• Twitter  : {human_int(tw)}")
    parts.append(f"• Reddit   : {human_int(rd)}\n")

    if top_tokens:
        parts.append("🏅 Top tokens : " + ", ".join(top_tokens))
    else:
        parts.append("🏅 Top tokens : —")

    if worst_tokens:
        parts.append("⚠️ Worst tokens : " + ", ".join(worst_tokens))
    else:
        parts.append("⚠️ Worst tokens : —")

    if isinstance(llm_summary, dict) and llm_summary:
        parts.append("\n🧠 Résumé LLM (pires trades)")
        for k, v in llm_summary.items():
            parts.append(f"• {k} : {v}")
    else:
        parts.append("\n🧠 Résumé LLM : (aucun)")

    if isinstance(trades, list) and trades:
        parts.append("\n💼 Derniers trades simulés (extrait)")
        for t in trades[:3]:
            action = t.get("action", "?").upper()
            token = t.get("token", "?").upper()
            ex = t.get("exchange", "?")
            amt = t.get("amount", 0)
            ts = t.get("timestamp", "")
            parts.append(f"• {action} {token} @ {ex} — Montant {human_int(amt)} — {ts}")
    else:
        parts.append("\n💼 Derniers trades simulés : (aucun)")

    return "\n".join(parts)

def send_reports():
    logger.info("📤 Préparation de l'envoi du rapport...")
    message = build_message()
    logger.info(f"🧾 Longueur du message : {len(message)}")

    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    subject = f"📉 Rapport quotidien — {today}"

    try:
        sent_email = send_email_report(subject=subject, body=message)
        logger.info(f"✉️ Email envoyé = {sent_email}")
    except Exception as e:
        logger.exception(f"❌ Erreur envoi email : {e}")

    try:
        sent_tg = send_telegram_message(message)
        logger.info(f"📝 Telegram envoyé = {bool(sent_tg)}")
    except Exception as e:
        logger.exception(f"❌ Erreur envoi Telegram : {e}")

    logger.info("✅ Envoi du rapport terminé.")

if __name__ == "__main__":
    send_reports()

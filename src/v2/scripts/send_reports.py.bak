# src/v2/scripts/send_reports.py

from datetime import datetime
from typing import Any, Dict, List, Optional

from src.v2.utils.file_utils import (
    load_json_file,
    get_logger,
)

from src.v2.utils.email_utils import send_email_report
from src.v2.utils.telegram_utils import send_telegram_message

# Logger (un seul argument, selon ta version actuelle)
logger = get_logger("send_reports")


# --- Constantes de chemins ---
DAILY_REPORT_PATH = "src/v2/data/reports/daily_report.json"
WORST_TRADES_PATH = "src/v2/data/risk/worst_trades.json"
WORST_TRADES_SUMMARY_PATH = "src/v2/data/risk/worst_trades_summary.json"


def _safe_load_daily_report() -> Dict[str, Any]:
    """
    Charge le rapport quotidien s'il existe, sinon renvoie un squelette vide.
    """
    data = load_json_file(DAILY_REPORT_PATH)
    if not isinstance(data, dict):
        logger.warning("⚠️ Format inattendu pour daily_report.json, utilisation d'un dict vide.")
        return {}
    return data


def _safe_load_worst_trades() -> List[Dict[str, Any]]:
    """
    Charge la liste des pires trades s'ils existent, sinon renvoie une liste vide.
    """
    data = load_json_file(WORST_TRADES_PATH, default=[])
    if isinstance(data, list):
        return data
    logger.warning("⚠️ Format inattendu pour worst_trades.json, utilisation d'une liste vide.")
    return []


def _safe_load_llm_summary() -> str:
    """
    Charge le résumé LLM (peut être un dict avec 'summary' ou une string plain text).
    Retourne une chaine vide si rien.
    """
    raw = load_json_file(WORST_TRADES_SUMMARY_PATH, default={})
    # Cas 1 : un dict avec clé 'summary'
    if isinstance(raw, dict):
        return str(raw.get("summary", "")).strip()
    # Cas 2 : directement une chaîne
    if isinstance(raw, str):
        return raw.strip()
    return ""


def _fmt_list(values: List[str]) -> str:
    if not values:
        return "—"
    return ", ".join(values)


def _build_message() -> str:
    """
    Construit le message final à envoyer (email + Telegram) à partir
    des différentes sources disponibles. Toujours non-vide.
    """
    daily = _safe_load_daily_report()
    worst_trades = _safe_load_worst_trades()
    llm_summary = _safe_load_llm_summary()

    date_str = daily.get("date") or datetime.utcnow().date().isoformat()
    telegram_count = daily.get("telegram_messages", 0)
    twitter_count = daily.get("twitter_posts", 0)
    reddit_count = daily.get("reddit_posts", 0)
    trade_count = daily.get("trade_count", len(worst_trades))  # fallback raisonnable
    worst_count = daily.get("worst_trade_count", len(worst_trades))

    pnl_total = daily.get("pnl_total")  # peut être None/N/A
    win_rate = daily.get("win_rate")
    top_tokens = daily.get("top_tokens", [])
    worst_tokens = daily.get("worst_tokens", [])

    lines = []
    lines.append(f"📊 Rapport quotidien — Nova Star Capital ({date_str})")
    lines.append("")
    # KPIs haut niveau (avec fallback affichage)
    lines.append(f"• PnL total : {pnl_total if pnl_total not in (None, '') else 'N/A'}")
    lines.append(f"• Win Rate : {win_rate if win_rate not in (None, '') else 'N/A'}")
    lines.append(f"• Top Tokens : {_fmt_list(top_tokens)}")
    lines.append(f"• Worst Tokens : {_fmt_list(worst_tokens)}")
    lines.append("")
    # Volumétrie scrapping
    lines.append("🔎 Activité collectée")
    lines.append(f"• Telegram msgs : {telegram_count}")
    lines.append(f"• Twitter posts : {twitter_count}")
    lines.append(f"• Reddit posts  : {reddit_count}")
    lines.append("")
    # Trades & risques
    lines.append("💥 Pires trades")
    lines.append(f"• Détectés aujourd’hui : {worst_count}")
    lines.append("")
    # Résumé LLM
    if llm_summary:
        lines.append("🧠 Résumé LLM :")
        lines.append(llm_summary.strip())
    else:
        lines.append("ℹ️ Aucun résumé LLM disponible.")

    msg = "\n".join(lines).strip()
    return msg if msg else "📊 Rapport quotidien — (contenu indisponible)"


def send_reports() -> None:
    """
    Envoie le rapport quotidien par email et Telegram.
    - Jamais plantant : catch/log chaque sous-étape.
    """
    logger.info("📤 Préparation de l'envoi du rapport...")

    message = _build_message()
    logger.info("🧾 Longueur du message : %s", len(message))

    # Sujet email basé sur la date trouvée dans le message
    subject = f"📊 Rapport quotidien — Nova Star Capital"

    # Envoi Email
    email_ok: Optional[bool] = None
    try:
        email_ok = send_email_report(subject=subject, body=message)
        logger.info("✉️ Email envoyé = %s", email_ok)
    except Exception as e:
        logger.exception("❌ Erreur lors de l'envoi Email : %s", e)

    # Envoi Telegram
    tg_ok: Optional[bool] = None
    try:
        tg_ok = send_telegram_message(message)
        logger.info("📨 Telegram envoyé = %s", tg_ok)
    except Exception as e:
        logger.exception("❌ Erreur lors de l'envoi Telegram : %s", e)

    logger.info("✅ Envoi du rapport terminé.")


if __name__ == "__main__":
    send_reports()
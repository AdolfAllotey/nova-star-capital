
import os
import shutil
from datetime import datetime, timezone

ARCHIVE_DIR = "data/v2/archive"
TARGET_DIRS = [
    "data/v2/outputs",
    "data/v2/reports",
    "data/v2/logs"
]

os.makedirs(ARCHIVE_DIR, exist_ok=True)

def archive_data():
    """
    Archive les répertoires clés avec horodatage dans le dossier archive.
    """
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    archive_path = os.path.join(ARCHIVE_DIR, f"snapshot_{timestamp}")
    os.makedirs(archive_path, exist_ok=True)

    for target in TARGET_DIRS:
        if os.path.exists(target):
            dest = os.path.join(archive_path, os.path.basename(target))
            shutil.copytree(target, dest)
            print(f"✅ Dossier archivé : {target} -> {dest}")
        else:
            print(f"⛔ Dossier introuvable : {target}")

    print(f"📦 Archive complète créée : {archive_path}")
    return archive_path

if __name__ == "__main__":
    archive_data()

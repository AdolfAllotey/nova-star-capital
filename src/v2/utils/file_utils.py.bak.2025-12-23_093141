# src/v2/utils/file_utils.py
from __future__ import annotations

import json
import os
from datetime import datetime
from pathlib import Path
from typing import Any, List, Optional

from src.v2.utils.logger import get_logger

logger = get_logger("file_utils")



# --- DATA ROOT resolution (PREPROD compatible) ---
DATA_DIR = Path(
    os.environ.get("NSC_DATA_DIR")
    or os.environ.get("NSC_DATA_ROOT")
    or os.environ.get("DATA_ROOT")
    or "/opt/nsc/app/data"
).resolve()

def _resolve_path(path: str | Path) -> Path:
    """Resolve relative paths under DATA_DIR to avoid writing into repo paths like src/v2/data/.."""
    pp = Path(path)
    if pp.is_absolute():
        return pp
    # if caller passes "data/.." or "src/v2/data/..", we still rebase into DATA_DIR
    parts = pp.parts
    # drop leading "src/v2/data" or "src\v2\data" segments if present
    if len(parts) >= 3 and parts[0] == "src" and parts[1] == "v2" and parts[2] == "data":
        pp = Path(*parts[3:]) if len(parts) > 3 else Path()
    # drop leading "data"
    elif len(parts) >= 1 and parts[0] == "data":
        pp = Path(*parts[1:]) if len(parts) > 1 else Path()
    return (DATA_DIR / pp).resolve()
# --- end DATA ROOT resolution ---
# ---------------------------------------------------------
# PATH HELPERS
# ---------------------------------------------------------
def get_root_dir() -> Path:
    """
    Détecte le ROOT_DIR du projet NSC.

    Priorité :
    1) NSC_PROJECT_ROOT (systemd)
    2) NSC_ROOT_DIR (legacy)
    3) Remonte depuis ce fichier jusqu'à /opt/nsc/app (best-effort)
    """
    env = os.getenv("NSC_PROJECT_ROOT") or os.getenv("NSC_ROOT_DIR")
    if env:
        return Path(env)

    # file_utils.py : src/v2/utils/file_utils.py
    # -> parents: utils -> v2 -> src -> app
    return Path(__file__).resolve().parents[3]


def get_data_dir() -> str:
    """
    Source of truth pour la racine DATA.

    Priorité :
    1) NSC_DATA_DIR (systemd)
    2) DATA_ROOT (systemd)
    3) DATA_DIR (legacy)
    4) fallback stable: <project_root>/data   (ex: /opt/nsc/app/data)
    """
    for key in ("NSC_DATA_DIR", "DATA_ROOT", "DATA_DIR"):
        v = os.getenv(key)
        if v and str(v).strip():
            return str(Path(v).expanduser().resolve())

    fallback = get_root_dir() / "data"
    return str(fallback.resolve())


def data_path(*parts: str) -> Path:
    """
    Construit un chemin dans DATA_DIR.
    Exemple: data_path("knowledge", "knowledge_daily_report.json")
    """
    return Path(get_data_dir(), *parts)


# ---------------------------------------------------------
# UTILITAIRE : CRÉER LE DOSSIER SI MANQUANT
# ---------------------------------------------------------
def ensure_directory_exists(path: str) -> None:
    """
    Creates the directory for the file if it does not exist.
    Safe for systemd services writing JSON files.
    """
    try:
        directory = os.path.dirname(path)
        if directory and not os.path.exists(directory):
            os.makedirs(directory, exist_ok=True)
            logger.info(f"Created directory: {directory}")
    except Exception as e:  # noqa: BLE001
        logger.error(f"Failed to ensure directory exists for {path} : {e}")


# ---------------------------------------------------------
# LECTURE JSON AVEC DÉFAUT
# ---------------------------------------------------------
def load_json_file(path: str | Path, default: Any = None) -> Any:
    """
    Loads a JSON file and returns its data.
    If file missing or invalid → returns default.
    """
    try:
        p = str(path)
        if not os.path.exists(p):
            logger.warning(f"JSON file not found: {p} → returning default")
            return default

        with open(p, "r", encoding="utf-8") as f:
            return json.load(f)

    except json.JSONDecodeError as e:
        logger.error(f"JSON decode error in {path}: {e}")
        return default

    except Exception as e:  # noqa: BLE001
        logger.error(f"Error loading JSON file {path}: {e}")
        return default


# ---------------------------------------------------------
# SAUVEGARDE JSON ROBUSTE
# ---------------------------------------------------------
def save_json_file(path: str | Path, data: Any) -> None:
    """
    Saves data to a JSON file with UTF-8 encoding.
    Ensures directory exists before writing.
    """
    try:
        p = str(path)
        ensure_directory_exists(p)

        with open(p, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)

        logger.info(f"Saved JSON file: {p}")

    except Exception as e:  # noqa: BLE001
        logger.error(f"Failed to save JSON file {path}: {e}")


# ---------------------------------------------------------
# UTILITAIRE : TIMESTAMP ISO
# ---------------------------------------------------------
def now_ts() -> str:
    return datetime.utcnow().isoformat() + "Z"


# ---------------------------------------------------------
# TOKENS SÉLECTIONNÉS
# ---------------------------------------------------------
def selected_tokens_path() -> Path:
    # Toujours dans DATA_DIR
    return data_path("selected_tokens.json")


# Backward-compatible alias (used by some modules)
def ensure_dir(path: str) -> None:
    """Alias for ensure_directory_exists (legacy name)."""
    return ensure_directory_exists(path)


def load_selected_tokens() -> List[str]:
    """
    Loads selected tokens from selected_tokens.json.
    If the file is missing or invalid → returns empty list.
    Accepts:
      - {"tokens": [...]}
      - [...]
    """
    tokens = load_json_file(selected_tokens_path(), default=[])

    if isinstance(tokens, dict) and "tokens" in tokens and isinstance(tokens["tokens"], list):
        return [str(x) for x in tokens["tokens"]]

    if isinstance(tokens, list):
        return [str(x) for x in tokens]

    logger.warning("selected_tokens.json format unexpected, returning empty list")
    return []



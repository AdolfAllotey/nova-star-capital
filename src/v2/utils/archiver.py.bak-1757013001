# src/v2/utils/archiver.py

import os
import shutil
from datetime import datetime, timezone

ARCHIVE_DIR = "archive/v2"
FILES_TO_ARCHIVE = [
    "data/v2/simulation/",
    "data/v2/logs/",
    "data/v2/reports/",
    "data/v2/portfolio/",
    "data/v2/signals/",
]

os.makedirs(ARCHIVE_DIR, exist_ok=True)


def archive_data():
    """
    Archive les données critiques de la V2 avec datation.
    """
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    destination = os.path.join(ARCHIVE_DIR, f"backup_{timestamp}")
    os.makedirs(destination)

    for path in FILES_TO_ARCHIVE:
        if os.path.exists(path):
            folder_name = os.path.basename(os.path.normpath(path))
            dest_path = os.path.join(destination, folder_name)
            try:
                shutil.copytree(path, dest_path)
                print(f"📁 Archivé : {path} → {dest_path}")
            except Exception as e:
                print(f"❌ Erreur lors de la copie de {path} : {e}")
        else:
            print(f"⚠️ Chemin non trouvé : {path}")

    print(f"✅ Archivage terminé dans {destination}")
    return destination


if __name__ == "__main__":
    archive_data()
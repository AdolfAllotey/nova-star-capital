import os
import json
import csv
from datetime import datetime, timezone
from src.v2.utils.logger import get_logger

logger = get_logger("file_utils")

def ensure_directory_exists(path):
    if isinstance(path, list):
        for p in path:
            os.makedirs(os.path.dirname(p), exist_ok=True)
    else:
        os.makedirs(os.path.dirname(path), exist_ok=True)

def save_json_file(path, data):
    try:
        ensure_directory_exists(path)
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=4, ensure_ascii=False)
        logger.info(f"✅ Fichier sauvegardé : {path}")
    except Exception as e:
        logger.error(f"❌ Erreur lors de la sauvegarde JSON ({path}) : {e}")

def load_json_file(path, default=None, fallback=None):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        if default is not None:
            return default
        elif fallback is not None:
            return fallback
        else:
            raise
    except json.JSONDecodeError:
        return fallback if fallback is not None else default

def save_csv_file(path, data, headers=None):
    try:
        ensure_directory_exists(path)
        with open(path, 'w', newline='', encoding='utf-8') as f:
            writer = csv.DictWriter(f, fieldnames=headers or data[0].keys())
            writer.writeheader()
            writer.writerows(data)
        logger.info(f"✅ Fichier CSV sauvegardé : {path}")
    except Exception as e:
        logger.error(f"❌ Erreur lors de la sauvegarde CSV ({path}) : {e}")

def load_selected_tokens(path='src/v2/data/selected_tokens.json'):
    try:
        tokens = load_json_file(path, default=[])
        if not isinstance(tokens, list):
            logger.warning(f"⚠️ Format inattendu dans selected_tokens.json : {type(tokens)}")
            return []
        return tokens
    except Exception as e:
        logger.error(f"❌ Erreur lors du chargement des tokens sélectionnés : {e}")
        return []

def load_text_file(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        logger.warning(f"⚠️ Fichier texte introuvable : {path}")
        return ""

def get_today_date_str():
    return datetime.now().strftime("%Y-%m-%d")

def get_now_time_str():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
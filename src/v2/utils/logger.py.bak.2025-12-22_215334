import logging
import os
import sys

_LOG_LEVEL = os.getenv("NSC_LOG_LEVEL", "INFO").upper()

logging.basicConfig(
    level=getattr(logging, _LOG_LEVEL, logging.INFO),
    format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    stream=sys.stdout,
)

def get_logger(name: str):
    return logging.getLogger(name)

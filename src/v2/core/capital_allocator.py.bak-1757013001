import json
import os
from datetime import datetime, timezone
from src.v2.utils.logger import get_logger

logger = get_logger("capital_allocator")

# 📁 Emplacements des fichiers
FINAL_SCORES_PATH = "src/v2/data/scores/final_scores.json"
GLOBAL_PERFORMANCE_PATH = "src/v2/data/scores/global_performance.json"
ALLOCATION_LOG_PATH = "src/v2/data/scores/allocations.json"

# ⚙️ Paramètres
THRESHOLD_INVESTED = 10_000
TAX_RATE = 0.25

def load_json(path):
    if os.path.exists(path):
        with open(path, "r") as f:
            return json.load(f)
    return {}

def save_json(path, data):
    with open(path, "w") as f:
        json.dump(data, f, indent=2)

def allocate_gains():
    global_perf = load_json(GLOBAL_PERFORMANCE_PATH)
    total_invested = global_perf.get("total_invested", 0)
    total_gains = global_perf.get("total_gains", 0)

    if total_gains <= 0:
        logger.info("Aucun gain à redistribuer.")
        return

    # 💰 Étape 1 : Prélèvement fiscal
    taxes = total_gains * TAX_RATE
    remaining = total_gains - taxes

    # 💸 Étape 2 : Réaffectation
    if total_invested >= THRESHOLD_INVESTED:
        allocations = {
            "reinvested_into_trades": round(remaining * 0.50, 2),
            "crypto_long_term": round(remaining * 0.30, 2),
            "security_fund": round(remaining * 0.07, 2),
            "bfr": round(remaining * 0.10, 2),
            "enterprise_account": round(remaining * 0.03, 2)
        }
    else:
        # Si sous le seuil, tout est réinvesti
        allocations = {
            "reinvested_into_trades": round(remaining, 2),
            "crypto_long_term": 0,
            "security_fund": 0,
            "bfr": 0,
            "enterprise_account": 0
        }

    # 🔁 Log de l’allocation
    log_entry = {
        "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "gains": total_gains,
        "taxes_paid": round(taxes, 2),
        "total_invested": total_invested,
        "allocations": allocations
    }

    old_log = load_json(ALLOCATION_LOG_PATH)
    if not isinstance(old_log, list):
        old_log = []
    old_log.append(log_entry)
    save_json(ALLOCATION_LOG_PATH, old_log)

    logger.info(f"Allocation effectuée : {allocations}")

if __name__ == "__main__":
    allocate_gains()

# src/v2/core/archiver.py

import os
import shutil
from datetime import datetime, timezone

ARCHIVE_DIR = "archive"
os.makedirs(ARCHIVE_DIR, exist_ok=True)

def archive_files():
    today = datetime.now().strftime("%Y-%m-%d")
    day_dir = os.path.join(ARCHIVE_DIR, today)
    os.makedirs(day_dir, exist_ok=True)

    files_to_archive = {
        "Rapport HTML": ("data/v2/reports/report.html", os.path.join(day_dir, f"{today}_report.html")),
        "Rapport JSON": ("data/simulation/trades.json", os.path.join(day_dir, f"{today}_trades.json")),
        "LLM Log": ("data/v2/logs/llm_calls.log", os.path.join(day_dir, "llm_calls.log")),
        "Gain Protection Log": ("data/v2/logs/gain_protection.log", os.path.join(day_dir, "gain_protection.log")),
        "Config utilisateur": ("src/v2/config/users.json", os.path.join(day_dir, f"users_{today}.json"))
    }

    for label, (src, dst) in files_to_archive.items():
        try:
            if os.path.exists(src):
                shutil.copy2(src, dst)
                print(f"📁 Archivé {label} → {dst}")
            else:
                print(f"⚠️ Fichier introuvable pour {label} : {src}")
        except Exception as e:
            print(f"❌ Erreur d’archivage {label} : {e}")

if __name__ == "__main__":
    archive_files()

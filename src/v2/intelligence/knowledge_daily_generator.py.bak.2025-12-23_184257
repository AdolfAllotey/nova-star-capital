# ----------------------------------------
# Helpers
# ----------------------------------------

def now_utc_iso():
    return (
        dt.datetime.now(dt.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def today_str():
    return dt.datetime.now(dt.timezone.utc).date().isoformat()


# ----------------------------------------
# 1) Market Summary
# ----------------------------------------

def build_market_summary() -> Dict[str, Any]:
    regime_data = load_json_file(PATH_MARKET_REGIME, default={})
    cond_data = load_json_file(PATH_MARKET_CONDITIONS, default={})
    coh_data = load_json_file(PATH_MARKET_COHERENCE, default={})

    regime = regime_data.get("regime", "unknown")
    risk_mode = regime_data.get("risk_mode", "unknown")

    conditions_regime = cond_data.get("regime", "unknown")
    conditions_flag = cond_data.get("global_flag", cond_data.get("flag", "unknown"))
    cond_reasons = cond_data.get("reasons", [])

    coherence_flag = coh_data.get("coherence_flag", coh_data.get("flag", "unknown"))
    coh_reasons = coh_data.get("reasons", ["Aucune donnée de cohérence de marché exploitable – score neutre."])

    bullets = [
        f"Régime global du marché = {regime} (risk_mode={risk_mode}, env=PREPROD).",
        f"Conditions de marché = {conditions_regime}, flag global = {conditions_flag}.",
        f"Cohérence du marché = {coherence_flag}.",
        "Raisons (Market Conditions Engine) :",
    ]

    for r in cond_reasons:
        bullets.append(f"- {r}")

    bullets.append("Raisons (Market Coherence Engine) :")
    for r in coh_reasons:
        bullets.append(f"- {r}")

    return {
        "regime": regime,
        "risk_mode": risk_mode,
        "conditions_regime": conditions_regime,
        "conditions_flag": conditions_flag,
        "coherence_flag": coherence_flag,
        "bullets": bullets,
    }


# ----------------------------------------
# 2) NSC Behavior Summary
# ----------------------------------------

def build_nsc_behavior() -> Dict[str, Any]:
    sig = load_json_file(PATH_SIGNAL_QUALITY, default={})
    real_prod = load_json_file(PATH_REAL_PROD, default={})

    sig_regime = sig.get("regime", "unknown")
    sig_flag = sig.get("quality_flag", sig.get("flag", "unknown"))
    sig_score = sig.get("score", 50.0)

    rp_phase = real_prod.get("current_phase", "unknown")
    rp_status = real_prod.get("phase_status", {}).get("status", "unknown")
    rp_checks_total = real_prod.get("phase_status", {}).get("nb_checks_total", 0)
    rp_checks_ok = real_prod.get("phase_status", {}).get("nb_checks_ok", 0)
    rp_reasons = real_prod.get("reasons", [])

    bullets = [
        f"Qualité globale des signaux = {sig_regime} (flag={sig_flag}, score={sig_score:.2f}).",
        f"Real Production Protocol : phase actuelle = {rp_phase}, statut = {rp_status} ({rp_checks_ok}/{rp_checks_total} checks validés).",
        "Raisons (Signal Quality Engine) :"
    ]

    for r in sig.get("reasons", []):
        bullets.append(f"- {r}")

    bullets.append("Raisons (Real Production Protocol) :")
    for r in rp_reasons:
        bullets.append(f"- {r}")

    bullets.append("Note: l'intégration détaillée Orchestrator / Risk Engine Pro / Execution Engine Pro sera ajoutée dès que leurs JSON de state seront stabilisés.")

    return {
        "signal_quality": {
            "regime": sig_regime,
            "flag": sig_flag,
            "score": sig_score
        },
        "real_production_protocol": {
            "current_phase": rp_phase,
            "phase_status": rp_status,
            "nb_checks_total": rp_checks_total,
            "nb_checks_ok": rp_checks_ok
        },
        "bullets": bullets
    }


# ----------------------------------------
# 3) Trade Case Study (si possible)
# ----------------------------------------

def build_trade_case_study() -> Dict[str, Any]:
    worst = load_json_file(PATH_WORST_TRADES, default={})
    executed = load_json_file(PATH_EXECUTED_TRADES, default={})

    if executed and isinstance(executed, dict) and executed.get("trades"):
        return {
            "has_case": True,
            "trade": executed["trades"][-1],
            "reason": "Analyse du dernier trade exécuté."
        }

    if worst and isinstance(worst, dict) and worst.get("worst_trades"):
        return {
            "has_case": True,
            "trade": worst["worst_trades"][0],
            "reason": "Analyse du pire trade (worst_trades)."
        }

    return {
        "has_case": False,
        "reason": "Aucun trade intéressant n'a été trouvé aujourd'hui (ou les fichiers de trades ne sont pas disponibles)."
    }


# ----------------------------------------
# 4) To Learn Today
# ----------------------------------------

def build_to_learn_today() -> Dict[str, Any]:
    concepts = [
        "Macro & Market Regime – gestion des phases neutres / instables",
        "Market Conditions Engine Pro",
        "Real Production Protocol – pre-flight, shadow, canary, full prod",
    ]

    modules = [
        "crypto_saison_2",
        "real_production_protocol"
    ]

    bullets = [
        "Concepts clés à revoir aujourd'hui :",
        f"- {concepts[0]}",
        f"- {concepts[1]}",
        f"- {concepts[2]}",
        "Modules NSC Academy à revisiter :",
        f"- {modules[0]}",

    ]

    return {
        "concepts": concepts,
        "modules": modules,
        "exercises": [],
        "bullets": bullets
    }


# ----------------------------------------
# 5) Knowledge Score
# ----------------------------------------

def compute_knowledge_score(
    behavior: Dict[str, Any],
    to_learn: Dict[str, Any],
) -> Dict[str, Any]:

    nb_concepts = len(to_learn.get("concepts", []))
    nb_modules = len(to_learn.get("modules", []))

    load_factor = min(nb_concepts + nb_modules, 8)
    penalty = load_factor * 3.0

    base = 70.0
    score = max(0.0, min(100.0, base - penalty))

    if score >= 70:
        flag = "ok"
    elif score >= 40:
        flag = "caution"
    else:
        flag = "danger"

    return {
        "score": round(score, 2),
        "flag": flag,
        "nb_concepts": nb_concepts,
        "nb_modules": nb_modules,
    }


# ----------------------------------------
# MAIN GENERATOR
# ----------------------------------------

def generate_daily_report():
    logger.info("[knowledge_daily_generator] DATA_DIR=%s, env=PREPROD", DATA_DIR)

    market_summary = build_market_summary()
    behavior = build_nsc_behavior()
    case_study = build_trade_case_study()
    to_learn = build_to_learn_today()

    score_data = compute_knowledge_score(behavior, to_learn)

    result = {
        "timestamp": now_utc_iso(),
        "env": "PREPROD",
        "date": today_str(),
        "knowledge_score": score_data["score"],
        "knowledge_flag": score_data["flag"],
        "sections": {
            "market_summary": market_summary,
            "nsc_behavior": behavior,
            "trade_case_study": case_study,
            "to_learn_today": to_learn,
        },
        "metrics": {
            "nb_concepts_to_learn": score_data["nb_concepts"],
            "nb_modules_to_revisit": score_data["nb_modules"],
        }
    }

    # Save
    save_json_file(OUTPUT_MAIN, result)
    dated = os.path.join(KNOWLEDGE_DIR, f"knowledge_daily_report_{today_str()}.json")
    save_json_file(dated, result)

    logger.info(
        "[knowledge_daily_generator] knowledge_daily_report sauvegardé (flag=%s, score=%.2f)",
        score_data["flag"], score_data["score"]
    )

    # Optional event bus
    if MessageBus:
        try:
            mb = MessageBus(events_path=os.path.join(DATA_DIR, "telemetry/event_bus.jsonl"))
            severity = "info" if score_data["flag"] == "ok" else (
                "warning" if score_data["flag"] == "caution" else "error"
            )
            mb.publish("knowledge.state", "knowledge_daily_generator", severity, result)
        except Exception as e:
            logger.warning("[knowledge_daily_generator] EventBus erreur: %s", e)
    else:
        logger.warning("[knowledge_daily_generator] MessageBus introuvable – aucun event knowledge.state ne sera publié.")


# ----------------------------------------
# Entry point
# ----------------------------------------

if __name__ == "__main__":
    generate_daily_report()
# ---------------------------------------------------------------------------
# Entrypoint (compat daily_trading_loop)
# ---------------------------------------------------------------------------
def main() -> dict:
    """
    Entrypoint standard pour la boucle journalière.
    Essaie d'appeler une fonction existante si le module en expose déjà une.
    Retourne toujours un dict (même en noop).
    """
    try:
        # Essaye plusieurs noms "probables" sans casser l'existant
        for fn_name in (
            "run",
            "generate",
            "build",
            "compute",
            "execute",
            "generate_daily",
            "generate_report",
            "generate_knowledge_daily",
            "build_signal_quality",
            "compute_signal_quality",
        ):
            fn = globals().get(fn_name)
            if callable(fn):
                out = fn()
                return out if isinstance(out, dict) else {"status": "ok", "result": out}

        # Noop safe si aucune fonction évidente n'existe
        try:
            logger.info("[%s] main() noop: aucune fonction run/generate/build trouvée", __name__)
        except Exception:
            pass
        return {"status": "noop", "module": __name__}

    except Exception as e:  # noqa: BLE001
        try:
            logger.exception("[%s] main() failed: %s", __name__, e)
        except Exception:
            pass
        return {"status": "error", "module": __name__, "error": str(e)}


if __name__ == "__main__":
    res = main()
    try:
        print(res)
    except Exception:
        pass

#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Scraper Telegram robuste (Telethon)
- Lecture des groupes via TELEGRAM_GROUPS (CSV) ou TELEGRAM_GROUPS_FILE
- Nettoyage/filtrage des entrées (pas de @, pas de vides, déduplication)
- Limite TELEGRAM_MESSAGE_LIMIT (défaut 50)
- Sauvegarde JSON -> src/v2/data/social/telegram_data.json
- Logs -> src/v2/logs/telegram_scraper_YYYY-MM-DD.log
"""

import os
# --- Patch loader TELEGRAM_GROUPS ---
import os
TELEGRAM_GROUPS = os.getenv("TELEGRAM_GROUPS", "")
TELEGRAM_GROUPS_FILE = os.getenv("TELEGRAM_GROUPS_FILE", "src/v2/data/social/groups.txt")
if not TELEGRAM_GROUPS and os.path.isfile(TELEGRAM_GROUPS_FILE):
    with open(TELEGRAM_GROUPS_FILE) as f:
        TELEGRAM_GROUPS = ",".join([l.strip() for l in f if l.strip()])
print(f"[DEBUG] TELEGRAM_GROUPS loaded = {TELEGRAM_GROUPS[:120]}...")
# --- Fin patch loader ---
import json
import asyncio
from datetime import datetime
from typing import List, Dict, Any

# === Logging ===============================================================
try:
    from src.v2.utils.file_utils import get_logger
except Exception:
    # Fallback minimal si util non dispo
    import logging
    def get_logger(name: str, log_file: str = None):
        logger = logging.getLogger(name)
        logger.setLevel(logging.INFO)
        fmt = logging.Formatter("%(asctime)s - %(levelname)s - %(message)s")
        ch = logging.StreamHandler()
        ch.setFormatter(fmt)
        logger.handlers = []
        logger.addHandler(ch)
        if log_file:
            os.makedirs(os.path.dirname(log_file), exist_ok=True)
            fh = logging.FileHandler(log_file, encoding="utf-8")
            fh.setFormatter(fmt)
            logger.addHandler(fh)
        return logger

# === Constantes chemins ====================================================
ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
DATA_DIR = os.path.join(ROOT, "src", "v2", "data", "social")
LOG_DIR = os.path.join(ROOT, "src", "v2", "logs")
OUTPUT_JSON = os.path.join(DATA_DIR, "telegram_data.json")
LOG_FILE = os.path.join(LOG_DIR, f"telegram_scraper_{datetime.utcnow().strftime('%Y-%m-%d')}.log")

logger = get_logger("telegram_scraper")

def ensure_dir(path: str) -> None:
    os.makedirs(path, exist_ok=True)

# === Lecture des variables d'environnement =================================
def getenv_str(key: str, default: str = "") -> str:
    v = os.getenv(key, default)
    return v if v is not None else default

def getenv_int(key: str, default: int) -> int:
    raw = os.getenv(key, "")
    if raw is None or str(raw).strip() == "":
        return default
    try:
        return int(str(raw).strip())
    except Exception:
        logger.warning("⚠️ Var %s invalide (%r) -> fallback %d", key, raw, default)
        return default

def load_groups() -> List[str]:
    groups_env = getenv_str("TELEGRAM_GROUPS", "").strip()
    file_path = getenv_str("TELEGRAM_GROUPS_FILE", "").strip()

    groups: List[str] = []
    if groups_env:
        parts = [p.strip().lstrip("@") for p in groups_env.split(",")]
        groups = [p for p in parts if p]
    else:
        if not file_path:
            # défaut : src/v2/data/social/groups.txt
            file_path = os.path.join(DATA_DIR, "groups.txt")
        if os.path.exists(file_path):
            with open(file_path, "r", encoding="utf-8") as f:
                parts = [ln.strip().lstrip("@") for ln in f if ln.strip()]
                groups = [p for p in parts if p]
        else:
            logger.warning("⚠️ TELEGRAM_GROUPS_FILE absent: %s", file_path)

    # déduplication en conservant l’ordre
    seen = set()
    dedup = []
    for g in groups:
        if g not in seen:
            seen.add(g)
            dedup.append(g)

    logger.info("📥 %d groupes après nettoyage: %s", len(dedup), dedup[:10])
    return dedup

# === Telethon client =======================================================
def build_client_session_path() -> str:
    # session dans la racine projet pour réutilisation
    return os.path.join(ROOT, "session_scraper.session")

def telethon_available() -> bool:
    try:
        import telethon  # noqa: F401
        return True
    except Exception:
        return False

async def fetch_messages_for_group(client, group: str, limit: int) -> Dict[str, Any]:
    """
    Récupère jusqu'à `limit` messages pour un groupe (nom @username, lien, id).
    Renvoie un dict avec infos + messages basiques.
    """
    from telethon.errors.rpcerrorlist import UsernameInvalidError, UsernameNotOccupiedError
    from telethon.tl.types import InputPeerChannel, InputPeerChat

    try:
        if not group:
            raise ValueError("Nom de groupe vide")

        logger.info("🔍 Résolution entité: %r", group)
        entity = await client.get_entity(group)  # accepte username, t.me/..., id
        if entity is None:
            raise ValueError("entity None après get_entity")

        # Récup messages
        out_msgs = []
        async for m in client.iter_messages(entity, limit=limit):
            out_msgs.append({
                "id": m.id,
                "date": m.date.isoformat() if m.date else None,
                "message": m.message or "",
                "sender_id": getattr(m, "sender_id", None),
                "views": getattr(m, "views", None),
                "forwards": getattr(m, "forwards", None),
                "replies": getattr(getattr(m, "replies", None), "replies", None),
            })

        return {
            "group": group,
            "entity_id": getattr(entity, "id", None),
            "title": getattr(entity, "title", getattr(entity, "username", None)),
            "count": len(out_msgs),
            "messages": out_msgs,
        }

    except (UsernameInvalidError, UsernameNotOccupiedError) as e:
        logger.warning("⚠️ Username invalide/non occupé (%r): %s", group, e)
    except ValueError as e:
        logger.warning("⚠️ Valeur invalide pour %r : %s", group, e)
    except Exception as e:
        logger.warning("⚠️ Erreur lors du scraping de %r : %s", group, e)

    return {
        "group": group,
        "count": 0,
        "messages": []
    }

async def main_async():
    if not telethon_available():
        logger.error("❌ Telethon non installé. `pip install telethon` dans le venv.")
        return 1

    from telethon import TelegramClient

    api_id = getenv_str("TELEGRAM_API_ID").strip()
    api_hash = getenv_str("TELEGRAM_API_HASH").strip()
    if not api_id or not api_hash:
        logger.error("❌ TELEGRAM_API_ID / TELEGRAM_API_HASH manquants dans l'env (.env v2).")
        return 1

    try:
        api_id_int = int(api_id)
    except Exception:
        logger.error("❌ TELEGRAM_API_ID invalide (%r) — doit être un entier.", api_id)
        return 1

    limit = getenv_int("TELEGRAM_MESSAGE_LIMIT", 50)
    groups = load_groups()
    if not groups:
        logger.warning("⚠️ Aucun groupe à scraper. Arrêt.")
        return 0

    session_path = build_client_session_path()
    logger.info("🚀 Connexion au client Telegram...")
    async with TelegramClient(session_path, api_id_int, api_hash) as client:
        logger.info("✅ Client connecté.")
        logger.info("📥 %d groupes à scraper", len(groups))

        results = []
        for g in groups:
            if not g:
                logger.warning("Entrée vide ignorée.")
                continue
            logger.info("🔎 Scraping groupe: %r (limit=%d)", g, limit)
            data = await fetch_messages_for_group(client, g, limit)
            results.append(data)

    # Sauvegarde
    ensure_dir(DATA_DIR)
    with open(OUTPUT_JSON, "w", encoding="utf-8") as f:
        json.dump(results, f, ensure_ascii=False, indent=2)
    logger.info("📦 Données Telegram sauvegardées dans %s", os.path.relpath(OUTPUT_JSON, ROOT))
    return 0

def main():
    try:
        rc = asyncio.run(main_async())
        return rc if isinstance(rc, int) else 0
    except KeyboardInterrupt:
        logger.info("⏹️ Interrompu par l’utilisateur.")
        return 130
    except Exception as e:
        logger.exception("❌ Exception non gérée: %s", e)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())

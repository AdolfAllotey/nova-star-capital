{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novastarcapital.local/schemas/artifact_collection.schema.json",
  "title": "Nova Star Capital Artifact Collection Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "package_dir",
    "started_at",
    "completed_at",
    "status",
    "artifacts",
    "issues",
    "summary",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "package_dir": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAILED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "role",
        "source_path",
        "package_path",
        "sha256",
        "size_bytes",
        "required",
        "metadata"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "package_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "issue_type",
        "artifact_id",
        "message",
        "blocking"
      ],
      "properties": {
        "issue_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "required_expected",
        "required_collected",
        "optional_collected",
        "total_collected",
        "aggregate_sha256",
        "source_mutation_detected"
      ],
      "properties": {
        "required_expected": {
          "type": "integer",
          "minimum": 0
        },
        "required_collected": {
          "type": "integer",
          "minimum": 0
        },
        "optional_collected": {
          "type": "integer",
          "minimum": 0
        },
        "total_collected": {
          "type": "integer",
          "minimum": 0
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_mutation_detected": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novastarcapital.local/schemas/baseline_validation.schema.json",
  "title": "Nova Star Capital Baseline Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "baseline_id",
    "release",
    "started_at",
    "completed_at",
    "status",
    "checks",
    "summary",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "audit_id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "release": {
      "type": "string",
      "const": "RC1"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAILED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "domain",
        "status",
        "message",
        "blocking",
        "expected",
        "observed",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "WARNING",
            "FAIL"
          ]
        },
        "message": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "expected": {},
        "observed": {},
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "warnings",
        "blocking_failures",
        "total_checks",
        "aggregate_sha256",
        "package_integrity_sha256"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_failures": {
          "type": "integer",
          "minimum": 0
        },
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "aggregate_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_integrity_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novastarcapital.local/schemas/rc1_audit_package_manifest.schema.json",
  "title": "Nova Star Capital RC1 Audit Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "release",
    "baseline_id",
    "package_status",
    "created_at",
    "package_root",
    "provider",
    "audit_mode",
    "baseline_aggregate_sha256",
    "collection_aggregate_sha256",
    "package_readiness_sha256",
    "files",
    "objectives",
    "constraints",
    "deliverables",
    "recommendation_categories",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "const": "RC1"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "package_status": {
      "type": "string",
      "const": "READY_FOR_PROVIDER_AUDIT"
    },
    "created_at": {
      "type": "string"
    },
    "package_root": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "const": "NONE"
    },
    "audit_mode": {
      "type": "string",
      "const": "READ_ONLY_RECOMMENDATION_ONLY"
    },
    "baseline_aggregate_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_aggregate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_readiness_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "recommendation_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "sha256",
        "size_bytes",
        "required_for_audit",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "required_for_audit": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}

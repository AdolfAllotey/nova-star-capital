from __future__ import annotations
import csv
from pathlib import Path
from datetime import datetime
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[3]
TRADES_CSV = ROOT / "src" / "v2" / "data" / "trading" / "trades.csv"
OUT_CSV    = ROOT / "src" / "v2" / "data" / "reporting" / "monthly_pnl.csv"

def write_daily_pnl_from_trades(tz_name: str = "Europe/Paris",
                                trades_csv: Path = TRADES_CSV,
                                out_csv: Path = OUT_CSV) -> int:
    tz = ZoneInfo(tz_name)
    by_day: dict[str, float] = {}

    with trades_csv.open(newline="", encoding="utf-8") as f:
        r = csv.DictReader(f)
        for row in r:
            ts = (row.get("timestamp") or "").strip()
            v  = (row.get("pnl_usd") or row.get("pnl") or "").strip()
            if not ts or not v:
                continue
            try:
                pnl = float(v)
            except Exception:
                continue

            # Parse ISO (avec ou sans 'Z' / micros)
            ts2 = ts.replace("Z", "+00:00") if ts.endswith("Z") else ts
            try:
                dt = datetime.fromisoformat(ts2)
            except Exception:
                try:
                    dt = datetime.fromisoformat(ts2.split(".")[0])
                except Exception:
                    continue

            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=ZoneInfo("UTC"))

            d_local = dt.astimezone(tz).date().isoformat()
            by_day[d_local] = by_day.get(d_local, 0.0) + pnl

    rows = sorted(by_day.items())
    out_csv.parent.mkdir(parents=True, exist_ok=True)
    with out_csv.open("w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["date","pnl_usd"])
        for d, v in rows:
            w.writerow([d, f"{v:.2f}"])
    return len(rows)

if __name__ == "__main__":
    n = write_daily_pnl_from_trades()
    print(f"✅ monthly_pnl.csv recalculé pour {n} jours")

# src/v2/reporting/monthly_pnl.py
import csv, os, logging
from datetime import datetime, timezone
log = logging.getLogger(__name__)

def update_monthly_pnl() -> bool:
    """
    Stub: agrège rapidement trades.csv du jour et appende dans monthly_pnl.csv
    """
    try        :
        trades = "src/v2/data/trading/trades.csv"
        if not os.path.exists(trades):
            log.info("ℹ️ PnL mensuel: aucun trade (fichier absent).")
            return True

        # somme du jour (UTC)
        today = datetime.now(timezone.utc).date().isoformat()
        total = 0.0
        with open(trades, newline="", encoding="utf-8") as f:
            r = csv.DictReader(f)
            for row in r:
                try:
                    ts = row["timestamp"][:10]  # YYYY-MM-DD
                    if ts == today:
                        total += float(row["pnl_usd"])
                except Exception:
                    pass

        out_dir = "src/v2/data/reporting"
        os.makedirs(out_dir, exist_ok=True)
        out_file = os.path.join(out_dir, "monthly_pnl.csv")
        write_header = not os.path.exists(out_file)
        with open(out_file, "a", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            if write_header: w.writerow(["date","pnl_usd"])
            w.writerow([today, round(total, 2)])

        log.info("📊 PnL mensuel: ajouté %s => %.2f USD dans %s", today, total, out_file)
        return True
    except Exception as e:
        log.warning("⚠️ update_monthly_pnl: %s", e)
        return False

import os
import json
from datetime import datetime, timezone
from src.v2.utils.telegram_utils import send_telegram_message
from src.v2.utils.logger import get_logger

logger = get_logger("report_generator")

SIMULATION_FOLDER = "src/v2/data/simulation"
REPORT_FOLDER = "src/v2/data/reports"

def load_simulation_data():
    today = datetime.now().strftime("%Y-%m-%d")
    filepath = os.path.join(SIMULATION_FOLDER, f"{today}_simulated_trades.json")
    
    if not os.path.exists(filepath):
        logger.warning(f"❌ Fichier simulation introuvable : {filepath}")
        return []

    with open(filepath, "r") as f:
        return json.load(f)

def format_report(trades):
    today = datetime.now().strftime("%Y-%m-%d")
    lines = [f"📊 Rapport de simulation du {today}", "-" * 40]

    if not trades:
        lines.append("Aucun trade simulé aujourd'hui.")
        return "\n".join(lines)

    total_pnl = sum(t["pnl"] for t in trades)
    gainers = sum(1 for t in trades if t["pnl"] > 0)
    losers = sum(1 for t in trades if t["pnl"] < 0)

    for t in trades:
        lines.append(f"• {t['token']} | Entrée: {t['entry_price']} | Sortie: {t['exit_price']} | PnL: {t['pnl']} USDT ({t['outcome']})")

    lines.append("-" * 40)
    lines.append(f"Résultat global : {round(total_pnl, 2)} USDT")
    lines.append(f"📈 Trades gagnants : {gainers} | 📉 Perdants : {losers}")

    return "\n".join(lines)

def save_report(content):
    os.makedirs(REPORT_FOLDER, exist_ok=True)
    today = datetime.now().strftime("%Y-%m-%d")
    filepath = os.path.join(REPORT_FOLDER, f"{today}_report.txt")

    with open(filepath, "w") as f:
        f.write(content)

    logger.info(f"✅ Rapport sauvegardé dans : {filepath}")
    return filepath

def generate_and_send_report():
    trades = load_simulation_data()
    content = format_report(trades)
    path = save_report(content)

    try:
        send_telegram_message(content)
        logger.info("✅ Rapport envoyé sur Telegram.")
    except Exception as e:
        logger.error(f"❌ Échec de l’envoi Telegram : {e}")

import os
import pandas as pd
from datetime import datetime, timezone
from src.v2.core.user_manager import get_user_preferences

EXPORT_FOLDER = "data/v2/exports/"
os.makedirs(EXPORT_FOLDER, exist_ok=True)

def export_user_data(user_id, trades=None, perf=None, signals=None):
    today = datetime.now().strftime("%Y-%m-%d")
    filename = f"{EXPORT_FOLDER}export_{user_id}_{today}.csv"

    rows = []
    prefs = get_user_preferences(user_id)

    if trades:
        for t in trades:
            rows.append({
                "user_id": user_id,
                "type": "trade",
                "token": t.get("token"),
                "action": t.get("action"),
                "amount": t.get("amount"),
                "timestamp": t.get("timestamp", today)
            })

    if perf:
        rows.append({
            "user_id": user_id,
            "type": "performance",
            "total_pnl": perf.get("total_pnl"),
            "roi_pct": perf.get("roi_pct"),
            "timestamp": today
        })

    if signals:
        for s in signals:
            rows.append({
                "user_id": user_id,
                "type": "signal",
                "token": s.get("token"),
                "score": s.get("score"),
                "sentiment": s.get("sentiment"),
                "timestamp": today
            })

    if rows:
        df = pd.DataFrame(rows)
        df.to_csv(filename, index=False)
        print(f"✅ Export utilisateur sauvegardé : {filename}")
        return filename
    else:
        print("⚠️ Aucun contenu à exporter.")
        return None

# Exemple d’appel
if __name__ == "__main__":
    sample_trades = [
        {"token": "BTC", "action": "buy", "amount": 0.1},
        {"token": "ETH", "action": "sell", "amount": 0.2},
    ]
    sample_perf = {"total_pnl": 320, "roi_pct": 4.2}
    sample_signals = [
        {"token": "SOL", "score": 87, "sentiment": 0.76},
        {"token": "AVAX", "score": 78, "sentiment": 0.65}
    ]
    export_user_data("user_001", sample_trades, sample_perf, sample_signals)

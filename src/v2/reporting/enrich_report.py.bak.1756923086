from __future__ import annotations
import json, csv, datetime, math
from pathlib import Path
from typing import Any, Dict, Optional

# /root/Bot_crypto_ultra/src/v2/reporting/enrich_report.py
ROOT = Path(__file__).resolve().parents[3]  # /root/Bot_crypto_ultra
DATA = ROOT / "src" / "v2" / "data"

ANALYSIS   = DATA / "analysis"
TRADING    = DATA / "trading"
RISK       = DATA / "risk"
REPORTING  = DATA / "reporting"
SOCIAL     = DATA / "social"
INTEL      = DATA / "intelligence"
REPORTS    = DATA / "reports"

# Fichiers d'entrée
F_SENTIMENT_NEW = ANALYSIS / "sentiment_summary.json"
F_TRADES_CSV    = TRADING / "trades.csv"
F_WORST_NEW     = RISK / "worst_trades.json"
F_PNL_CSV       = REPORTING / "monthly_pnl.csv"  # on le garde si tu veux toujours l’export
F_TG_JSON       = SOCIAL / "telegram_data.json"
F_REDDIT_JSON   = SOCIAL / "reddit_data.json"

# Fallback legacy (au cas où)
F_SENTIMENT_OLD = DATA / "average_sentiment.json"
F_TRADES_OLD    = DATA / "trade_simulation.json"
F_WORST_OLD     = DATA / "worst_trades.json"

# Fichiers de sortie
F_DAILY_JSON = REPORTS / "daily_report.json"
F_DAILY_MD   = REPORTS / "daily_report.md"

def now_utc():
    return datetime.datetime.now(datetime.timezone.utc)

def now_iso_utc() -> str:
    return now_utc().replace(microsecond=0).isoformat()

def _safe_load_json(p: Path):
    try:
        if p.is_file():
            return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        pass
    return None

def _count_generic(container) -> int:
    if container is None: return 0
    if isinstance(container, list): return len(container)
    if isinstance(container, dict):
        total = 0
        for v in container.values():
            if isinstance(v, list): total += len(v)
            elif isinstance(v, dict): total += _count_generic(v)
        return total or len(container)
    return 0

def read_sentiment() -> Dict[str, float]:
    obj = _safe_load_json(F_SENTIMENT_NEW)
    if isinstance(obj, dict):
        score = obj.get("score")
        if not isinstance(score, (int,float)):
            score = obj.get("average") or (obj.get("sentiment", {}) or {}).get("average")
        # si pas de "count", on estime via details si présent
        count = obj.get("count")
        if not isinstance(count, int):
            details = obj.get("details")
            count = len(details) if isinstance(details, list) else 0
        return {"average": float(score) if isinstance(score,(int,float)) else 0.0, "count": int(count or 0)}
    obj = _safe_load_json(F_SENTIMENT_OLD)
    if isinstance(obj, dict) and isinstance(obj.get("sentiment"), dict):
        s = obj["sentiment"]
        return {"average": float(s.get("average") or 0.0), "count": int(s.get("count") or 0)}
    return {"average": 0.0, "count": 0}

def read_worst_trades_count() -> int:
    obj = _safe_load_json(F_WORST_NEW)
    if isinstance(obj, list): return len(obj)
    if isinstance(obj, dict) and isinstance(obj.get("worst"), list): return len(obj["worst"])
    obj = _safe_load_json(F_WORST_OLD)
    if isinstance(obj, list): return len(obj)
    if isinstance(obj, dict) and isinstance(obj.get("worst"), list): return len(obj["worst"])
    return 0

def read_social_counts() -> Dict[str, int]:
    tg = _safe_load_json(F_TG_JSON)
    rd = _safe_load_json(F_REDDIT_JSON)
    return {"telegram": _count_generic(tg), "reddit": _count_generic(rd)}

def parse_ts(ts: str) -> Optional[datetime.datetime]:
    try:
        # supporte ISO avec ou sans TZ (assume UTC si absent)
        dt = datetime.datetime.fromisoformat(ts.replace("Z","+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return dt.astimezone(datetime.timezone.utc)
    except Exception:
        return None

def read_trades_breakdown(hours_rolling:int=48) -> Dict[str, Any]:
    """
    Lit trades.csv et retourne :
    - total_count: nombre total de lignes
    - count_rolling: nombre de trades sur les `hours_rolling` dernières heures
    - pnl_usd: { total, month, day }
    """
    now = now_utc()
    start_rolling = now - datetime.timedelta(hours=hours_rolling)

    total_count = 0
    count_rolling = 0

    pnl_total = 0.0
    pnl_month  = 0.0
    pnl_day    = 0.0

    if not F_TRADES_CSV.is_file():
        return {
            "total_count": 0,
            "count_rolling": 0,
            "pnl_usd": {"total": 0.0, "month": 0.0, "day": 0.0},
        }

    with F_TRADES_CSV.open("r", encoding="utf-8") as f:
        r = csv.DictReader(f)
        for row in r:
            total_count += 1

            # timestamp
            ts = parse_ts(row.get("timestamp",""))
            if ts and ts >= start_rolling:
                count_rolling += 1

            # pnl_usd
            pnl_str = row.get("pnl_usd")
            try:
                pnl = float(pnl_str) if pnl_str not in (None,"") else 0.0
            except ValueError:
                pnl = 0.0
            pnl_total += pnl

            if ts:
                # mensuel (mois/année du now UTC)
                if ts.year == now.year and ts.month == now.month:
                    pnl_month += pnl
                # quotidien (jour UTC)
                if ts.date() == now.date():
                    pnl_day += pnl

    return {
        "total_count": total_count,
        "count_rolling": count_rolling,
        "pnl_usd": {
            "total": round(pnl_total, 2),
            "month": round(pnl_month, 2),
            "day":   round(pnl_day, 2),
        },
    }

def read_monthly_pnl_latest_csv() -> Optional[float]:
    """Optionnel: si tu veux encore afficher la dernière valeur écrite par le pipeline dans monthly_pnl.csv."""
    if not F_PNL_CSV.is_file(): return None
    last = None
    try:
        with F_PNL_CSV.open("r", encoding="utf-8") as f:
            r = csv.DictReader(f)
            for row in r:
                last = row
        return float(last["pnl_usd"]) if last and "pnl_usd" in last else None
    except Exception:
        return None

def format_float(x: Optional[float], digits:int=2, empty="n/a") -> str:
    if x is None: return empty
    try:
        if isinstance(x,float) and (math.isnan(x) or math.isinf(x)): return empty
        return f"{float(x):.{digits}f}"
    except Exception:
        return empty

def main():
    REPORTS.mkdir(parents=True, exist_ok=True)
    ts = now_iso_utc()

    sent     = read_sentiment()
    worst_n  = read_worst_trades_count()
    social   = read_social_counts()
    trades   = read_trades_breakdown(hours_rolling=48)  # rolling 48h pour le "count"
    pnl_last = read_monthly_pnl_latest_csv()            # optionnel, pour comparaison

    out = {
        "date_utc": ts,
        "source": "nova-enrich-report",
        "social": {"telegram_count": social["telegram"], "reddit_count": social["reddit"]},
        "sentiment": {"average": sent["average"], "count": sent["count"]},
        "trades": {
            "total_count": trades["total_count"],
            "count_48h": trades["count_rolling"],
            "pnl_usd": trades["pnl_usd"],  # total / month / day
            "worst_count": worst_n
        },
        "monthly_pnl_last_csv": pnl_last,  # conservé à titre indicatif
        "top_tokens": [],
    }
    F_DAILY_JSON.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")

    # Markdown
    md = []
    md.append(f"# Rapport quotidien — {ts}")
    md.append("")
    md.append("## Social")
    md.append(f"- Telegram: **{social['telegram']}**")
    md.append(f"- Reddit: **{social['reddit']}**")
    md.append("")
    md.append("## Sentiment")
    md.append(f"- Score moyen: **{sent['average']:.4f}**  (n={sent['count']})")
    md.append("")
    md.append("## Trades & PnL")
    md.append(f"- Trades (48 h): **{trades['count_rolling']}**  | Total historique: **{trades['total_count']}**")
    md.append(f"- PnL cumulé (USD): **{format_float(trades['pnl_usd']['total'],2)}**")
    md.append(f"- PnL mensuel courant (USD): **{format_float(trades['pnl_usd']['month'],2)}**")
    md.append(f"- PnL quotidien (UTC) (USD): **{format_float(trades['pnl_usd']['day'],2)}**")
    md.append(f"- Pires trades (compte): **{worst_n}**")
    if pnl_last is not None:
        md.append(f"- (Info CSV) Dernier enregistrement monthly_pnl.csv: **{format_float(pnl_last,2)} USD**")
    md.append("")
    md.append("_— Nova Star —_")
    F_DAILY_MD.write_text("\n".join(md), encoding="utf-8")

    print(json.dumps({
        "updated": str(F_DAILY_JSON),
        "markdown": str(F_DAILY_MD),
        "telegram_sent": False,
        "telegram_info": "generation only (no send here)"
    }))

if __name__ == "__main__":
    main()

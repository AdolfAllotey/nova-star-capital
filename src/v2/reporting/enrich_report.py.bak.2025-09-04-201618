from __future__ import annotations
import json, csv, datetime, math
from pathlib import Path
from typing import Any, Dict, Optional
from zoneinfo import ZoneInfo

# /root/Bot_crypto_ultra/src/v2/reporting/enrich_report.py
ROOT = Path(__file__).resolve().parents[3]  # /root/Bot_crypto_ultra
DATA = ROOT / "src" / "v2" / "data"

ANALYSIS   = DATA / "analysis"
TRADING    = DATA / "trading"
RISK       = DATA / "risk"
REPORTING  = DATA / "reporting"
SOCIAL     = DATA / "social"
INTEL      = DATA / "intelligence"
REPORTS    = DATA / "reports"

# Fichiers d'entrée
F_SENTIMENT_NEW = ANALYSIS / "sentiment_summary.json"
F_TRADES_CSV    = TRADING / "trades.csv"
F_WORST_NEW     = RISK / "worst_trades.json"
F_PNL_CSV       = REPORTING / "monthly_pnl.csv"
F_TG_JSON       = SOCIAL / "telegram_data.json"
F_REDDIT_JSON   = SOCIAL / "reddit_data.json"

# Fallback legacy
F_SENTIMENT_OLD = DATA / "average_sentiment.json"
F_TRADES_OLD    = DATA / "trade_simulation.json"
F_WORST_OLD     = DATA / "worst_trades.json"

# Sorties
F_DAILY_JSON = REPORTS / "daily_report.json"
F_DAILY_MD   = REPORTS / "daily_report.md"

PARIS = ZoneInfo("Europe/Paris")

def now_utc() -> datetime.datetime:
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)

def _safe_load_json(p: Path):
    try:
        if p.is_file():
            return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        pass
    return None

def _count_generic(container) -> int:
    if container is None: return 0
    if isinstance(container, list): return len(container)
    if isinstance(container, dict):
        total = 0
        for v in container.values():
            if isinstance(v, list): total += len(v)
            elif isinstance(v, dict): total += _count_generic(v)
        return total or len(container)
    return 0

def read_sentiment() -> Dict[str, float]:
    obj = _safe_load_json(F_SENTIMENT_NEW)
    if isinstance(obj, dict):
        score = obj.get("score")
        if not isinstance(score, (int,float)):
            score = obj.get("average") or (obj.get("sentiment", {}) or {}).get("average")
        # si "count" absent, on met 0 (on ne fabrique pas de faux n)
        count = obj.get("count", 0)
        try: count = int(count)
        except Exception: count = 0
        return {"average": float(score) if isinstance(score,(int,float)) else 0.0, "count": count,
                "generated_at": obj.get("generated_at")}
    # legacy
    obj = _safe_load_json(F_SENTIMENT_OLD)
    if isinstance(obj, dict) and isinstance(obj.get("sentiment"), dict):
        s = obj["sentiment"]
        return {"average": float(s.get("average") or 0.0), "count": int(s.get("count") or 0), "generated_at": obj.get("date_utc")}
    return {"average": 0.0, "count": 0, "generated_at": None}

def read_trades_summary() -> Dict[str, Optional[float]]:
    # CSV moderne
    if F_TRADES_CSV.is_file():
        count = 0
        avg = None  # on ne fabrique pas d'avg si aucune colonne PnL %
        with F_TRADES_CSV.open("r", encoding="utf-8") as f:
            r = csv.DictReader(f)
            vals = []
            for row in r:
                count += 1
                for key in ("pnl_pct","pnl_percent","pnl","pnlPct"):
                    v = row.get(key)
                    if v not in ("", None):
                        try: vals.append(float(v))
                        except: pass
                        break
            if vals: avg = sum(vals)/len(vals)
        return {"count": count, "avg_pnl_pct": avg}
    # Legacy JSON
    obj = _safe_load_json(F_TRADES_OLD)
    if isinstance(obj, dict):
        if isinstance(obj.get("trades"), dict):
            t = obj["trades"]
            return {"count": int(t.get("count") or 0),
                    "avg_pnl_pct": (t.get("avg_pnl_pct") if isinstance(t.get("avg_pnl_pct"), (int,float)) else None)}
        return {"count": int(obj.get("trade_count") or obj.get("count") or 0),
                "avg_pnl_pct": (obj.get("avg_pnl_pct") if isinstance(obj.get("avg_pnl_pct"), (int,float)) else None)}
    return {"count": 0, "avg_pnl_pct": None}

def read_worst_trades_count() -> int:
    for p in (F_WORST_NEW, F_WORST_OLD):
        obj = _safe_load_json(p)
        if isinstance(obj, list): return len(obj)
        if isinstance(obj, dict) and isinstance(obj.get("worst"), list): return len(obj["worst"])
    return 0

def read_social_counts() -> Dict[str, int]:
    tg = _safe_load_json(F_TG_JSON)
    rd = _safe_load_json(F_REDDIT_JSON)
    return {"telegram": _count_generic(tg), "reddit": _count_generic(rd)}

def read_pnl_aggregates() -> Dict[str, Optional[float]]:
    """Calcule PnL du jour (Europe/Paris), MTD et Cumul depuis monthly_pnl.csv.
       Aucune donnée factice n'est créée : si le CSV est vide/absent → None."""
    if not F_PNL_CSV.is_file():
        return {"pnl_today": None, "pnl_mtd": None, "pnl_all": None}
    today_local = now_utc().astimezone(PARIS).date()
    year, month = today_local.year, today_local.month

    total_today = 0.0
    total_mtd   = 0.0
    total_all   = 0.0
    any_row = False

    try:
        with F_PNL_CSV.open("r", encoding="utf-8") as f:
            try:
                reader = csv.DictReader(f)
                use_dict = ("date" in (reader.fieldnames or [])) and ("pnl_usd" in (reader.fieldnames or []))
            except Exception:
                use_dict = False
                f.seek(0)
                reader = csv.reader(f)

            if use_dict:
                for row in reader:
                    any_row = True
                    try:
                        d = datetime.date.fromisoformat(str(row["date"]).strip())
                        v = float(row["pnl_usd"])
                    except Exception:
                        continue
                    total_all += v
                    if d.year == year and d.month == month:
                        total_mtd += v
                        if d == today_local:
                            total_today += v
            else:
                # Fallback brut: "YYYY-MM-DD,VALUE"
                for row in reader:
                    if not row: continue
                    any_row = True
                    try:
                        d = datetime.date.fromisoformat(str(row[0]).strip())
                        v = float(row[1])
                    except Exception:
                        continue
                    total_all += v
                    if d.year == year and d.month == month:
                        total_mtd += v
                        if d == today_local:
                            total_today += v
    except Exception:
        return {"pnl_today": None, "pnl_mtd": None, "pnl_all": None}

    if not any_row:
        return {"pnl_today": None, "pnl_mtd": None, "pnl_all": None}

    return {"pnl_today": total_today, "pnl_mtd": total_mtd, "pnl_all": total_all}

def fmt_money(x: Optional[float]) -> str:
    if x is None or (isinstance(x,float) and (math.isnan(x) or math.isinf(x))):
        return "n/a"
    sign = "+" if x >= 0 else ""
    return f"{sign}{x:.2f} USD"

def format_pct(x: Optional[float]) -> str:
    if x is None or (isinstance(x,float) and (math.isnan(x) or math.isinf(x))):
        return "n/a%"
    return f"{x:.2f}%"

def main():
    REPORTS.mkdir(parents=True, exist_ok=True)

    ts_utc = now_utc()

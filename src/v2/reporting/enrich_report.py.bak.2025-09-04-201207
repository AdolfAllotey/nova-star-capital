# Fuseaux
PARIS = dt.timezone(dt.timedelta(hours=2))  # sera ajusté dynamiquement ci-dessous
try:
    # Python 3.9+ : zoneinfo pour gérer automatiquement CET/CEST
    from zoneinfo import ZoneInfo
    PARIS = ZoneInfo("Europe/Paris")
except Exception:
    pass


# ── Utilitaires temps & parsing ─────────────────────────────────────────────────
def now_utc_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()

def to_paris(d: Optional[dt.datetime]) -> Optional[dt.datetime]:
    if d is None: return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=dt.timezone.utc)
    return d.astimezone(PARIS)

def parse_iso_or_epoch(x: Any) -> Optional[dt.datetime]:
    """
    Tente de parser les champs de date courants:
    - ISO string (avec ou sans 'Z')
    - epoch (int/float) en secondes
    Retourne un datetime en UTC.
    """
    if x is None:
        return None
    # epoch ?
    if isinstance(x, (int, float)):
        try:
            return dt.datetime.fromtimestamp(float(x), tz=dt.timezone.utc)
        except Exception:
            return None
    if isinstance(x, str):
        s = x.strip()
        # ISO divers
        for cand in (s, s.replace("Z", "+00:00")):
            try:
                return dt.datetime.fromisoformat(cand).astimezone(dt.timezone.utc)
            except Exception:
                pass
        # float epoch en str ?
        try:
            val = float(s)
            return dt.datetime.fromtimestamp(val, tz=dt.timezone.utc)
        except Exception:
            return None
    return None


# ── I/O sûres ───────────────────────────────────────────────────────────────────
def load_json(p: Path) -> Any:
    try:
        if p.is_file():
            return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        pass
    return None


# ── Social: comptage générique avec fenêtre ─────────────────────────────────────
_TS_KEYS = ("timestamp", "date", "datetime", "created", "created_at", "created_utc", "time")

def iter_timestamps(obj: Any) -> Iterable[dt.datetime]:
    """
    Itère sur les timestamps trouvés récursivement dans un JSON (list/dict).
    Cherche des clés usuelles (_TS_KEYS). Renvoie des datetimes UTC.
    """
    if obj is None:
        return
    if isinstance(obj, list):
        for it in obj:
            yield from iter_timestamps(it)
        return
    if isinstance(obj, dict):
        # clés directes
        for k in _TS_KEYS:
            if k in obj:
                d = parse_iso_or_epoch(obj[k])
                if d:
                    yield d
        # descente récursive
        for v in obj.values():
            yield from iter_timestamps(v)

def count_since(obj: Any, since_utc: dt.datetime) -> int:
    n = 0
    for t in iter_timestamps(obj):
        if t >= since_utc:
            n += 1
    # Si aucun timestamp trouvé mais structure non vide -> fallback au total brut
    if n == 0:
        if isinstance(obj, list):
            return len(obj)
        if isinstance(obj, dict):
            # Compte grossier d’items feuille
            def _count(o: Any) -> int:
                if isinstance(o, list):
                    return sum(_count(x) for x in o) or len(o)
                if isinstance(o, dict):
                    return sum(_count(v) for v in o.values()) or len(o)
                return 1
            return _count(obj)
    return n


# ── Sentiment: toujours dernier, jamais filtré ──────────────────────────────────
def read_sentiment_latest() -> Dict[str, Any]:
    obj = load_json(F_SENTIMENT)
    if not isinstance(obj, dict):
        # fallback legacy
        legacy = load_json(F_SENTIMENT_OLD)
        if isinstance(legacy, dict):
            s = legacy.get("sentiment") or {}
            score = s.get("average")
            gen = parse_iso_or_epoch(legacy.get("date_utc") or legacy.get("generated_at"))
            gen_paris = to_paris(gen) if gen else None
            return {
                "average": float(score) if isinstance(score, (int, float)) else None,
                "count": int(s.get("count") or 0) if isinstance(s, dict) else None,
                "generated_at": gen_paris.isoformat() if gen_paris else None,
                "stale": False if not gen_paris else (dt.datetime.now(PARIS) - gen_paris) > dt.timedelta(hours=48),
            }
        return {"average": None, "count": None, "generated_at": None, "stale": False}

    score = obj.get("score")
    if not isinstance(score, (int, float)):
        score = obj.get("average")
    gen = parse_iso_or_epoch(obj.get("generated_at"))
    gen_paris = to_paris(gen) if gen else None
    stale = False if not gen_paris else (dt.datetime.now(PARIS) - gen_paris) > dt.timedelta(hours=48)

    # Certain fichiers peuvent avoir "count"
    count = obj.get("count")
    if not isinstance(count, int):
        count = None

    return {
        "average": float(score) if isinstance(score, (int, float)) else None,
        "count": count,
        "generated_at": gen_paris.isoformat() if gen_paris else None,
        "stale": stale,
    }


# ── Trades & PnL ────────────────────────────────────────────────────────────────
def parse_trade_row(row: Dict[str, str]) -> Optional[Tuple[dt.datetime, Optional[float]]]:
    ts_raw = row.get("timestamp") or row.get("time") or row.get("date")
    d = parse_iso_or_epoch(ts_raw)
    if not d:
        return None
    # pnl en USD (float); colonnes tolérées
    pnl = None
    for key in ("pnl_usd", "pnlUSD", "pnlUsd", "pnl"):
        if key in row and row[key] not in (None, ""):
            try:
                pnl = float(row[key])
            except Exception:
                pass
            break
    return d, pnl

def load_trades_csv(p: Path) -> list[Tuple[dt.datetime, Optional[float]]]:
    out = []
    if not p.is_file():
        return out
    with p.open("r", encoding="utf-8") as f:
        r = csv.DictReader(f)
        for row in r:
            parsed = parse_trade_row(row)
            if parsed:
                out.append(parsed)
    return out

def pnl_aggregates(trades: Iterable[Tuple[dt.datetime, Optional[float]]]) -> Dict[str, float]:
    """
    Calcule:
    - daily_pnl_usd: somme des pnl pour le jour courant (Europe/Paris)
    - mtd_pnl_usd: somme pour le mois courant (Europe/Paris)
    - all_pnl_usd: somme totale
    - trades_48h: nombre de trades sur 48h
    """
    now_paris = dt.datetime.now(PARIS)
    start_day = now_paris.replace(hour=0, minute=0, second=0, microsecond=0)
    start_month = start_day.replace(day=1)
    since_48h = (now_paris - dt.timedelta(hours=48)).astimezone(dt.timezone.utc)

    daily = 0.0
    mtd = 0.0
    allsum = 0.0
    n48 = 0

    for t_utc, pnl in trades:
        # normalise -> Paris
        t_paris = to_paris(t_utc)
        if pnl is None:
            pnl = 0.0
        allsum += pnl
        if t_paris and t_paris >= start_day:
            daily += pnl
        if t_paris and t_paris >= start_month:
            mtd += pnl
        if t_utc >= since_48h:
            n48 += 1

    return {
        "daily_pnl_usd": daily,
        "mtd_pnl_usd": mtd,
        "all_pnl_usd": allsum,
        "trades_48h": n48,
    }


# ── Worst trades ────────────────────────────────────────────────────────────────
def count_worst_trades() -> int:
    obj = load_json(F_WORST)
    if isinstance(obj, list):
        return len(obj)
    if isinstance(obj, dict) and isinstance(obj.get("worst"), list):
        return len(obj["worst"])
    # fallback legacy
    old = load_json(F_WORST_OLD)
    if isinstance(old, list):
        return len(old)
    if isinstance(old, dict) and isinstance(old.get("worst"), list):
        return len(old["worst"])
    return 0


# ── Social: comptages 48h ───────────────────────────────────────────────────────
def read_social_48h() -> Dict[str, int]:
    since_utc = dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=48)
    tg = load_json(F_TG_JSON)
    rd = load_json(F_REDDIT)
    return {
        "telegram_48h": count_since(tg, since_utc),
        "reddit_48h": count_since(rd, since_utc),
    }


# ── Helpers présentation ───────────────────────────────────────────────────────
def fmt_money(x: Optional[float], digits: int = 2) -> str:
    if x is None: return "n/a"
    if isinstance(x, float) and (math.isnan(x) or math.isinf(x)): return "n/a"
    return f"{x:.{digits}f}"

def fmt_pct(x: Optional[float], digits: int = 2) -> str:
    if x is None: return "n/a%"
    if isinstance(x, float) and (math.isnan(x) or math.isinf(x)): return "n/a%"
    return f"{x:.{digits}f}%"

def ensure_reports_dir():
    REPORTS.mkdir(parents=True, exist_ok=True)


# ── Main ───────────────────────────────────────────────────────────────────────
def main():
    ensure_reports_dir()
    ts = now_utc_iso()

    # Sentiment (dernier dispo)
    sent = read_sentiment_latest()

    # Social (fenêtre 48h)
    social = read_social_48h()

    # Trades & PnL
    trades = load_trades_csv(F_TRADES)
    pnl = pnl_aggregates(trades)

    # Worst trades
    worst_n = count_worst_trades()

    # JSON
    out = {
        "date_utc": ts,
        "source": "nova-enrich-report",
        "timezone": "Europe/Paris",
        "social": social,
        "sentiment": sent,
        "trades": {
            "count_48h": pnl["trades_48h"],
            "worst_count": worst_n,
        },
        "pnl": {
            "daily_usd": pnl["daily_pnl_usd"],
            "mtd_usd": pnl["mtd_pnl_usd"],
            "all_time_usd": pnl["all_pnl_usd"],
        },
    }
    F_DAILY_JSON.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")

    # Markdown
    md = []
    md.append(f"# Rapport quotidien — {ts}")
    md.append("")
    md.append("## Social (48h)")
    md.append(f"- Telegram: **{social['telegram_48h']}**")
    md.append(f"- Reddit: **{social['reddit_48h']}**")
    md.append("")
    md.append("## Sentiment")
    avg = "n/a" if sent["average"] is None else f"{sent['average']:.4f}"
    stale = " (stale >48h)" if sent.get("stale") else ""
    stamp = sent.get("generated_at") or "inconnu"
    count = "" if sent.get("count") in (None, 0) else f"  (n={sent['count']})"
    md.append(f"- Score courant: **{avg}**{count}{stale}")
    md.append(f"- Généré à: {stamp}")
    md.append("")
    md.append("## Trades")
    md.append(f"- Trades (48h): **{pnl['trades_48h']}**")
    md.append(f"- Pires trades (compte): **{worst_n}**")
    md.append("")
    md.append("## PnL (USD)")
    md.append(f"- Aujourd’hui (Europe/Paris): **{fmt_money(pnl['daily_pnl_usd'])} USD**")
    md.append(f"- Mois en cours (MTD): **{fmt_money(pnl['mtd_pnl_usd'])} USD**")
    md.append(f"- Cumul (all-time): **{fmt_money(pnl['all_pnl_usd'])} USD**")
    md.append("")
    md.append("_— Nova Star —_")
    F_DAILY_MD.write_text("\n".join(md), encoding="utf-8")

    print(json.dumps({
        "updated": str(F_DAILY_JSON),
        "markdown": str(F_DAILY_MD),
        "telegram_sent": False,
        "telegram_info": "generation only (no send here)"
    }))


if __name__ == "__main__":
    main()

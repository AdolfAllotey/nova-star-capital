import os
import json
from datetime import datetime, timezone
from src.v2.core.account_manager import get_total_invested_amount
from src.v2.core.capital_allocator import allocate_gain
from src.v2.utils.logger import get_logger

logger = get_logger("gain_protector")

# Paramètres
ACTIVATION_THRESHOLD = 10_000
CORPORATE_TAX_RATE = 0.25
SAFE_ALLOC_RATIO = 0.30
REINVEST_RATIO = 0.70
LOG_PATH = "src/v2/data/logs/gain_logs.json"

def get_realized_gain():
    """
    À adapter selon ton pipeline réel.
    """
    try:
        from src.v2.data.simulation.global_performance import get_latest_gain
        return get_latest_gain()
    except:
        return 1000  # fallback test

def log_gain_allocation(log_entry):
    if not os.path.exists(LOG_PATH):
        with open(LOG_PATH, "w") as f:
            json.dump([log_entry], f, indent=2)
    else:
        with open(LOG_PATH, "r") as f:
            data = json.load(f)
        data.append(log_entry)
        with open(LOG_PATH, "w") as f:
            json.dump(data, f, indent=2)

def gain_protector():
    logger.info("🛡️ Lancement de la protection des gains")

    total_invested = get_total_invested_amount()
    gain = get_realized_gain()

    if gain <= 0:
        logger.info("🔹 Aucun gain à redistribuer.")
        return

    tax_amount = gain * CORPORATE_TAX_RATE
    net_gain = gain - tax_amount
    logger.info(f"🏛️ Impôt prélevé : {tax_amount:.2f} € | Net après impôt : {net_gain:.2f} €")

    if total_invested < ACTIVATION_THRESHOLD:
        logger.info(f"💤 Seuil non atteint ({total_invested} €). Réinvestissement total.")
        allocate_gain(net_gain, target="trading")

        log_entry = {
            "timestamp": datetime.now().isoformat(),
            "gain_brut": gain,
            "impot_preleve": tax_amount,
            "gain_net": net_gain,
            "seuil_atteint": False,
            "allocations": {
                "trading": round(net_gain, 2)
            }
        }
        log_gain_allocation(log_entry)
        return

    safe_part = net_gain * SAFE_ALLOC_RATIO
    reinvest_part = net_gain * REINVEST_RATIO

    logger.info(f"📤 Sécurisation : {safe_part:.2f} € | Réinvestissement : {reinvest_part:.2f} €")

    allocate_gain(safe_part * 0.60, "long_term")
    allocate_gain(safe_part * 0.20, "security")
    allocate_gain(safe_part * 0.15, "bfr")
    allocate_gain(safe_part * 0.05, "enterprise")
    allocate_gain(reinvest_part, "trading")

    log_entry = {
        "timestamp": datetime.now().isoformat(),
        "gain_brut": gain,
        "impot_preleve": round(tax_amount, 2),
        "gain_net": round(net_gain, 2),
        "seuil_atteint": True,
        "allocations": {
            "long_term": round(safe_part * 0.60, 2),
            "security": round(safe_part * 0.20, 2),
            "bfr": round(safe_part * 0.15, 2),
            "enterprise": round(safe_part * 0.05, 2),
            "trading": round(reinvest_part, 2)
        }
    }

    log_gain_allocation(log_entry)
    logger.info("✅ Réallocation terminée.")

if __name__ == "__main__":
    gain_protector()
import os
import pandas as pd
import datetime
import json
from src.utils.telegram_bot import send_telegram_message

# Chemin du fichier de config JSON
CONFIG_FILE = "src/v2/config/risk_controller_config.json"

# Fichiers de simulation et suivi
SIMULATED_TRADES_FILE = "data/simulation/live/simulated_trades_live.csv"
SUBACCOUNT_BALANCES_FILE = "data/v2/monitoring/subaccounts_balances.csv"
ALERT_HISTORY_FILE = "data/v2/monitoring/risk_alert_history.json"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        # Valeurs par défaut si config absente
        return {
            "MAX_TOKEN_WEIGHT": 0.15,
            "MAX_ALLOWED_DRAWDOWN": -0.10,
            "MIN_TAX_RESERVE": 300,
            "MIN_SECURITY_RESERVE": 500
        }
    with open(CONFIG_FILE, "r") as f:
        return json.load(f)

def load_alert_history():
    if not os.path.exists(ALERT_HISTORY_FILE):
        return []
    with open(ALERT_HISTORY_FILE, "r") as f:
        return json.load(f)

def save_alert_history(alerts):
    os.makedirs(os.path.dirname(ALERT_HISTORY_FILE), exist_ok=True)
    with open(ALERT_HISTORY_FILE, "w") as f:
        json.dump(alerts, f, indent=2)

def analyze_risk():
    config = load_config()
    today = datetime.datetime.now().strftime("%Y-%m-%d")
    alerts = []

    # Chargement historique alertes
    alert_history = load_alert_history()

    # Chargement des trades
    if os.path.exists(SIMULATED_TRADES_FILE):
        df = pd.read_csv(SIMULATED_TRADES_FILE)
        df_today = df[df["datetime"].str.startswith(today)]

        if not df_today.empty:
            # Tokens trop pondérés
            weights = df_today.groupby("token")["invested"].sum()
            total = weights.sum()
            for token, invested in weights.items():
                pct = invested / total
                alert_msg = f"🚨 Token trop pondéré : {token} ({pct:.2%})"
                if alert_msg not in alert_history:
                    alerts.append(alert_msg)

            # Drawdown important
            for _, row in df_today.iterrows():
                if row["variation_pct"] <= config["MAX_ALLOWED_DRAWDOWN"] * 100:
                    alert_msg = f"🔻 Drawdown détecté sur {row['token']} : {row['variation_pct']:.2f}%"
                    if alert_msg not in alert_history:
                        alerts.append(alert_msg)

    # Chargement des soldes de sous-comptes
    if os.path.exists(SUBACCOUNT_BALANCES_FILE):
        balances = pd.read_csv(SUBACCOUNT_BALANCES_FILE)
        tax_balance = balances.loc[balances["subaccount"] == "impots", "balance"].sum()
        security_balance = balances.loc[balances["subaccount"] == "securite", "balance"].sum()

        if tax_balance < config["MIN_TAX_RESERVE"]:
            alert_msg = f"⚠️ Solde impôts insuffisant : {tax_balance:.2f} $"
            if alert_msg not in alert_history:
                alerts.append(alert_msg)
        if security_balance < config["MIN_SECURITY_RESERVE"]:
            alert_msg = f"⚠️ Solde sécurité insuffisant : {security_balance:.2f} $"
            if alert_msg not in alert_history:
                alerts.append(alert_msg)

    # Envoi alertes et mise à jour historique
    if alerts:
        msg = f"📛 **Contrôle des Risques {today}**\n" + "\n".join(alerts)
        send_telegram_message(msg)
        print(msg)

        # Met à jour l’historique
        alert_history.extend(alerts)
        # Pour éviter que le fichier ne grossisse trop, garder max 100 derniers
        alert_history = alert_history[-100:]
        save_alert_history(alert_history)
    else:
        print(f"✅ Contrôle des Risques {today} : aucun risque détecté.")

if __name__ == "__main__":
    analyze_risk()
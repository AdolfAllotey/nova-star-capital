# -*- coding: utf-8 -*-
from __future__ import annotations
import os, time
from pathlib import Path
from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse, Response

app = FastAPI(title="Nova Star Capital API v2")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.middleware("http")
async def add_timing_header(request: Request, call_next):
    t0 = time.perf_counter()
    resp: Response = await call_next(request)
    resp.headers["X-Process-Time-ms"] = f"{(time.perf_counter()-t0)*1000:.2f}"
    resp.headers.setdefault("X-Vhost", os.getenv("VHOST_NAME", "api.novastarcapital.fr"))
    return resp

@app.get("/health", tags=["infra"])
def health():
    return {"ok": True}

BASE_DIR = Path(__file__).resolve().parents[2]
BACKTESTS_DIR = BASE_DIR / "v2" / "data" / "reports" / "backtests"

@app.get("/backtests", response_class=HTMLResponse, tags=["backtests"])
def backtests_index():
    if not BACKTESTS_DIR.exists():
        return HTMLResponse("<h1>Backtests</h1><p>Aucun dossier trouvé.</p>", status_code=200)
    items = []
    for p in sorted(BACKTESTS_DIR.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True):
        if p.is_dir():
            items.append((p.name, int(p.stat().st_mtime)))
    rows = "\n".join(f"<tr><td>{i+1}</td><td><code>{n}</code></td><td>{m}</td></tr>" for i,(n,m) in enumerate(items))
    html = f"""<!doctype html><html lang="fr"><meta charset="utf-8"><title>Backtests</title>
<style>body{{font-family:system-ui;padding:20px}}table{{border-collapse:collapse;width:100%}}td,th{{border:1px solid #ddd;padding:8px}}th{{background:#f4f4f4}}</style>
<h1>Backtests</h1><table><thead><tr><th>#</th><th>Dossier</th><th>mtime</th></tr></thead><tbody>{rows}</tbody></table>"""
    return HTMLResponse(html, status_code=200)

# ── Monte les routeurs OHLCV ─────────────────────────────────────────────────
try:
    from . import ohlcv  # doit exposer router et legacy_router
    app.include_router(ohlcv.router, prefix="/api")      # -> /api/ohlcv
    app.include_router(ohlcv.legacy_router)              # -> /internal/ohlcv
except Exception as e:
    @app.get("/__debug_ohlcv_import__", tags=["debug"])
    def _debug():
        return {"import_error": str(e)}

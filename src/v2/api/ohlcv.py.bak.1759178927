# src/v2/api/ohlcv.py
from __future__ import annotations

import os
import io
import math
import time
import hashlib
from datetime import datetime, timedelta, timezone
from typing import List, Dict, Any, Optional, Tuple

from fastapi import APIRouter, Query, HTTPException
from fastapi.responses import JSONResponse, PlainTextResponse

router = APIRouter()

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def _parse_tf(tf: str) -> int:
    """
    Convertit une timeframe ('1m','5m','15m','1h','4h','1d') en minutes.
    """
    tf = tf.strip().lower()
    if tf.endswith("m"):
        return int(tf[:-1])
    if tf.endswith("h"):
        return int(tf[:-1]) * 60
    if tf.endswith("d"):
        return int(tf[:-1]) * 60 * 24
    raise ValueError(f"Timeframe invalide: {tf}")

def _limit_from_days(tf: str, days: int) -> int:
    mins = _parse_tf(tf)
    per_day = 24 * 60 // mins
    return max(1, per_day * max(1, int(days)))

def _seed_from(symbol: str, tf: str, extra: Optional[int] = None) -> int:
    base = f"{symbol}|{tf}|{extra or 0}"
    return int(hashlib.sha256(base.encode()).hexdigest()[:8], 16)

def _gen_mock_series(
    symbol: str, tf: str, limit: int, start_ts: Optional[int] = None
) -> List[Dict[str, Any]]:
    """
    Génère une série OHLCV déterministe (pseudo-random walk) pour tests.
    Retourne une liste de barres triées par timestamp ascendant.
    """
    step_min = _parse_tf(tf)
    if start_ts is None:
        # Arrondit "maintenant" à la bougie précédente
        now = datetime.now(timezone.utc)
        minutes = (now.minute // step_min) * step_min
        base = now.replace(minute=minutes, second=0, microsecond=0)
        start = base - timedelta(minutes=step_min * (limit - 1))
    else:
        start = datetime.fromtimestamp(start_ts, tz=timezone.utc)

    seed = _seed_from(symbol, tf)
    rng = _lcg(seed)

    price = 100.0 + (seed % 100)  # point de départ stable par (symbol, tf)
    vol_base = 1000 + (seed % 500)
    rows: List[Dict[str, Any]] = []
    t = start

    for _ in range(limit):
        drift = (next(rng) - 0.5) * 0.6  # drift léger
        spread = abs(next(rng) - 0.5) * 0.8 + 0.2
        open_ = price
        high_ = open_ * (1 + spread * 0.01)
        low_  = open_ * (1 - spread * 0.01)
        close_ = max(low_, min(high_, open_ * (1 + drift * 0.01)))
        volume_ = vol_base * (0.7 + abs(next(rng) - 0.5))

        rows.append({
            "ts": int(t.timestamp()),
            "open": round(open_, 6),
            "high": round(high_, 6),
            "low": round(low_, 6),
            "close": round(close_, 6),
            "volume": round(volume_, 6),
            "symbol": symbol,
            "tf": tf,
        })
        price = close_
        t += timedelta(minutes=step_min)

    return rows

def _lcg(seed: int):
    """Petit générateur pseudo-aléatoire déterministe [0,1)."""
    m = 2**31 - 1
    a = 1103515245
    c = 12345
    x = seed % m
    while True:
        x = (a * x + c) % m
        yield (x / m)

def _as_csv(rows: List[Dict[str, Any]]) -> str:
    buf = io.StringIO()
    buf.write("ts,open,high,low,close,volume,symbol,tf\n")
    for r in rows:
        buf.write(
            f"{r['ts']},{r['open']},{r['high']},{r['low']},{r['close']},{r['volume']},{r['symbol']},{r['tf']}\n"
        )
    return buf.getvalue()

# -----------------------------------------------------------------------------
# Endpoint
# -----------------------------------------------------------------------------
@router.get("/ohlcv")
async def get_ohlcv(
    symbol: str = Query(..., description="Ex: BTCUSDT"),
    tf: str = Query("1h", description="Ex: 1m,5m,15m,1h,4h,1d"),
    limit: int = Query(96, ge=1, le=5000, description="Nombre de bougies"),
    days: Optional[int] = Query(None, ge=1, description="Alternative à limit; converti en limit selon tf"),
    format: str = Query("json", pattern="^(json|csv)$"),
    # Comportement backend: 'mock' par défaut pour éviter 404
    backend: str = Query(None, description="Force le backend: mock|real (sinon OHLCV_BACKEND)"),
) -> JSONResponse | PlainTextResponse:
    """
    Renvoie des bougies OHLCV.
    - Par défaut **mock** (série synthétique déterministe).
    - Si backend=real (ou OHLCV_BACKEND=real), renvoie 501 jusqu’à implémentation du fetch réel.
    - `format=csv` possible pour compat.
    """
    # days -> limit si fourni
    if days is not None:
        try:
            limit = _limit_from_days(tf, days)
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))

    mode = (backend or os.getenv("OHLCV_BACKEND", "mock")).lower()
    if mode not in ("mock", "real"):
        mode = "mock"

    if mode == "real":
        # ---- Branche à compléter par ton fetch réel (exchange, base, etc.) ----
        # Exemple d’interface attendue:
        # rows = await fetch_real_ohlcv(symbol, tf, limit)
        # return JSONResponse(rows)
        raise HTTPException(status_code=501, detail="OHLCV real backend non implémenté")

    # MOCK
    try:
        rows = _gen_mock_series(symbol, tf, limit)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

    if format == "csv":
        return PlainTextResponse(_as_csv(rows), media_type="text/csv")
    return JSONResponse(rows)

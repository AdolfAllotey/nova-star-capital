# ---------- Metrics ----------
@app.get("/metrics")
def metrics():
    files = {
        "market.top_movers": DATA_ROOT / "market" / "top_movers.json",
        "market.regime": DATA_ROOT / "market" / "market_regime.json",
        "profit.monthly_pnl": DATA_ROOT / "profit" / "monthly_pnl.json",
        "risk.worst_trades": DATA_ROOT / "risk" / "worst_trades.json",
        "trading.open_positions": DATA_ROOT / "trading" / "open_positions.json",
        "ico.candidates": DATA_ROOT / "ico" / "ico_candidates.json",
        "ico.screened": DATA_ROOT / "ico" / "ico_screened.json",
        "ico.scored": DATA_ROOT / "ico" / "ico_scored.json",
        "ico.allocation": DATA_ROOT / "ico" / "ico_allocation.json",
    }
    report = {k: file_report(k, p) for k, p in files.items()}
    return {"service": APP_NAME, "version": APP_VERSION, "files": report}


# ---------- Main (optionnel local) ----------
if __name__ == "__main__":
    import uvicorn
    uvicorn.run("app:app", host="127.0.0.1", port=8000, reload=True)

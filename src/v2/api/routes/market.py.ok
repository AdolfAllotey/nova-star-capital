from fastapi import APIRouter, HTTPException
from pathlib import Path
import json

router = APIRouter()  # pas de prefix ici

# /opt/nsc/app/src/v2/api/routes/market.py -> parents[2] == ".../src/v2"
DATA_DIR = Path(__file__).resolve().parents[2] / "data"
REGIME_FILE = DATA_DIR / "market" / "regime.json"

@router.get("/regime", summary="Market regime (bull/bear/neutral)")
def get_regime():
    try:
        if not REGIME_FILE.exists():
            raise HTTPException(status_code=404, detail="Régime marché indisponible")
        with REGIME_FILE.open("r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict) or "regime" not in data:
            raise HTTPException(status_code=404, detail="Régime marché indisponible")
        return {
            "regime": data.get("regime"),
            "score": data.get("score"),
            "date": data.get("date"),
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Erreur lecture regime.json: {e}")

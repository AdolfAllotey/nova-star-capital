import os
import json
from datetime import datetime, timezone
from collections import defaultdict
from src.v2.utils.logger import get_logger
from src.v2.utils.file_utils import load_json_file, save_json_file

logger = get_logger(__name__)

REPORTS_DIR = "src/v2/data/reports"
MONTHLY_PNL_FILE = os.path.join(REPORTS_DIR, "monthly_pnl.json")

def generate_monthly_profitability():
    logger.info("📊 Génération du PnL mensuel...")

    trades = load_json_file("src/v2/data/simulation/trade_simulation.json", default=[])
    if not trades:
        logger.warning("⚠️ Aucun trade trouvé, PnL mensuel non généré.")
        return

    monthly_stats = defaultdict(lambda: {"pnl": 0, "trade_count": 0})
    for trade in trades:
        ts = trade.get("timestamp")
        if not ts:
            continue
        month = ts[:7]  # YYYY-MM
        monthly_stats[month]["trade_count"] += 1
        monthly_stats[month]["pnl"] += trade.get("pnl", 0)

    save_json_file(MONTHLY_PNL_FILE, dict(monthly_stats))
    logger.info(f"✅ PnL mensuel sauvegardé dans {MONTHLY_PNL_FILE}")

if __name__ == "__main__":
    generate_monthly_profitability()
log = logging.getLogger("main")

# --- .env ---
try:
    from dotenv import load_dotenv
    # charge d’abord l’ENV racine si présent
    root_env = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".env"))
    if os.path.isfile(root_env):
        load_dotenv(root_env, override=False)
    # puis l’ENV v2
    v2_env = os.path.abspath(os.path.join(os.path.dirname(__file__), ".env"))
    if os.path.isfile(v2_env):
        load_dotenv(v2_env, override=True)
except Exception as e:
    log.warning("dotenv non chargé: %s", e)

# --- Helpers ---
def _flag(name: str, default: str = "0") -> bool:
    return str(os.getenv(name, default)).strip() in {"1", "true", "True", "yes", "on"}

def _call_any_export(module_name: str, candidates: list[str]) -> tuple[bool, str | None]:
    """
    Importe module_name et tente d’appeler le premier export callable présent dans candidates.
    Gère sync/async (asyncio.run). Retourne (success, function_used_or_error_msg).
    """
    try:
        mod = importlib.import_module(module_name)
    except Exception as e:
        return False, f"import failed: {e}"

    for fn_name in candidates:
        fn = getattr(mod, fn_name, None)
        if callable(fn):
            try:
                if asyncio.iscoroutinefunction(fn):
                    asyncio.run(fn())
                else:
                    res = fn()
                    # Si la fonction async est renvoyée (cas où fn retourne une coroutine), on la run:
                    if asyncio.iscoroutine(res):
                        asyncio.run(res)
                return True, fn_name
            except Exception as e:
                return False, f"{fn_name} raised: {e}"

    return False, "no callable export found"

def run_telegram_scraper() -> bool:
    """
    Essaie différentes conventions d’export pour le scraper.
    """
    # Debug: affichage des groupes si le module les trace au niveau import
    try:
        mod = importlib.import_module("src.v2.social.telegram_scraper")
        _ = mod  # no-op pour déclencher d’éventuels prints/debug au import
    except Exception:
        pass

    ok, info = _call_any_export(
        "src.v2.social.telegram_scraper",
        candidates=["scrape_telegram", "main", "run"]
    )
    if ok:
        log.info("✅ Scraping Telegram exécuté via export: %s", info)
    else:
        log.warning("⚠️ Scraping Telegram indisponible (%s)", info)
    return ok

def run_send_reports() -> bool:
    """
    1) Tente d’appeler un point d’entrée Python s’il existe.
    2) Sinon fallback sur le wrapper shell (fiable chez toi).
    """
    ok, info = _call_any_export(
        "src.v2.scripts.send_reports",
        candidates=["main", "run", "send", "entrypoint"]
    )
    if ok:
        log.info("✅ Envoi des rapports (module) via export: %s", info)
        return True

    log.warning("⚠️ Envoi des rapports (module) indisponible (%s) — fallback wrapper.", info)
    wrapper = os.path.abspath(os.path.join(os.path.dirname(__file__), "bin", "send_reports_wrapper.sh"))
    if not os.path.isfile(wrapper):
        log.error("❌ Wrapper introuvable: %s", wrapper)
        return False
    try:
        # On passe par bash -lc pour garder l’environnement (.env chargé par systemd si service)
        cp = subprocess.run(
            ["/bin/bash", "-lc", wrapper],
            cwd=os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..")),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=600
        )
        if cp.returncode == 0:
            log.info("✅ Envoi des rapports (wrapper) OK.")
            return True
        else:
            log.error("❌ Wrapper a renvoyé %s\nstdout:\n%s\nstderr:\n%s", cp.returncode, cp.stdout, cp.stderr)
            return False
    except Exception as e:
        log.error("❌ Échec wrapper: %s", e)
        return False


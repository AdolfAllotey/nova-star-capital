"""
capital_allocator.py
-------------------------
Brique : Capital allocation "hedge fund light" pour Nova Star Capital.

Rôle :
  - Lire la config de capital (capital total, pourcentage par poche)
  - Lire le régime de marché (bull / neutral / bear)
  - Lire le régime émotionnel (calm / heated / tilt_risk)
  - Calculer :
      * répartition par poches (Trading / LT / Sécurité / BFR)
      * capital par trade
      * max_concurrent_positions
  - Sauvegarder le tout dans data/trading/capital_allocation.json

Intégrations :
  - Market regime :
      * bull   → plus d'exposition trading
      * bear   → réduction trading, plus de sécurité
  - Emotional regime :
      * calm       → normal
      * heated     → réduction taille (reduce_size)
      * tilt_risk  → pause (capital_per_trade=0, max_positions=0)
"""

from __future__ import annotations

from dataclasses import dataclass, asdict
from pathlib import Path
from typing import Any, Dict, Optional

from datetime import datetime, timezone
import os

try:
    from src.v2.utils.logger import get_logger
except ImportError:  # pragma: no cover
    from src.v2.utils.logger import get_logger  # type: ignore

logger = get_logger("capital_allocator")

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

ROOT_DIR = Path(__file__).resolve().parents[3]  # /opt/nsc/app
DATA_DIR = ROOT_DIR / "data"
TRADING_DIR = DATA_DIR / "trading"
MARKET_DIR = DATA_DIR / "market"
ANALYSIS_DIR = DATA_DIR / "analysis"

TRADING_DIR.mkdir(parents=True, exist_ok=True)
MARKET_DIR.mkdir(parents=True, exist_ok=True)
ANALYSIS_DIR.mkdir(parents=True, exist_ok=True)

CAPITAL_CONFIG_FILE = TRADING_DIR / "capital_config.json"
CAPITAL_ALLOCATION_FILE = TRADING_DIR / "capital_allocation.json"
MARKET_REGIME_FILE = MARKET_DIR / "market_regime.json"
MARKET_OVERVIEW_FILE = MARKET_DIR / "market_overview.json"
EMOTIONAL_REGIME_FILE = ANALYSIS_DIR / "emotional_regime.json"

logger.info("[capital_allocator] ROOT_DIR=%s, DATA_DIR=%s", ROOT_DIR, DATA_DIR)

# ---------------------------------------------------------------------------
# file_utils fallback
# ---------------------------------------------------------------------------

try:
    from src.v2.utils.file_utils import load_json_file, save_json_file  # type: ignore
except Exception:  # pragma: no cover
    load_json_file = None
    save_json_file = None

    import json

    def _load_json(path: Path, default: Any = None) -> Any:
        if not path.exists():
            return default
        try:
            with path.open("r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            logger.exception("[capital_allocator] Erreur lors du chargement JSON: %s", path)
            return default

    def _save_json(path: Path, data: Any) -> None:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.open("w", encoding="utf-8") as f:
                import json as _json

                _json.dump(data, f, indent=2, ensure_ascii=False)
        except Exception:
            logger.exception("[capital_allocator] Erreur lors de l'écriture JSON: %s", path)
else:

    def _load_json(path: Path, default: Any = None) -> Any:
        return load_json_file(str(path), default=default)

    def _save_json(path: Path, data: Any) -> None:
        save_json_file(str(path), data)


# ---------------------------------------------------------------------------
# Dataclasses & helpers
# ---------------------------------------------------------------------------

@dataclass
class CapitalConfig:
    total_capital: float = 10_000.0
    pockets: Dict[str, float] = None  # pourcentages
    base_risk_per_trade_pct: float = 0.02  # 2% de la poche trading
    max_concurrent_positions: int = 50

    def __post_init__(self) -> None:
        if self.pockets is None:
            # Par défaut : 45% Trading / 35% LT / 15% Sécurité / 5% BFR
            self.pockets = {
                "trading": 0.45,
                "long_term": 0.35,
                "security": 0.15,
                "bfr": 0.05,
            }


@dataclass
class CapitalAllocation:
    timestamp: str
    regime: str
    emotional_regime: Optional[str]
    emotional_action: Optional[str]
    total_capital: float
    pockets: Dict[str, float]
    capital_per_trade: float
    max_concurrent_positions: int

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def _safe_float(x: Any, default: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return default


# ---------------------------------------------------------------------------
# Loaders
# ---------------------------------------------------------------------------

def _load_capital_config() -> CapitalConfig:
    data = _load_json(CAPITAL_CONFIG_FILE, default=None)
    if not isinstance(data, dict):
        logger.warning(
            "[capital_allocator] Fichier %s introuvable ou invalide, utilisation du capital par défaut: %.2f",
            CAPITAL_CONFIG_FILE,
            10_000.0,
        )
        return CapitalConfig()

    total = _safe_float(data.get("total_capital"), 10_000.0)
    pockets_raw = data.get("pockets") or {}
    pockets: Dict[str, float] = {}

    for k in ("trading", "long_term", "security", "bfr"):
        v = pockets_raw.get(k)
        if v is None:
            pockets[k] = 0.0
        else:
            pockets[k] = _safe_float(v, 0.0)

    # Si la somme est ~1, on considère que ce sont des pourcentages déjà normés
    s = sum(pockets.values())
    if 0.99 <= s <= 1.01:
        pass
    elif s > 0:
        # renormalisation
        pockets = {k: v / s for k, v in pockets.items()}
    else:
        # fallback par défaut
        pockets = {
            "trading": 0.45,
            "long_term": 0.35,
            "security": 0.15,
            "bfr": 0.05,
        }

    base_risk_pct = _safe_float(data.get("base_risk_per_trade_pct"), 0.02)
    max_pos = int(data.get("max_concurrent_positions") or 50)

    cfg = CapitalConfig(
        total_capital=total,
        pockets=pockets,
        base_risk_per_trade_pct=base_risk_pct,
        max_concurrent_positions=max_pos,
    )
    return cfg


def _load_market_regime() -> str:
    """
    Retourne bull / neutral / bear (par défaut neutral)
    """
    data = _load_json(MARKET_REGIME_FILE, default=None)
    if isinstance(data, dict) and "regime" in data:
        val = str(data.get("regime") or "neutral").lower()
        if val in {"bull", "neutral", "bear"}:
            return val

    # Fallback : essayer market_overview
    data2 = _load_json(MARKET_OVERVIEW_FILE, default=None)
    if isinstance(data2, dict) and "regime" in data2:
        val = str(data2.get("regime") or "neutral").lower()
        if val in {"bull", "neutral", "bear"}:
            return val

    logger.warning(
        "[capital_allocator] Aucun fichier de régime trouvé (%s ou %s), utilisation de 'neutral'.",
        MARKET_REGIME_FILE,
        MARKET_OVERVIEW_FILE,
    )
    return "neutral"


def _load_emotional_regime() -> Dict[str, Any]:
    """
    Charge emotional_regime.json s'il existe.
    Retourne un dict avec :
      - regime (calm / heated / tilt_risk)
      - recommended_action (normal / reduce_size / pause_trading)
      - score_emotional ...
    """
    data = _load_json(EMOTIONAL_REGIME_FILE, default=None)
    if isinstance(data, dict) and "regime" in data:
        return data
    logger.warning(
        "[capital_allocator] emotional_regime.json introuvable ou invalide (%s), fallback calm/normal.",
        EMOTIONAL_REGIME_FILE,
    )
    return {
        "regime": "calm",
        "recommended_action": "normal",
        "score_emotional": 80.0,
    }


# ---------------------------------------------------------------------------
# Core logic
# ---------------------------------------------------------------------------

def _apply_market_regime_adjustments(cfg: CapitalConfig, regime: str) -> CapitalConfig:
    """
    Ajuste les poches en fonction du régime de marché.
    - bull   : +10% trading, -10% sécurité (dans la limite)
    - bear   : -10% trading, +10% sécurité
    - neutral: inchangé
    """
    pockets = dict(cfg.pockets)

    if regime == "bull":
        pockets["trading"] += 0.10
        pockets["security"] -= 0.10
    elif regime == "bear":
        pockets["trading"] -= 0.10
        pockets["security"] += 0.10

    # clamp & renorm
    for k in pockets:
        pockets[k] = max(0.0, pockets[k])
    s = sum(pockets.values())
    if s > 0:
        pockets = {k: v / s for k, v in pockets.items()}

    cfg_adj = CapitalConfig(
        total_capital=cfg.total_capital,
        pockets=pockets,
        base_risk_per_trade_pct=cfg.base_risk_per_trade_pct,
        max_concurrent_positions=cfg.max_concurrent_positions,
    )
    return cfg_adj


def _apply_emotional_adjustments(
    trading_capital: float,
    base_risk_per_trade_pct: float,
    max_positions: int,
    emotional_regime: Dict[str, Any],
) -> Dict[str, Any]:
    """
    Applique les freins émotionnels :
      - calm / normal       → pas de changement
      - heated / reduce_size → risk_per_trade diminué
      - tilt_risk / pause_trading → capital_per_trade=0, max_positions=0
    """
    regime = str(emotional_regime.get("regime", "calm"))
    action = str(emotional_regime.get("recommended_action", "normal"))

    factor = 1.0
    if action == "reduce_size" or regime == "heated":
        factor = 0.5
    elif action == "pause_trading" or regime == "tilt_risk":
        factor = 0.0

    risk_pct_adj = base_risk_per_trade_pct * factor
    if factor == 0.0:
        capital_per_trade = 0.0
        max_positions_adj = 0
    else:
        capital_per_trade = trading_capital * risk_pct_adj
        max_positions_adj = max_positions

    return {
        "regime": regime,
        "action": action,
        "factor": factor,
        "risk_per_trade_pct": risk_pct_adj,
        "capital_per_trade": capital_per_trade,
        "max_concurrent_positions": max_positions_adj,
    }


def compute_allocation() -> CapitalAllocation:
    cfg = _load_capital_config()
    regime = _load_market_regime()
    emo = _load_emotional_regime()

    # Ajustement market regime
    cfg_adj = _apply_market_regime_adjustments(cfg, regime)

    total_capital = cfg_adj.total_capital
    pockets_amount: Dict[str, float] = {
        k: round(total_capital * v, 2) for k, v in cfg_adj.pockets.items()
    }

    trading_capital = pockets_amount.get("trading", 0.0)

    emo_adjust = _apply_emotional_adjustments(
        trading_capital=trading_capital,
        base_risk_per_trade_pct=cfg_adj.base_risk_per_trade_pct,
        max_positions=cfg_adj.max_concurrent_positions,
        emotional_regime=emo,
    )

    capital_per_trade = emo_adjust["capital_per_trade"]
    max_positions = emo_adjust["max_concurrent_positions"]

    logger.info(
        "[capital_allocator] Allocation: regime=%s, emotional_regime=%s, action=%s, total=%.2f, trading=%.2f, capital_per_trade=%.2f, max_positions=%d",
        regime,
        emo_adjust["regime"],
        emo_adjust["action"],
        total_capital,
        trading_capital,
        capital_per_trade,
        max_positions,
    )

    alloc = CapitalAllocation(
        timestamp=datetime.now(timezone.utc).isoformat(),
        regime=regime,
        emotional_regime=emo_adjust["regime"],
        emotional_action=emo_adjust["action"],
        total_capital=total_capital,
        pockets=pockets_amount,
        capital_per_trade=capital_per_trade,
        max_concurrent_positions=max_positions,
    )
    return alloc


def save_allocation(alloc: CapitalAllocation) -> None:
    _save_json(CAPITAL_ALLOCATION_FILE, alloc.to_dict())
    logger.info(
        "[capital_allocator] Allocation sauvegardée dans %s (regime=%s, total=%.2f, capital_per_trade=%.2f, max_positions=%d)",
        CAPITAL_ALLOCATION_FILE,
        alloc.regime,
        alloc.total_capital,
        alloc.capital_per_trade,
        alloc.max_concurrent_positions,
    )


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> None:
    alloc = compute_allocation()
    save_allocation(alloc)

if __name__ == "__main__":
    main()

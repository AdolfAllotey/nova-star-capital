def _check_orchestrator_gate() -> tuple[bool, bool]:
    """
    Gate runtime (orchestrator-first):
      - return (ok, orch_available)
      - ok=False => stop trading
      - orch_available=False => fail-open + allow SQ fallback gate
    """
    try:
        st = _load_json(ORCHESTRATOR_STATE_FILE, default=None)
    except Exception:
        return (True, False)

    if not isinstance(st, dict):
        return (True, False)  # orchestrator indisponible => fail-open + SQ fallback

    can_trade = bool(st.get("can_trade", True))
    mode = str(st.get("mode") or "unknown")
    reasons = st.get("reasons", []) or []
    severity = str(st.get("severity") or "info")

    if not can_trade:
        logger.warning(
            "[trading_kernel] Boucle annulée par Orchestrator gate: can_trade=False mode=%s severity=%s reasons=%s",
            mode, severity, reasons
        )
        return (False, True)

    return (True, True)

def run_once(max_new_positions: Optional[int] = None) -> None:
    """
    Exécute une boucle complète "hedge fund light" :

      0) Vérifie kill_switch + guards de risque
      1) momentum_scoring
      2) signal_voting
      3) capital_allocator
      4) position_manager

    max_new_positions : réservé pour usage futur (limiter le nombre
    de nouvelles positions par cycle).
    """
    run_id = _new_run_id()
    _write_execution_plan_stub(run_id, note="run started")

    # 0) Kill-switch & risk guards
    if is_kill_switch_enabled():
        # CORE: si kill-switch => écrase execution_plan.json pour éviter un plan stale
        try:
            from datetime import datetime, timezone
            cfg = _load_json(KILL_SWITCH_FILE, default={}) or {}
            reason = "kill_switch:" + str(cfg.get("reason") or "enabled")
            _write_execution_plan(
                run_id=run_id,
                status="blocked",
                note="blocked_at_kernel_gate",
                orders=[],
                hard_block=True,
                reasons=[reason],
                source="kill_switch",
                gov_note="KILL SWITCH => orders cleared at kernel gate",
            )
            logger.warning("[trading_kernel] kill-switch => execution_plan.json écrasé (orders=0)")
        except Exception:
            logger.exception("[trading_kernel] kill-switch => échec écriture execution_plan.json")
            logger.warning("[trading_kernel] Boucle annulée car le kill-switch est activé.")
        return
    # Sync risk_limits depuis orchestrator (si dispo) avant guards/sizing
    # 1) Orchestrator gate = source de vérité runtime
    ok, orch_available = _check_orchestrator_gate()
    if not orch_available:
        # CORE: orchestrator indisponible => fail-closed + anti-stale
        try:
            from datetime import datetime, timezone
            _write_execution_plan(
                run_id=run_id,
                status="blocked",
                note="blocked_at_kernel_gate",
                orders=[],
                hard_block=True,
                reasons=["orchestrator_unavailable"],
                source="orchestrator_unavailable",
                gov_note="ORCHESTRATOR UNAVAILABLE => orders cleared at kernel gate",
            )
            logger.warning("[trading_kernel] orchestrator indisponible => execution_plan.json écrasé (orders=0)")
        except Exception:
            logger.exception("[trading_kernel] orchestrator indisponible => échec écriture execution_plan.json")
            logger.warning("[trading_kernel] Boucle annulée: orchestrator indisponible (fail-closed).")
        return

    if not ok:
        # CORE: orchestrator hard-block => écrase execution_plan.json (anti-stale)
        try:
            from datetime import datetime, timezone
            st = _load_json(ORCHESTRATOR_STATE_FILE, default={}) or {}
            reasons = st.get("reasons", []) or []
            reason = "orchestrator:can_trade=false"
            if reasons:
                reason = reason + ":" + ",".join([str(r) for r in reasons[:5]])

            plan_path = TRADING_DIR / "execution_plan.json"
            _write_execution_plan(
                run_id=run_id,
                status="blocked",
                note="blocked_at_kernel_gate",
                orders=[],
                hard_block=True,
                reasons=[reason],
                source="orchestrator:can_trade=false",
                gov_note="ORCHESTRATOR HARD BLOCK => orders cleared at kernel gate",
            )
            logger.warning("[trading_kernel] orchestrator hard-block => execution_plan.json écrasé (orders=0)")
        except Exception:
            logger.exception("[trading_kernel] orchestrator hard-block => échec écriture execution_plan.json")
        return
    # 2) Applique les risk_limits issus de l'orchestrator (sizing/reduced/etc.)
    _apply_orchestrator_risk_limits()

    # 3) Signal Quality gate = garde-fou supplémentaire (redondant avec orchestrator)
    if not _check_signal_quality_gate():
        # CORE: Signal Quality hard-block => écrase execution_plan.json (anti-stale)
        try:
            from datetime import datetime, timezone
            sq = _load_json(SIGNAL_QUALITY_FILE, default={}) or {}
            flag = str(sq.get("flag") or "unknown")
            hard_block = bool(sq.get("hard_block", False))
            score = sq.get("score", None)

            reason = "signal_quality:block"
            if hard_block:
                reason = "signal_quality:hard_block=true"
            elif flag == "hard_block":
                reason = "signal_quality:flag=hard_block"
            elif score is not None:
                reason = f"signal_quality:score={score}"

            plan_path = TRADING_DIR / "execution_plan.json"
            _write_execution_plan(
                run_id=run_id,
                status="blocked",
                note="blocked_at_kernel_gate",
                orders=[],
                hard_block=True,
                reasons=[reason],
                source="signal_quality:block",
                gov_note="SIGNAL QUALITY HARD BLOCK => orders cleared at kernel gate",
            )
            logger.warning("[trading_kernel] signal_quality hard-block => execution_plan.json écrasé (orders=0)")
        except Exception:
            logger.exception("[trading_kernel] signal_quality hard-block => échec écriture execution_plan.json")
            logger.warning("[trading_kernel] Boucle annulée par Signal Quality Engine (score<threshold ou hard_block).")
        return
    # CORE (Option A): anti-stale Step1+Step2 dynamic imports
    # (on évite les imports statiques ici pour que les tests mv déclenchent bien l'ANTI-STALE)
    from src.v2.trading.position_manager import main as position_manager_main

    logger.info("[trading_kernel] Démarrage de la boucle hedge fund light (run_once).")

    # Étape 1 : momentum

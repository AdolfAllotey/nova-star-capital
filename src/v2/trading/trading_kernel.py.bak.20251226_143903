def _new_run_id() -> str:
    return str(int(time.time() * 1000))


def _write_execution_plan(
    run_id: str,
    status: str,
    note: str,
    *,
    orders: Optional[list] = None,
    hard_block: bool = True,
    reasons: Optional[list] = None,
    source: Optional[str] = None,
    gov_note: str = "",
) -> None:
    from datetime import datetime, timezone

    if orders is None:
        orders = []
    if reasons is None:
        reasons = []

    plan = {
        "run_id": run_id,
        "status": status,
        "note": note,
        "writer": "trading_kernel",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "orders": orders,
        "governance": {
            "hard_block": bool(hard_block),
            "reasons": reasons,
        },
    }
    if gov_note:
        plan["governance"]["note"] = gov_note
    if source:
        plan["governance"]["source"] = source

    _save_json(TRADING_DIR / "execution_plan.json", plan)

    try:
        with open(RUN_ID_FILE, "w") as f:
            f.write(run_id)
    except Exception:
        logger.exception("[trading_kernel] unable to write RUN_ID_FILE")

    logger.info("[trading_kernel] execution_plan written (run_id=%s status=%s)", run_id, status)



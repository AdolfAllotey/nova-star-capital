# src/v2/trading/position_sizing_institutional.py

from __future__ import annotations

import os
from pathlib import Path
from typing import Any, Dict, List, Tuple

from src.v2.utils.logger import get_logger
from src.v2.utils.file_utils import load_json_file, save_json_file

logger = get_logger(__name__)

ROOT_DIR = Path(__file__).resolve().parents[3]
DATA_DIR = Path(os.getenv("NSC_DATA_DIR", ROOT_DIR / "data"))


def _load_signals(data_dir: Path) -> List[Dict[str, Any]]:
    """
    Charge les signaux bruts à dimensionner.

    Source actuelle :
    - data/analysis/signal_candidates.json (sortie de signal_voting)

    Si le fichier est absent ou mal formé → [].
    """
    candidates_path = data_dir / "analysis" / "signal_candidates.json"
    signals = load_json_file(candidates_path, default=[])

    if not isinstance(signals, list):
        logger.warning(
            "[position_sizing_institutional] signal_candidates.json n'est pas une liste, reset []."
        )
        return []

    logger.info(
        "[position_sizing_institutional] %d signaux bruts chargés depuis %s.",
        len(signals),
        candidates_path,
    )
    return signals


def _load_risk_engine(data_dir: Path) -> Dict[str, Dict[str, Any]]:
    """
    Charge risk_engine_pro.json et renvoie un mapping symbol -> asset_risk.
    """
    path = data_dir / "analysis" / "risk_engine_pro.json"
    data = load_json_file(path, default={})

    assets = []
    if isinstance(data, dict):
        assets = data.get("assets", [])
    elif isinstance(data, list):
        assets = data

    risk_by_symbol: Dict[str, Dict[str, Any]] = {}
    for a in assets:
        sym = a.get("symbol")
        if not sym:
            continue
        risk_by_symbol[sym] = a

    logger.info(
        "[position_sizing_institutional] Risk engine chargé pour %d assets (source=%s).",
        len(risk_by_symbol),
        path,
    )
    return risk_by_symbol


def _load_weak_signals(data_dir: Path) -> Dict[str, Dict[str, Any]]:
    """
    Charge weak_signals_engine_pro.json et renvoie un mapping symbol -> weak_info.
    """
    path = data_dir / "analysis" / "weak_signals_engine_pro.json"
    data = load_json_file(path, default={})

    assets = []
    if isinstance(data, dict):
        assets = data.get("assets", [])
    elif isinstance(data, list):
        assets = data

    weak_by_symbol: Dict[str, Dict[str, Any]] = {}
    for a in assets:
        sym = a.get("symbol")
        if not sym:
            continue
        weak_by_symbol[sym] = a

    logger.info(
        "[position_sizing_institutional] Weak signals chargé pour %d assets (source=%s).",
        len(weak_by_symbol),
        path,
    )
    return weak_by_symbol


def _apply_sizing_for_signal(
    sig: Dict[str, Any],
    risk: Dict[str, Any] | None,
    weak: Dict[str, Any] | None,
) -> Dict[str, Any]:
    """
    Applique la logique de position sizing institutionnel sur un signal.

    - base_weight: poids brut du signal (1.0 par défaut)
    - size_multiplier_risk: multiplicateur de taille fourni par risk_engine_pro
    - weak_kind: weak_watch / weak_avoid
    - hard_veto: taille = 0
    """

    symbol = sig.get("symbol")
    side = sig.get("side", "buy")
    strategy = sig.get("strategy", "unknown")

    base_weight = float(sig.get("weight", 1.0))

    notes: List[str] = []
    risk_flag = None
    size_mult_risk = 1.0
    hard_veto = False
    soft_veto = False
    meta_score = None

    if risk:
        risk_flag = risk.get("risk_flag")
        size_mult_risk = float(risk.get("size_multiplier", 1.0))
        flags = risk.get("flags", {})
        hard_veto = bool(flags.get("hard_veto", False))
        soft_veto = bool(flags.get("soft_veto", False))
        meta_score = risk.get("inputs", {}).get("meta_score_pro")

        notes.append(f"Risk flag={risk_flag}, base_mult={size_mult_risk:.2f}")
        if hard_veto:
            notes.append("Hard veto (risk_engine_pro)")
        if soft_veto:
            notes.append("Soft veto (risk_engine_pro)")

    weak_kind = None
    if weak:
        weak_kind = weak.get("kind")
        notes.append(f"Weak signal kind={weak_kind}")

    # 1) Base : poids x multiplicateur risk
    final_mult = base_weight * size_mult_risk

    # 2) Hard veto → taille = 0
    if hard_veto:
        final_mult = 0.0
        notes.append("Hard veto → taille=0.0")

    # 3) Gestion des weak signals
    if weak_kind == "weak_avoid":
        # Ici on est sévère : taille coupée.
        final_mult *= 0.0
        notes.append("weak_avoid → taille coupée (0.0)")
    elif weak_kind == "weak_watch":
        # Ici on réduit, mais on ne coupe pas totalement.
        final_mult *= 0.5
        notes.append("weak_watch → taille réduite (x0.5)")

    sized = {
        **sig,
        "symbol": symbol,
        "side": side,
        "strategy": strategy,
        "base_weight": base_weight,
        "risk_score": risk.get("risk_score") if risk else None,
        "risk_flag": risk_flag,
        "size_multiplier_risk": size_mult_risk,
        "weak_kind": weak_kind,
        "hard_veto": hard_veto,
        "soft_veto": soft_veto,
        "final_size_multiplier": final_mult,
        "final_weight": final_mult,
        "meta_score_pro": meta_score,
        "notes": notes,
    }

    return sized


def compute_sized_signals(data_dir: Path) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
    """
    Calcule les signaux dimensionnés à partir de :
    - signal_candidates.json
    - risk_engine_pro.json
    - weak_signals_engine_pro.json
    """
    signals = _load_signals(data_dir)
    if not signals:
        logger.warning(
            "[position_sizing_institutional] Aucun signal brut trouvé, sized_signals=[]"
        )
        return [], {
            "nb_signals": 0,
            "nb_positive": 0,
            "nb_zero": 0,
            "nb_negative": 0,
        }

    risk_by_symbol = _load_risk_engine(data_dir)
    weak_by_symbol = _load_weak_signals(data_dir)

    sized_signals: List[Dict[str, Any]] = []
    nb_pos = 0
    nb_zero = 0
    nb_neg = 0

    for sig in signals:
        sym = sig.get("symbol")
        risk = risk_by_symbol.get(sym)
        weak = weak_by_symbol.get(sym)

        sized = _apply_sizing_for_signal(sig, risk, weak)
        sized_signals.append(sized)

        w = sized.get("final_weight", 0.0)
        if w > 0:
            nb_pos += 1
        elif w < 0:
            nb_neg += 1
        else:
            nb_zero += 1

    stats = {
        "nb_signals": len(sized_signals),
        "nb_positive": nb_pos,
        "nb_zero": nb_zero,
        "nb_negative": nb_neg,
    }

    return sized_signals, stats


def main() -> None:
    data_dir = DATA_DIR
    logger.info(
        "[position_sizing_institutional] DATA_DIR=%s", str(data_dir)
    )

    sized_signals, stats = compute_sized_signals(data_dir)

    out_dir = data_dir / "trading"
    out_dir.mkdir(parents=True, exist_ok=True)
    out_path = out_dir / "sized_signals.json"

    save_json_file(out_path, sized_signals)
    logger.info(
        "[position_sizing_institutional] sized_signals.json sauvegardé (%s, nb_signals=%d, nb_pos=%d, nb_zero=%d, nb_neg=%d)",
        out_path,
        stats["nb_signals"],
        stats["nb_positive"],
        stats["nb_zero"],
        stats["nb_negative"],
    )


if __name__ == "__main__":
    main()

        position_manager_main()
    except Exception:
        logger.exception("[trading_kernel] Erreur lors de position_manager.main()")
        return


    # ───────────────────────────────────────────────────────────
    # Kernel Run Summary (logs lisibles en timer)
    # ───────────────────────────────────────────────────────────

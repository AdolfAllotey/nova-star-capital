# Entrypoint (compat daily_trading_loop)
# ---------------------------------------------------------------------------
def main() -> dict:
    """
    Entrypoint standard pour la boucle journalière.
    Essaie d'appeler une fonction existante si le module en expose déjà une.
    Retourne toujours un dict (même en noop).
    """
    try:
        # Essaye plusieurs noms "probables" sans casser l'existant
        for fn_name in (
            "run",
            "generate",
            "build",
            "compute",
            "execute",
            "generate_daily",
            "generate_report",
            "generate_knowledge_daily",
            "build_signal_quality",
            "compute_signal_quality",
        ):
            fn = globals().get(fn_name)
            if callable(fn):
                out = fn()
                return out if isinstance(out, dict) else {"status": "ok", "result": out}

        # Noop safe si aucune fonction évidente n'existe
        try:
            logger.info("[%s] main() noop: aucune fonction run/generate/build trouvée", __name__)
        except Exception:
            pass
        return {"status": "noop", "module": __name__}

    except Exception as e:  # noqa: BLE001
        try:
            logger.exception("[%s] main() failed: %s", __name__, e)
        except Exception:
            pass
        return {"status": "error", "module": __name__, "error": str(e)}


if __name__ == "__main__":
    res = main()
    try:
        print(res)
    except Exception:
        pass

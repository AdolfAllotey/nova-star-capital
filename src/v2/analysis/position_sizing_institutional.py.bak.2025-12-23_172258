# src/v2/analysis/position_sizing_institutional.py

"""
Position Sizing Institutionnel – Nova Star Capital (Saison 2 / Pro)

Objectif :
- Lire les sorties de `risk_engine_pro.json` + éventuellement la risk console.
- Définir, pour chaque asset, un "risk budget" par trade (% du capital)
  et un plafond de taille notional (% du capital total).
- Respecter le mode global (ok / caution / danger / block) et les hard/soft vetos.

Sortie :
- data/analysis/position_sizing_institutional.json

Ce module ne connaît PAS le capital absolu (en €). Il travaille en pourcentage.
Le calcul du montant en € se fera plus tard dans l'executor / capital allocator.
"""

import json
import logging
import os
from pathlib import Path
from typing import Any, Dict, List

from src.v2.utils.file_utils import load_json_file, save_json_file

logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.INFO)


def _get_data_dir() -> Path:
    """
    Détermine le DATA_DIR en priorité via la variable d'environnement NSC_DATA_DIR,
    sinon en utilisant le chemin du projet (/opt/nsc/app/data typiquement).
    """
    env_dir = os.getenv("NSC_DATA_DIR")
    if env_dir:
        data_dir = Path(env_dir).resolve()
    else:
        # src/v2/analysis/position_sizing_institutional.py -> remonter jusqu'à /opt/nsc/app
        data_dir = Path(__file__).resolve().parents[3] / "data"

    logger.info("[position_sizing_institutional] DATA_DIR=%s", data_dir)
    return data_dir


# Configuration institutionnelle : base de risk par trade en fonction du mode global
RISK_MODE_CONFIG: Dict[str, Dict[str, float]] = {
    # mode "normal" – on peut prendre 1% par trade / 5% max par asset
    "ok": {"per_trade_risk_pct": 1.0, "max_notional_pct": 5.0},

    # mode "prudence" – on coupe en deux le risque
    "caution": {"per_trade_risk_pct": 0.5, "max_notional_pct": 3.0},

    # mode "danger" – on ne fait que de petits tirs
    "danger": {"per_trade_risk_pct": 0.25, "max_notional_pct": 1.5},

    # mode "block" – on ne doit pas ouvrir de nouvelles positions
    "block": {"per_trade_risk_pct": 0.0, "max_notional_pct": 0.0},
}

# Ajustement en fonction du risk_flag de l'asset (issu de risk_engine_pro)
RISK_FLAG_ADJUST: Dict[str, float] = {
    "ok": 1.0,
    "caution": 0.5,
    "danger": 0.0,  # en danger, on ne prend plus de nouvelle exposition
}


def _load_risk_engine(data_dir: Path) -> Dict[str, Any]:
    path = data_dir / "analysis" / "risk_engine_pro.json"
    data = load_json_file(str(path), default={})
    if not data:
        logger.warning(
            "[position_sizing_institutional] risk_engine_pro.json vide ou introuvable (%s)",
            path,
        )
    return data


def _load_risk_console(data_dir: Path) -> Dict[str, Any]:
    """
    Charge la risk console pour récupérer le global_flag (ok / caution / danger / block).

    Si le fichier n'existe pas, on suppose un mode "caution" par sécurité.
    """
    path = data_dir / "analysis" / "risk_console_overview.json"
    data = load_json_file(str(path), default={})
    if not data:
        logger.warning(
            "[position_sizing_institutional] risk_console_overview.json vide ou introuvable (%s), "
            "utilisation du mode 'caution' par défaut.",
            path,
        )
        return {"global_flag": "caution"}
    return data


def compute_position_sizing(
    risk_engine: Dict[str, Any],
    risk_console: Dict[str, Any],
) -> Dict[str, Any]:
    """
    Calcule la taille de position institutionnelle par asset.

    Entrées :
      - risk_engine : contenu de risk_engine_pro.json
      - risk_console : contenu de risk_console_overview.json (principalement global_flag)

    Sortie :
      - dict complet avec "config" globale et liste "assets" détaillant le risk par asset.
    """
    assets: List[Dict[str, Any]] = risk_engine.get("assets", []) or []

    # Mode global tiré de la risk console (ou caution par défaut)
    global_flag = (risk_console.get("global_flag") or "caution").lower()
    mode_cfg = RISK_MODE_CONFIG.get(global_flag, RISK_MODE_CONFIG["caution"])

    per_trade_risk_base = mode_cfg["per_trade_risk_pct"]  # % du capital par trade
    max_notional_base = mode_cfg["max_notional_pct"]      # % du capital max par asset

    results_assets: List[Dict[str, Any]] = []
    nb_assets = 0
    nb_hard_veto = 0
    nb_soft_veto = 0
    total_final_risk_pct = 0.0

    for a in assets:
        symbol = a.get("symbol")
        risk_score = float(a.get("risk_score", 0.0))
        risk_flag = (a.get("risk_flag") or "caution").lower()
        size_mult_risk_engine = float(a.get("size_multiplier", 1.0))

        flags = a.get("flags", {}) or {}
        hard_veto = bool(flags.get("hard_veto", False))
        soft_veto = bool(flags.get("soft_veto", False))

        adjust = RISK_FLAG_ADJUST.get(risk_flag, 0.5)

        # Si hard veto, aucun risque sur cet asset
        if hard_veto or global_flag == "block":
            final_risk_pct = 0.0
            final_max_notional_pct = 0.0
            reason_veto = "Hard veto actif" if hard_veto else "Mode global 'block'"
        else:
            # Base par trade (mode global) * ajustement par risk_flag * multiplicateur du risk engine
            final_risk_pct = per_trade_risk_base * adjust * size_mult_risk_engine
            final_max_notional_pct = max_notional_base * adjust

            reason_veto = None

        # Compteurs pour stats
        nb_assets += 1
        if hard_veto:
            nb_hard_veto += 1
        if soft_veto:
            nb_soft_veto += 1
        total_final_risk_pct += final_risk_pct

        reasons: List[str] = []
        reasons.append(f"Risk flag={risk_flag}, risk_score={risk_score:.1f}")
        reasons.append(
            f"Base mode={global_flag} → {per_trade_risk_base:.2f}% par trade, {max_notional_base:.2f}% max par asset"
        )
        reasons.append(
            f"Ajustement risk_flag={risk_flag} → x{adjust:.2f}, size_multiplier_risk_engine={size_mult_risk_engine:.2f}"
        )
        if hard_veto or global_flag == "block":
            reasons.append(reason_veto or "")
        elif soft_veto:
            reasons.append("Soft veto actif (risque réduit mais non nul)")

        # Nettoyer les raisons vides
        reasons = [r for r in reasons if r]

        results_assets.append(
            {
                "symbol": symbol,
                "risk_score": risk_score,
                "risk_flag": risk_flag,
                "size_multiplier_risk_engine": size_mult_risk_engine,
                # % du capital autorisé à risquer sur un trade pour cet asset
                "base_per_trade_risk_pct": per_trade_risk_base,
                "final_per_trade_risk_pct": round(final_risk_pct, 4),
                # % du capital max alloué en notional sur cet asset (exposition totale)
                "max_notional_pct": round(final_max_notional_pct, 4),
                "flags": {
                    "hard_veto": hard_veto,
                    "soft_veto": soft_veto,
                },
                "reasons": reasons,
            }
        )

    avg_final_risk_pct = (total_final_risk_pct / nb_assets) if nb_assets > 0 else 0.0

    overview: Dict[str, Any] = {
        "global_flag": global_flag,
        "config": {
            "per_trade_risk_base_pct": per_trade_risk_base,
            "max_notional_base_pct": max_notional_base,
            "risk_mode_config": RISK_MODE_CONFIG,
            "risk_flag_adjust": RISK_FLAG_ADJUST,
        },
        "stats": {
            "nb_assets": nb_assets,
            "avg_final_per_trade_risk_pct": round(avg_final_risk_pct, 4),
            "nb_hard_veto": nb_hard_veto,
            "nb_soft_veto": nb_soft_veto,
        },
        "assets": results_assets,
    }

    return overview


def main() -> None:
    data_dir = _get_data_dir()

    risk_engine = _load_risk_engine(data_dir)
    risk_console = _load_risk_console(data_dir)

    result = compute_position_sizing(risk_engine, risk_console)

    out_path = data_dir / "analysis" / "position_sizing_institutional.json"
    save_json_file(str(out_path), result)
    logger.info(
        "[position_sizing_institutional] position_sizing_institutional.json sauvegardé (%s, assets=%d, global_flag=%s)",
        out_path,
        result["stats"]["nb_assets"],
        result["global_flag"],
    )


if __name__ == "__main__":
    main()

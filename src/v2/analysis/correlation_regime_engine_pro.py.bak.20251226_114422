@dataclass
class CorrelationMetrics:
    nb_pairs: int
    avg_abs_corr: Optional[float]
    avg_pos_corr: Optional[float]
    avg_neg_corr: Optional[float]
    share_high_corr: float
    share_strong_neg: float


def _safe_append(values: List[float], value: Any) -> None:
    """Ajoute une valeur numérique à une liste si elle est valide."""
    try:
        v = float(value)
    except (TypeError, ValueError):
        return

    if math.isnan(v):
        return

    # Corrélation bornée dans [-1, 1]
    v = max(-1.0, min(1.0, v))
    values.append(v)


def compute_correlation_metrics(matrix: Dict[str, Dict[str, Any]]) -> CorrelationMetrics:
    """
    Calcule quelques métriques globales à partir d'une matrice de corrélation.

    matrix est supposée être du type :
    {
        "BTC": {"ETH": 0.8, "SOL": 0.6},
        "ETH": {"BTC": 0.8, "SOL": 0.5},
        ...
    }
    On ne compte chaque paire qu'une seule fois.
    """
    assets = sorted(matrix.keys())
    vals: List[float] = []
    pos_vals: List[float] = []
    neg_vals: List[float] = []

    nb_high_corr = 0       # |corr| >= 0.7
    nb_strong_neg = 0      # corr <= -0.5
    nb_pairs = 0

    for i, a in enumerate(assets):
        row = matrix.get(a, {})
        for b in assets[i + 1 :]:
            tmp: List[float] = []
            corr_raw = row.get(b)
            _safe_append(tmp, corr_raw)

            if not tmp:
                corr_raw = matrix.get(b, {}).get(a)
                _safe_append(tmp, corr_raw)

            if not tmp:
                continue

            corr = tmp[0]
            nb_pairs += 1
            vals.append(abs(corr))
            if corr >= 0:
                pos_vals.append(corr)
            else:
                neg_vals.append(corr)

            if abs(corr) >= 0.7:
                nb_high_corr += 1
            if corr <= -0.5:
                nb_strong_neg += 1

    if nb_pairs == 0:
        return CorrelationMetrics(
            nb_pairs=0,
            avg_abs_corr=None,
            avg_pos_corr=None,
            avg_neg_corr=None,
            share_high_corr=0.0,
            share_strong_neg=0.0,
        )

    def _avg(xs: List[float]) -> Optional[float]:
        return sum(xs) / len(xs) if xs else None

    return CorrelationMetrics(
        nb_pairs=nb_pairs,
        avg_abs_corr=_avg(vals),
        avg_pos_corr=_avg(pos_vals),
        avg_neg_corr=_avg(neg_vals),
        share_high_corr=nb_high_corr / nb_pairs if nb_pairs > 0 else 0.0,
        share_strong_neg=nb_strong_neg / nb_pairs if nb_pairs > 0 else 0.0,
    )


def infer_regime_and_score(metrics: CorrelationMetrics) -> Tuple[str, str, float, List[str]]:
    """
    Déduit un régime global + flag de risque + score simple à partir des métriques.
    Retourne (regime, global_flag, score, reasons)
    """
    reasons: List[str] = []

    if metrics.nb_pairs == 0 or metrics.avg_abs_corr is None:
        reasons.append("Aucune donnée de corrélation exploitable – score neutre.")
        return "unknown", "caution", 50.0, reasons

    avg_abs = metrics.avg_abs_corr
    share_high = metrics.share_high_corr
    share_strong_neg = metrics.share_strong_neg

    if avg_abs >= 0.8 and share_high >= 0.6:
        regime = "panic"
        global_flag = "risk_off"
        score = 20.0
        reasons.append(
            f"Corrélation moyenne très élevée (|corr|≈{avg_abs:.2f}), "
            f"{share_high*100:.0f}% des paires en corrélation forte."
        )
    elif avg_abs >= 0.6:
        regime = "high_corr"
        global_flag = "caution"
        score = 35.0
        reasons.append(
            f"Corrélation moyenne élevée (|corr|≈{avg_abs:.2f}), "
            f"{share_high*100:.0f}% des paires en corrélation forte."
        )
    elif avg_abs >= 0.35:
        regime = "normal"
        global_flag = "neutral"
        score = 55.0
        reasons.append(
            f"Corrélations modérées (|corr|≈{avg_abs:.2f}), "
            f"{share_high*100:.0f}% de corrélations fortes."
        )
    else:
        regime = "diversified"
        global_flag = "risk_on"
        score = 70.0
        reasons.append(
            f"Corrélations globalement faibles (|corr|≈{avg_abs:.2f}), "
            f"{share_high*100:.0f}% de corrélations fortes."
        )

    if share_strong_neg > 0.2:
        reasons.append(
            f"Part importante de corrélations fortement négatives "
            f"({share_strong_neg*100:.0f}% des paires ≤ -0.5)."
        )

    return regime, global_flag, score, reasons


def severity_from_flag(global_flag: str) -> str:
    """Map simple flag → sévérité d'event."""
    if global_flag == "risk_off":
        return "critical"
    if global_flag == "caution":
        return "warning"
    return "info"

def _nsc_build_corr_matrix_from_ohlcv(data_dir: Path, lookback: int = 120) -> dict:
    """
    Build a simple correlation matrix from market/ohlcv_combined.json (fallback).
    Expected format: { "bitcoin":[{...,"close":x},...], "ethereum":[...], ... }
    Returns matrix: {symA:{symB:corr,...}, ...}
    """
    from src.v2.utils.file_utils import load_json_file

    ohlcv_path = data_dir / "market" / "ohlcv_combined.json"
    raw = load_json_file(str(ohlcv_path), default={}) or {}
    if not isinstance(raw, dict) or not raw:
        return {}

    # Extract close series per symbol
    series = {}
    for sym, rows in raw.items():
        if not isinstance(rows, list) or not rows:
            continue
        closes = []
        for r in rows[-lookback:]:
            if isinstance(r, dict):
                c = r.get("close")
            else:
                c = None
            try:
                c = float(c)
            except Exception:
                continue
            closes.append(c)
        if len(closes) >= 10:
            series[str(sym).lower()] = closes

    syms = sorted(series.keys())
    if len(syms) < 2:
        return {}

    def corr(a, b):
        n = min(len(a), len(b))
        a = a[-n:]; b = b[-n:]
        ma = sum(a)/n; mb = sum(b)/n
        va = sum((x-ma)**2 for x in a)
        vb = sum((y-mb)**2 for y in b)
        if va <= 0 or vb <= 0:
            return 0.0
        cov = sum((a[i]-ma)*(b[i]-mb) for i in range(n))
        return max(-1.0, min(1.0, cov / ((va**0.5)*(vb**0.5))))

    matrix = {a:{} for a in syms}
    for i, a in enumerate(syms):
        for j, b in enumerate(syms):
            if a == b:
                continue
            matrix[a][b] = round(float(corr(series[a], series[b])), 6)
    return matrix



def _nsc_ensure_asset_correlations_file(data_dir: Path) -> dict:
    """
    Ensure data/analysis/asset_correlations.json exists.
    If missing, build correlation matrix from data/market/ohlcv_combined.json (fallback),
    write the file, and return the raw object (dict).
    """
    try:
        from src.v2.utils.file_utils import load_json_file, save_json_file
        import datetime as dt
    # Ensure correlations file exists (fallback from ohlcv_combined.json if needed)
    raw = _nsc_ensure_asset_correlations_file(data_dir)
if isinstance(raw, dict) and raw:
            return raw

        # Fallback: compute from ohlcv_combined.json
        ohlcv_path = data_dir / "market" / "ohlcv_combined.json"
        ohlcv = load_json_file(ohlcv_path, default={}) or {}
        if not isinstance(ohlcv, dict) or not ohlcv:
            return {}

        def _closes(series):
            # Accept:
            # - list[dict] with close keys
            # - list[list/tuple] with close at index 4 (OHLCV)
            # - dict with one of keys: data/candles/ohlcv/values -> list
            if isinstance(series, dict):
                for kk in ("candles", "data", "ohlcv", "values", "rows"):
                    if kk in series:
                        series = series.get(kk)
                        break

            if not isinstance(series, list):
                return []

            out = []
            for row in series:
                # list/tuple OHLCV => close at index 4
                if isinstance(row, (list, tuple)) and len(row) >= 5:
                    try:
                        out.append(float(row[4]))
                    except Exception:
                        pass
                    continue

                # dict row => close in common keys
                if isinstance(row, dict):
                    for k in ("close", "c", "Close", "C"):
                        if k in row and row[k] is not None:
                            try:
                                out.append(float(row[k]))
                            except Exception:
                                pass
                            break
                    continue

                # raw numeric
                if isinstance(row, (int, float)):
                    out.append(float(row))

            return out
        assets = {str(k): _closes(v) for k, v in ohlcv.items()}
        assets = {k: v for k, v in assets.items() if len(v) >= 10}

        keys = sorted(assets.keys())
        if len(keys) < 2:
            return {}

        lookback = 120
        # Align by last N points (best-effort)
        aligned = {}
        min_len = min(len(assets[k]) for k in keys)
        n = min(lookback, min_len)
        for k in keys:
            aligned[k] = assets[k][-n:]

        def corr(x, y):
            n = len(x)
            if n < 3:
                return 0.0
            mx = sum(x) / n
            my = sum(y) / n
            sx = sum((a - mx) ** 2 for a in x) ** 0.5
            sy = sum((b - my) ** 2 for b in y) ** 0.5
            if sx == 0 or sy == 0:
                return 0.0
            cov = sum((x[i] - mx) * (y[i] - my) for i in range(n))
            return cov / (sx * sy)

        matrix = {a: {} for a in keys}
        for i, a in enumerate(keys):
            matrix[a][a] = 1.0
            for j in range(i + 1, len(keys)):
                b = keys[j]
                c = float(corr(aligned[a], aligned[b]))
                # clamp
                if c > 1.0: c = 1.0
                if c < -1.0: c = -1.0
                matrix[a][b] = c
                matrix[b][a] = c

        now_ts = dt.datetime.utcnow().replace(microsecond=0).isoformat() + "Z"
        out = {"timestamp": now_ts, "source": "correlation_regime_engine_pro:fallback_ohlcv", "matrix": matrix}

@dataclass
class PriceActionFeatures:
    symbol: str
    timestamp: str

    cycle_phase: str
    cycle_phase_score: float

    clean_breakout_score: float
    has_clean_breakout: bool

    fvg_score: float
    has_fvg: bool

    liquidity_risk_score: float
    avoid_liquidity_pool: bool

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def _safe_float(x: Any, default: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return default


def _safe_list(data: Any) -> List[Dict[str, Any]]:
    if isinstance(data, list):
        return data
    return []


def _extract_close_series(candles: List[Dict[str, Any]]) -> List[float]:
    closes: List[float] = []
    for c in candles:
        closes.append(_safe_float(c.get("close") or c.get("c"), 0.0))
    return closes


def _extract_high_series(candles: List[Dict[str, Any]]) -> List[float]:
    highs: List[float] = []
    for c in candles:
        highs.append(_safe_float(c.get("high") or c.get("h"), 0.0))
    return highs


def _extract_low_series(candles: List[Dict[str, Any]]) -> List[float]:
    lows: List[float] = []
    for c in candles:
        lows.append(_safe_float(c.get("low") or c.get("l"), 0.0))
    return lows


def _extract_volume_series(candles: List[Dict[str, Any]]) -> List[float]:
    vols: List[float] = []
    for c in candles:
        vols.append(_safe_float(c.get("volume") or c.get("v"), 0.0))
    return vols


def _rolling_mean(xs: List[float], window: int) -> List[float]:
    if window <= 0 or not xs:
        return [0.0] * len(xs)
    res: List[float] = []
    acc = 0.0
    n = len(xs)
    for i in range(n):
        acc += xs[i]
        if i >= window:
            acc -= xs[i - window]
        if i + 1 < window:
            res.append(xs[i])  # période de chauffe
        else:
            res.append(acc / window)
    return res


def _pct_change(xs: List[float], lag: int) -> List[float]:
    n = len(xs)
    if n == 0 or lag <= 0:
        return [0.0] * n
    res: List[float] = []
    for i in range(n):
        if i < lag:
            res.append(0.0)
        else:
            prev = xs[i - lag]
            cur = xs[i]
            if prev != 0:
                res.append((cur - prev) / prev)
            else:
                res.append(0.0)
    return res


# ---------------------------------------------------------------------------
# Core heuristics : Cycle phase, Breakout, FVG, Liquidity
# ---------------------------------------------------------------------------

def _compute_cycle_phase(
    closes: List[float], lookback: int = 60
) -> Tuple[str, float]:
    """
    Heuristique Wyckoff compressée :
      - compute trend recent (ret_lookback)
      - compute position dans range [low, high] sur lookback
      - classify accumulation / markup / distribution / markdown
    """
    n = len(closes)
    if n < 10:
        return "unknown", 0.0

    lb = min(lookback, n - 1)
    window = closes[-lb:]
    cur = window[-1]
    low_w = min(window)
    high_w = max(window)
    if high_w <= 0:
        return "unknown", 0.0

    # tendance sur la fenêtre : du début à la fin
    ret_window = (window[-1] - window[0]) / window[0] if window[0] != 0 else 0.0
    # position relative dans le range
    range_w = high_w - low_w
    pos = (cur - low_w) / range_w if range_w > 0 else 0.5

    # classification simple
    if ret_window > 0.15 and pos > 0.6:
        phase = "markup"
        score = 80.0 + 20.0 * min(max(ret_window / 0.3, 0.0), 1.0)  # cap à 100
    elif ret_window > 0.05 and 0.3 < pos <= 0.6:
        phase = "accumulation"
        score = 60.0
    elif ret_window < -0.15 and pos < 0.4:
        phase = "markdown"
        score = 20.0
    elif abs(ret_window) < 0.05 and 0.4 <= pos <= 0.7:
        phase = "distribution"
        score = 40.0
    else:
        phase = "choppy"
        score = 30.0

    # clamp
    score = max(0.0, min(100.0, score))
    return phase, score


def _compute_clean_breakout(
    closes: List[float],
    highs: List[float],
    lows: List[float],
    vols: List[float],
    breakout_lookback: int = 20,
) -> Tuple[float, bool]:
    """
    Clean Breakout 2.0 :
      - close dernière bougie > max(high[-breakout_lookback:-1])
      - corps dominant (pas une mèche énorme)
      - volume >= 1.3 * moyenne volume
    Score 0–100, bool has_clean_breakout.
    """
    n = len(closes)
    if n < breakout_lookback + 2:
        return 0.0, False

    last_close = closes[-1]
    last_open = closes[-2]  # approximation si open non dispo
    last_high = highs[-1]
    last_low = lows[-1]

    range_hi = max(highs[-breakout_lookback:-1])
    breakout = last_close > range_hi

    # corp vs range
    candle_range = max(last_high - last_low, 1e-9)
    candle_body = abs(last_close - last_open)
    body_ratio = candle_body / candle_range

    # volume
    vol_mean = sum(vols[-breakout_lookback:]) / max(
        breakout_lookback, 1
    ) if vols else 0.0
    last_vol = vols[-1] if vols else 0.0
    vol_ratio = last_vol / vol_mean if vol_mean > 0 else 1.0

    score = 0.0
    if breakout:
        score += 40.0
    if body_ratio >= 0.5:
        score += 30.0
    if vol_ratio >= 1.3:
        score += 30.0

    score = max(0.0, min(100.0, score))
    has_breakout = score >= 60.0

    return score, has_breakout


def _compute_fvg(
    highs: List[float],
    lows: List[float],
    window: int = 10,
) -> Tuple[float, bool]:
    """
    Détection basique de Fair Value Gaps (FVG) sur les N dernières bougies.
    Heuristique SMC :
      - Bullish FVG : low[i] > high[i-2]
      - Bearish FVG : high[i] < low[i-2]
    """
    n = len(highs)
    if n < 3:
        return 0.0, False

    start = max(2, n - window)
    nb_fvg = 0
    total_gap = 0.0

    for i in range(start, n):
        h2 = highs[i - 2]
        l2 = lows[i - 2]
        h = highs[i]
        l = lows[i]

        # bullish
        if l > h2:
            nb_fvg += 1
            total_gap += (l - h2)
        # bearish
        if h < l2:
            nb_fvg += 1
            total_gap += (l2 - h)

    if nb_fvg == 0:
        return 0.0, False

    # Score basé sur nb_fvg et taille moyenne relative
    avg_gap = total_gap / nb_fvg
    # normalisation très simple
    score = min(100.0, 20.0 * nb_fvg + 80.0 * min(avg_gap, 0.05) / 0.05)
    has_fvg = score >= 40.0

    return score, has_fvg


def _compute_liquidity_risk(
    closes: List[float],
    highs: List[float],
    lows: List[float],
    lookback_swings: int = 30,
) -> Tuple[float, bool]:
    """
    Liquidity Pool Awareness :
      - On repère quelques swing-highs/swing-lows récents.
      - Si le prix actuel est très proche d'un de ces niveaux → zone de chasse de stops.
      - Score élevé = risque élevé.
    """
    n = len(closes)
    if n < 5:
        return 0.0, False

    lb = min(lookback_swings, n - 1)
    start = n - lb

    swing_levels: List[float] = []
    # swing high / low simples (H[i] > H[i-1] & H[i] > H[i+1], etc.)
    for i in range(start + 1, n - 1):
        h_prev, h, h_next = highs[i - 1], highs[i], highs[i + 1]
        l_prev, l, l_next = lows[i - 1], lows[i], lows[i + 1]

        if h > h_prev and h > h_next:
            swing_levels.append(h)
        if l < l_prev and l < l_next:
            swing_levels.append(l)

    if not swing_levels:
        return 0.0, False

    cur = closes[-1]
    # distance relative au niveau swing le plus proche
    min_dist = min(abs(cur - lvl) / max(cur, 1e-9) for lvl in swing_levels)

    # si on est très proche (<0.5%) → risque max
    if min_dist <= 0.005:
        score = 90.0
    elif min_dist <= 0.01:
        score = 70.0
    elif min_dist <= 0.02:
        score = 50.0
    else:
        score = 20.0

    avoid = score >= 70.0
    return score, avoid


# ---------------------------------------------------------------------------
# Core pipeline
# ---------------------------------------------------------------------------

def compute_price_action_for_symbol(
    symbol: str,
    candles: List[Dict[str, Any]],
) -> Optional[PriceActionFeatures]:
    candles_list = _safe_list(candles)
    if len(candles_list) < 10:
        logger.warning(
            "[price_action_engine] Trop peu de données pour %s (len=%d)",
            symbol,
            len(candles_list),
        )
        return None

    closes = _extract_close_series(candles_list)
    highs = _extract_high_series(candles_list)
    lows = _extract_low_series(candles_list)
    vols = _extract_volume_series(candles_list)

    cycle_phase, cycle_score = _compute_cycle_phase(closes)
    breakout_score, has_breakout = _compute_clean_breakout(
        closes, highs, lows, vols
    )
    fvg_score, has_fvg = _compute_fvg(highs, lows)
    liq_score, avoid_liq = _compute_liquidity_risk(
        closes, highs, lows
    )

    now = datetime.now(timezone.utc).isoformat()

    return PriceActionFeatures(
        symbol=symbol,
        timestamp=now,
        cycle_phase=cycle_phase,
        cycle_phase_score=cycle_score,
        clean_breakout_score=breakout_score,
        has_clean_breakout=has_breakout,
        fvg_score=fvg_score,
        has_fvg=has_fvg,
        liquidity_risk_score=liq_score,
        avoid_liquidity_pool=avoid_liq,
    )


def compute_price_action_features() -> List[PriceActionFeatures]:
    data = _load_json(OHLCV_FILE, default={})
    if not isinstance(data, dict) or not data:
        logger.warning(
            "[price_action_engine] Aucune donnée OHLCV trouvée dans %s.",
            OHLCV_FILE,
        )
        return []

    features: List[PriceActionFeatures] = []
    for symbol, candles in data.items():
        feat = compute_price_action_for_symbol(symbol, candles)
        if feat is not None:
            features.append(feat)

    logger.info(
        "[price_action_engine] Price action calculé pour %d assets.",
        len(features),
    )
    return features


def save_price_action_features(features: List[PriceActionFeatures]) -> None:
    payload = [f.to_dict() for f in features]
    _save_json(OUTPUT_FILE, payload)
    logger.info(
        "[price_action_engine] Features sauvegardées dans %s (n=%d).",
        OUTPUT_FILE,
        len(payload),
    )


def load_price_action_features() -> List[Dict[str, Any]]:
    """
    Utilitaire pour les autres modules (momentum_scoring, signal_voting, API).
    """
    data = _load_json(OUTPUT_FILE, default=[])
    if not isinstance(data, list):
        return []
    return data



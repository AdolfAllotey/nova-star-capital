def compute_fvg_overview() -> Dict[str, FVGResult]:
    ohlcv = _load_json(OHLCV_FILE, default={})
    if not isinstance(ohlcv, dict) or not ohlcv:
        logger.warning(
            "[fvg_detector_light] Aucun OHLCV trouvé dans %s.",
            OHLCV_FILE,
        )
        return {}

    results: Dict[str, FVGResult] = {}
    for symbol, series in ohlcv.items():
        candles = _normalize_ohlcv_series(series)
        if not candles:
            continue
        try:
            res = _compute_fvg_score_for_asset(symbol, candles)
        except Exception:
            logger.exception(
                "[fvg_detector_light] Erreur lors du calcul FVG pour %s",
                symbol,
            )
            res = None

        if res is not None:
            results[symbol] = res

    logger.info(
        "[fvg_detector_light] FVG calculé pour %d assets.",
        len(results),
    )
    return results


def save_fvg_overview(results: Dict[str, FVGResult]) -> None:
    payload = {sym: res.to_dict() for sym, res in results.items()}
    _save_json(OUTPUT_FILE, payload)
    logger.info(
        "[fvg_detector_light] Résultats FVG sauvegardés dans %s.",
        OUTPUT_FILE,
    )


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> None:
    results = compute_fvg_overview()
    if not results:
        logger.warning(
            "[fvg_detector_light] Aucun FVG significatif détecté."
        )
    save_fvg_overview(results)


if __name__ == "__main__":
    main()

@dataclass
class CleanBreakoutResult:
    symbol: str
    timestamp: str
    score: float
    has_clean_breakout: bool
    components: Dict[str, Any]
    tags: List[str]

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def _safe_float(x: Any, default: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return default


def _normalize_ohlcv_series(asset_data: Any) -> List[Dict[str, Any]]:
    """
    Accepte différents formats possibles (liste brute ou dict {candles: [...]})
    et renvoie une liste triée par timestamp croissant.
    """
    series: List[Dict[str, Any]] = []

    if isinstance(asset_data, list):
        series = [c for c in asset_data if isinstance(c, dict)]
    elif isinstance(asset_data, dict):
        candles = asset_data.get("candles") or asset_data.get("data") or asset_data.get("ohlcv")
        if isinstance(candles, list):
            series = [c for c in candles if isinstance(c, dict)]

    def _parse_ts(c: Dict[str, Any]) -> float:
        ts = c.get("timestamp") or c.get("time") or c.get("t")
        if isinstance(ts, (int, float)):
            return float(ts)
        if isinstance(ts, str):
            # tenter ISO 8601
            try:
                from datetime import datetime

                return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
            except Exception:
                return 0.0
        return 0.0

    series.sort(key=_parse_ts)
    return series


def _moving_average(values: List[float], window: int) -> Optional[float]:
    if len(values) < window or window <= 0:
        return None
    return sum(values[-window:]) / float(window)


def _stddev(values: List[float], window: int) -> Optional[float]:
    if len(values) < window or window <= 1:
        return None
    slice_vals = values[-window:]
    m = sum(slice_vals) / len(slice_vals)
    var = sum((v - m) ** 2 for v in slice_vals) / (len(slice_vals) - 1)
    return math.sqrt(max(var, 0.0))


# ---------------------------------------------------------------------------
# Core logic Clean Breakout 2.0 (approximé)
# ---------------------------------------------------------------------------

def _compute_clean_breakout_for_asset(
    symbol: str,
    candles: List[Dict[str, Any]],
) -> Optional[CleanBreakoutResult]:
    """
    Logique Clean Breakout 2.0 "light", mais riche :

    - Fenêtre "H4" approximée : candles[-80:] (breakout_level)
    - Fenêtre "M30" approximée : candles[-24:] (validation locale)
    - Volume spike : vol_last > 1.5 * mean(vol[-40:])
    - Trend filter : close_last > MA20
    - Consolidation : range (max-min) sur avant-breakout < 4–6% du niveau
    - Distance : prix pas à plus de +10/12 % au-dessus du niveau
    """

    N_MIN = 60  # minimum de candles pour être sérieux
    if len(candles) < N_MIN:
        logger.debug(
            "[clean_breakout_light] %s: pas assez de candles (%d < %d), skip.",
            symbol,
            len(candles),
            N_MIN,
        )
        return None

    closes: List[float] = []
    highs: List[float] = []
    lows: List[float] = []
    volumes: List[float] = []

    for c in candles:
        closes.append(_safe_float(c.get("close") or c.get("c")))
        highs.append(_safe_float(c.get("high") or c.get("h")))
        lows.append(_safe_float(c.get("low") or c.get("l")))
        volumes.append(_safe_float(c.get("volume") or c.get("v")))

    last_close = closes[-1]
    last_high = highs[-1]
    last_low = lows[-1]
    last_volume = volumes[-1]

    # --- Fenêtres "multi-TF" approximées ---
    # H4-like: sur la partie longue (80 dernières bougies)
    # M30-like: partie plus courte (24 dernières bougies)
    N_H4 = min(80, len(candles))
    N_M30 = min(24, len(candles))

    h4_slice = highs[-N_H4:]
    m30_slice = closes[-N_M30:]

    # Niveau de breakout: plus haut H4 avant les 3-4 dernières bougies
    if len(h4_slice) < 10:
        return None

    # On garde les N_H4-4 premières pour "avant breakout"
    h4_pre = h4_slice[:-4] if len(h4_slice) > 4 else h4_slice
    breakout_level = max(h4_pre)

    # --- Conditions principales ---

    # 1) Prix actuel au-dessus du niveau (avec petite marge)
    distance_from_level_pct = (
        (last_close - breakout_level) / breakout_level * 100.0
        if breakout_level > 0
        else 0.0
    )
    is_above_level = distance_from_level_pct > 0.3  # au moins +0.3%

    # 2) Volume spike vs moyenne
    N_VOL = min(40, len(volumes))
    avg_vol = sum(volumes[-N_VOL:]) / N_VOL if N_VOL > 0 else 0.0
    volume_spike_ratio = (last_volume / avg_vol) if avg_vol > 0 else 1.0
    has_volume_spike = volume_spike_ratio >= 1.5

    # 3) Trend filter : close > MA20
    ma20 = _moving_average(closes, 20)
    trend_score = 0.0
    if ma20 is not None and ma20 > 0:
        if last_close > ma20:
            # plus on est au-dessus, plus le score monte, plafonné
            dist_ma20 = (last_close - ma20) / ma20 * 100.0
            trend_score = max(0.0, min(30.0, dist_ma20 * 1.5))
        else:
            # sous la MA20 -> pénalité
            trend_score = 0.0
    else:
        ma20 = None

    # 4) Consolidation avant le breakout
    #    On regarde la range sur une fenêtre avant les 10 dernières bougies
    N_CONS = min(40, len(candles))
    if N_CONS + 10 < len(candles):
        cons_slice = candles[-(N_CONS + 10):-10]
    else:
        cons_slice = candles[:-10]

    cons_highs = [ _safe_float(c.get("high") or c.get("h")) for c in cons_slice ]
    cons_lows = [ _safe_float(c.get("low") or c.get("l")) for c in cons_slice ]

    cons_range = (max(cons_highs) - min(cons_lows)) if cons_highs and cons_lows else 0.0
    cons_range_pct = (
        cons_range / breakout_level * 100.0 if breakout_level > 0 else 0.0
    )

    # Idée : plus la range est contenue (<6-8%), plus le score de consolidation est haut.
    if cons_range_pct <= 4.0:
        consolidation_score = 30.0
    elif cons_range_pct <= 8.0:
        consolidation_score = 20.0
    elif cons_range_pct <= 12.0:
        consolidation_score = 10.0
    else:
        consolidation_score = 0.0

    # 5) Structure locale (M30-like): on veut une séquence de closes ascendante
    #    sur les 5 dernières bougies
    last_k = min(5, len(m30_slice))
    structure_score = 0.0
    if last_k >= 3:
        recent = m30_slice[-last_k:]
        # Si les closes sont globalement en tendance haussière
        up_moves = sum(
            1 for i in range(1, len(recent)) if recent[i] > recent[i - 1]
        )
        structure_ratio = up_moves / (len(recent) - 1)
        structure_score = structure_ratio * 20.0  # max 20

    # 6) Extension : éviter d'acheter un top si déjà +12% au-dessus du niveau
    extension_penalty = 0.0
    if distance_from_level_pct > 12.0:
        extension_penalty = min(25.0, (distance_from_level_pct - 12.0) * 1.5)

    # 7) Score volume
    #    0 si ratio <1.0, 10 si 1–1.5, 25 si >2.5
    if volume_spike_ratio <= 1.0:
        volume_score = 0.0
    elif volume_spike_ratio >= 2.5:
        volume_score = 25.0
    else:
        # linéaire entre 1.0 et 2.5
        volume_score = (volume_spike_ratio - 1.0) / (2.5 - 1.0) * 25.0

    # 8) Score distance
    #    Idée : idéal entre +1% et +7%. On note 0 si en-dessous, 0 si au-dessus de 15%.
    if distance_from_level_pct <= 0.0:
        distance_score = 0.0
    elif distance_from_level_pct <= 1.0:
        distance_score = 5.0
    elif distance_from_level_pct <= 7.0:
        distance_score = 15.0
    elif distance_from_level_pct <= 12.0:
        distance_score = 8.0
    else:
        distance_score = 0.0

    # Score global
    score_raw = (
        trend_score
        + consolidation_score
        + structure_score
        + volume_score
        + distance_score
        - extension_penalty
    )
    score = max(0.0, min(100.0, score_raw))

    # Condition "has_clean_breakout" : score >= 60 et au-dessus du niveau
    has_clean = score >= 60.0 and is_above_level and has_volume_spike

    tags: List[str] = []
    if has_clean:
        tags.append("clean_breakout")
    if has_volume_spike:
        tags.append("volume_spike")
    if distance_from_level_pct > 10.0:
        tags.append("extended")

    res = CleanBreakoutResult(
        symbol=symbol,
        timestamp=datetime.now(timezone.utc).isoformat(),
        score=round(score, 2),
        has_clean_breakout=has_clean,
        components={
            "breakout_level": breakout_level,
            "last_close": last_close,
            "last_high": last_high,
            "last_low": last_low,
            "distance_from_level_pct": distance_from_level_pct,
            "volume_spike_ratio": volume_spike_ratio,
            "trend_score": trend_score,
            "consolidation_score": consolidation_score,
            "structure_score": structure_score,
            "extension_penalty": extension_penalty,
            "ma20": ma20,
        },
        tags=tags,
    )
    return res


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def compute_clean_breakouts() -> Dict[str, CleanBreakoutResult]:
    ohlcv = _load_json(OHLCV_FILE, default={})
    if not isinstance(ohlcv, dict) or not ohlcv:
        logger.warning(
            "[clean_breakout_light] Aucun OHLCV trouvé dans %s.",
            OHLCV_FILE,
        )
        return {}

    results: Dict[str, CleanBreakoutResult] = {}
    for symbol, series in ohlcv.items():
        candles = _normalize_ohlcv_series(series)
        if not candles:
            continue
        try:
            res = _compute_clean_breakout_for_asset(symbol, candles)
        except Exception:
            logger.exception(
                "[clean_breakout_light] Erreur lors du calcul du breakout pour %s",
                symbol,
            )
            res = None

        if res is not None:
            results[symbol] = res

    logger.info(
        "[clean_breakout_light] Clean breakout calculé pour %d assets.",
        len(results),
    )
    return results


def save_clean_breakouts(results: Dict[str, CleanBreakoutResult]) -> None:
    payload = {
        sym: res.to_dict() for sym, res in results.items()
    }
    _save_json(OUTPUT_FILE, payload)
    logger.info(
        "[clean_breakout_light] Résultats sauvegardés dans %s.",
        OUTPUT_FILE,
    )


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> None:
    results = compute_clean_breakouts()
    if not results:
        logger.warning(
            "[clean_breakout_light] Aucun breakout propre détecté."
        )
    save_clean_breakouts(results)


if __name__ == "__main__":
    main()

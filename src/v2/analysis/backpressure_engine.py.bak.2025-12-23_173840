import os
from datetime import datetime, timezone

from src.v2.utils.logger import get_logger
from src.v2.utils.file_utils import get_data_dir, load_json_file, save_json_file

logger = get_logger(__name__)

DATA_DIR = get_data_dir()

SYSTEM_METRICS_FILE = os.path.join(DATA_DIR, "telemetry", "system_metrics.json")
LOGS_OVERVIEW_FILE = os.path.join(DATA_DIR, "analysis", "logs_overview_light.json")
PORTFOLIO_FILE = os.path.join(DATA_DIR, "analysis", "portfolio_engine_pro.json")
GOVERNANCE_FILE = os.path.join(DATA_DIR, "analysis", "governance_engine_pro.json")
KILL_SWITCH_FILE = os.path.join(DATA_DIR, "trading", "kill_switch.json")
ORCHESTRATOR_STATE_FILE = os.path.join(DATA_DIR, "telemetry", "orchestrator_state.json")


def _normalize_metrics(raw: dict) -> dict:
    """
    system_metrics.json peut être soit:
    - un objet directement,
    - soit { "summary": { ... } }.
    On normalise.
    """
    if not isinstance(raw, dict):
        return {}

    if "summary" in raw and isinstance(raw["summary"], dict):
        return raw["summary"]

    return raw


def compute_backpressure(
    metrics: dict,
    logs_overview: dict,
    portfolio: dict,
    governance: dict,
    kill_switch: dict,
) -> tuple[str, str, list[str], dict]:
    """
    Retourne:
    - backpressure_flag: "ok" | "caution" | "block"
    - level: "none" | "mild" | "moderate" | "severe"
    - reasons: liste de raisons textuelles
    - stats: petit résumé numérique pour debug
    """
    reasons: list[str] = []
    score = 0          # nb de signaux de pression
    severity = 0       # 0 = none, 1 = mild, 2 = moderate, 3 = severe

    # --- 1) System metrics -----------------------------------------
    m = _normalize_metrics(metrics)

    total_duration = float(m.get("total_duration_sec", 0.0) or 0.0)
    nb_steps_error = int(m.get("nb_steps_error", 0) or 0)
    nb_signals_sized = int(m.get("nb_signals_sized", 0) or 0)
    nb_exec_attempts = int(m.get("nb_execution_attempts", 0) or 0)
    nb_fills = int(m.get("nb_fills", 0) or 0)
    nb_open_positions = int(m.get("nb_open_positions", 0) or 0)
    risk_size_factor = m.get("risk_size_factor", None)

    # Seuils (pour préprod, on reste assez tolérant)
    DURATION_WARN = 2.0
    DURATION_BLOCK = 5.0

    if total_duration > DURATION_WARN:
        score += 1
        reasons.append(f"boucle lente: {total_duration:.2f}s (> {DURATION_WARN:.1f}s)")
        if total_duration > DURATION_BLOCK:
            severity = max(severity, 2)  # moderate

    if nb_steps_error > 0:
        score += 1
        reasons.append(f"{nb_steps_error} étape(s) en erreur dans system_metrics")
        if nb_steps_error > 1:
            severity = max(severity, 2)

    # Charge de signaux / positions
    SIGNALS_WARN = 100
    SIGNALS_BLOCK = 300
    POSITIONS_WARN = 30
    POSITIONS_BLOCK = 60

    if nb_signals_sized > SIGNALS_WARN:
        score += 1
        reasons.append(
            f"beaucoup de signaux sizés: {nb_signals_sized} (> {SIGNALS_WARN})"
        )
        if nb_signals_sized > SIGNALS_BLOCK:
            severity = max(severity, 2)

    if nb_open_positions > POSITIONS_WARN:
        score += 1
        reasons.append(
            f"beaucoup de positions ouvertes: {nb_open_positions} (> {POSITIONS_WARN})"
        )
        if nb_open_positions > POSITIONS_BLOCK:
            severity = max(severity, 2)

    # --- 2) Logs overview ------------------------------------------
    has_errors = bool(logs_overview.get("has_errors", False))
    steps_error_list = logs_overview.get("steps_error", []) or []

    if has_errors or steps_error_list:
        score += 1
        steps_str = ", ".join(steps_error_list) if steps_error_list else "inconnues"
        reasons.append(f"erreurs détectées dans logs_overview_light (steps={steps_str})")
        if len(steps_error_list) >= 2:
            severity = max(severity, 2)

    signals_info = logs_overview.get("signals", {}) or {}
    nb_sized_logs = int(signals_info.get("nb_sized", 0) or 0)
    nb_exec_logs = int(signals_info.get("nb_exec_attempts", 0) or 0)

    # cohérence : si logs indique beaucoup plus que metrics -> suspicion
    if nb_sized_logs > nb_signals_sized * 2 and nb_sized_logs > 0:
        score += 1
        reasons.append(
            f"incohérence nb_sized (logs={nb_sized_logs}, metrics={nb_signals_sized})"
        )
        severity = max(severity, 1)

    # --- 3) Portfolio Engine ---------------------------------------
    portfolio_status = portfolio.get("constraints_status")
    if portfolio_status == "breach":
        score += 1
        reasons.append("breach des contraintes de portefeuille (portfolio_engine_pro)")
        severity = max(severity, 2)

    # --- 4) Governance Engine --------------------------------------
    gov_flag = governance.get("flag")
    gov_score = governance.get("score")

    if gov_flag in {"soft_block", "hard_block"}:
        score += 1
        reasons.append(f"governance flag={gov_flag} (score={gov_score})")
        if gov_flag == "hard_block":
            severity = max(severity, 3)
        else:
            severity = max(severity, 2)

    # --- 5) Kill Switch --------------------------------------------
    ks_status = kill_switch.get("status")
    ks_reason = kill_switch.get("reason")

    if ks_status in {"hard_block", "emergency", "global_off"}:
        score += 2
        reasons.append(f"kill_switch actif: {ks_status} ({ks_reason})")
        severity = max(severity, 3)

    # Taille de position trop réduite → pression implicite
    if isinstance(risk_size_factor, (int, float)) and risk_size_factor < 0.3:
        score += 1
        reasons.append(f"risk_size_factor très réduit: {risk_size_factor}")
        severity = max(severity, 1)

    # --- 6) Synthèse -----------------------------------------------
    if severity >= 3 or score >= 4:
        level = "severe"
        flag = "block"
    elif severity == 2 or score >= 2:
        level = "moderate"
        flag = "caution"
    elif score == 1:
        level = "mild"
        flag = "ok"
    else:
        level = "none"
        flag = "ok"

    stats = {
        "score": score,
        "severity": severity,
        "total_duration_sec": total_duration,
        "nb_steps_error": nb_steps_error,
        "nb_signals_sized": nb_signals_sized,
        "nb_exec_attempts": nb_exec_attempts,
        "nb_fills": nb_fills,
        "nb_open_positions": nb_open_positions,
        "portfolio_constraints_status": portfolio_status,
        "governance_flag": gov_flag,
        "governance_score": gov_score,
        "kill_switch_status": ks_status,
        "risk_size_factor": risk_size_factor,
    }

    return flag, level, reasons, stats


def main() -> None:
    data_dir = get_data_dir()
    logger.info("[backpressure_engine] DATA_DIR=%s", data_dir)

    system_metrics = load_json_file(SYSTEM_METRICS_FILE, default={})
    logs_overview = load_json_file(LOGS_OVERVIEW_FILE, default={})
    portfolio = load_json_file(PORTFOLIO_FILE, default={})
    governance = load_json_file(GOVERNANCE_FILE, default={})
    kill_switch = load_json_file(KILL_SWITCH_FILE, default={})

    flag, level, reasons, stats = compute_backpressure(
        system_metrics, logs_overview, portfolio, governance, kill_switch
    )

    now = datetime.now(timezone.utc).isoformat()

    orchestrator_state = load_json_file(ORCHESTRATOR_STATE_FILE, default={})
    # On ne touche pas au champ "mode" ici, ce sera Orchestrator Pro.
    orchestrator_state.update(
        {
            "backpressure_flag": flag,
            "backpressure_level": level,
            "backpressure_reasons": reasons,
            "backpressure_stats": stats,
            "backpressure_updated_at": now,
        }
    )

    save_json_file(ORCHESTRATOR_STATE_FILE, orchestrator_state)

    logger.info(
        "[backpressure_engine] backpressure_flag=%s, level=%s, reasons=%s",
        flag,
        level,
        "; ".join(reasons) if reasons else "aucune",
    )
    logger.info(
        "[backpressure_engine] orchestrator_state mis à jour (%s)",
        ORCHESTRATOR_STATE_FILE,
    )


if __name__ == "__main__":
    main()

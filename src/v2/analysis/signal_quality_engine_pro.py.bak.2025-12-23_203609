# src/v2/analysis/signal_quality_engine_pro.py
from __future__ import annotations

import os
from datetime import datetime, timezone
from typing import Any, Dict, Tuple

from src.v2.utils.logger import get_logger
from src.v2.utils.file_utils import load_json_file, save_json_file, data_path

logger = get_logger("signal_quality_engine_pro")


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _flag_from_score(score: float) -> str:
    # score 0..100
    if score >= 75:
        return "ok"
    if score >= 55:
        return "neutral"
    if score >= 40:
        return "caution"
    return "hard_block"


def _safe_float(v: Any, default: float = 0.0) -> float:
    try:
        if v is None:
            return default
        return float(v)
    except Exception:
        return default


def _load_component_scores(data_dir: str) -> Tuple[Dict[str, Any], Dict[str, float]]:
    """
    Agrège des signaux de qualité à partir d’artefacts existants.
    Retour:
      raw: dict brut (sources)
      scores: dict scores normalisés 0..100
    """
    raw: Dict[str, Any] = {}

    # sources existantes (best-effort)
    meta = load_json_file(data_path("analysis", "meta_score_engine_pro.json"), default={}) or {}
    mc = load_json_file(data_path("analysis", "market_conditions_engine_pro.json"), default={}) or {}
    risk = load_json_file(data_path("analysis", "risk_engine_pro.json"), default={}) or {}
    backp = load_json_file(data_path("telemetry", "backpressure_state.json"), default={}) or {}
    gov = load_json_file(data_path("analysis", "governance_engine_pro.json"), default={}) or {}
    logs = load_json_file(data_path("analysis", "logs_overview_light.json"), default={}) or {}

    raw["meta_score_engine_pro"] = meta
    raw["market_conditions_engine_pro"] = mc
    raw["risk_engine_pro"] = risk
    raw["backpressure_state"] = backp
    raw["governance_engine_pro"] = gov
    raw["logs_overview_light"] = logs

    # --- extraction scores (0..100)
    meta_score = _safe_float(meta.get("score"), 50.0)
    mc_score = _safe_float(mc.get("score"), 50.0)
    risk_score = _safe_float(risk.get("score"), 50.0)

    # backpressure: normal=100, degraded=60, safe=30, emergency=0
    bp_mode = (backp.get("mode") or "normal").lower()
    bp_score = {"normal": 100.0, "degraded": 60.0, "safe": 30.0, "emergency": 0.0}.get(bp_mode, 60.0)

    # logs: pénalise si erreurs détectées
    steps_error = _safe_float(logs.get("steps_error"), 0.0)
    errors_total = _safe_float(logs.get("errors_total"), 0.0)
    # score logs: 100 - pénalités
    logs_score = max(0.0, 100.0 - (steps_error * 35.0 + errors_total * 5.0))

    # governance: score si présent sinon neutre
    gov_score = _safe_float(gov.get("score"), 65.0)

    scores = {
        "meta_score": meta_score,
        "market_conditions": mc_score,
        "risk_engine": risk_score,
        "backpressure": bp_score,
        "governance": gov_score,
        "logs_health": logs_score,
    }
    return raw, scores


def _compute_signal_quality(scores: Dict[str, float]) -> Tuple[float, str, Dict[str, Any]]:
    """
    Calcule score final et flag à partir des sous-scores.
    """
    # pondérations simples et robustes
    w = {
        "meta_score": 0.22,
        "market_conditions": 0.18,
        "risk_engine": 0.18,
        "backpressure": 0.14,
        "governance": 0.18,
        "logs_health": 0.10,
    }

    # moyenne pondérée
    total = 0.0
    wsum = 0.0
    for k, wk in w.items():
        total += scores.get(k, 50.0) * wk
        wsum += wk
    score = total / max(wsum, 1e-9)

    # hard veto si backpressure emergency ou logs catastrophiques
    reasons = []
    if scores.get("backpressure", 60.0) <= 5.0:
        reasons.append("backpressure=emergency -> hard_block")
        score = min(score, 10.0)
    if scores.get("logs_health", 100.0) < 20.0:
        reasons.append("logs_health<20 -> caution/hard_block")
        score = min(score, 35.0)

    flag = _flag_from_score(score)

    details = {
        "weights": w,
        "reasons": reasons,
    }
    return score, flag, details


def _publish_event(payload: Dict[str, Any], severity: str) -> None:
    """
    Publie un event si le bus est présent (best-effort).
    """
    try:
        # Plusieurs implémentations possibles selon ton codebase
        try:
            from src.v2.monitoring.message_bus import publish_event  # type: ignore
            publish_event(
                event_type="signal.quality.state",
                source="signal_quality_engine_pro",
                severity=severity,
                payload=payload,
            )
            return
        except Exception:
            pass

        try:
            from src.v2.monitoring.event_bus import publish_event  # type: ignore
            publish_event(
                event_type="signal.quality.state",
                source="signal_quality_engine_pro",
                severity=severity,
                payload=payload,
            )
            return
        except Exception:
            pass

        logger.debug("[signal_quality_engine_pro] event bus non dispo (noop)")
    except Exception:
        pass


def main() -> Dict[str, Any]:
    data_dir = os.environ.get("NSC_DATA_DIR") or os.environ.get("DATA_ROOT") or str(data_path().parent)
    logger.info("[signal_quality_engine_pro] DATA_DIR=%s, env=%s", data_dir, os.getenv("ENV", "PREPROD"))

    raw, scores = _load_component_scores(data_dir)
    score, flag, details = _compute_signal_quality(scores)

    out = {
        "timestamp": _utc_now(),
        "env": os.getenv("ENV", "PREPROD"),
        "score": round(score, 2),
        "flag": flag,
        "components": {k: round(v, 2) for k, v in scores.items()},
        "details": details,
        "sources_loaded": {
            "meta_score_engine_pro": bool(raw.get("meta_score_engine_pro")),
            "market_conditions_engine_pro": bool(raw.get("market_conditions_engine_pro")),
            "risk_engine_pro": bool(raw.get("risk_engine_pro")),
            "backpressure_state": bool(raw.get("backpressure_state")),
            "governance_engine_pro": bool(raw.get("governance_engine_pro")),
            "logs_overview_light": bool(raw.get("logs_overview_light")),
        },
    }

    # sauvegarde
    save_json_file(data_path("analysis", "signal_quality_engine_pro.json"), out)

    # event severity
    severity = "info"
    if flag == "caution":
        severity = "warning"
    elif flag == "hard_block":
        severity = "error"

    _publish_event(out, severity=severity)

    logger.info("[signal_quality_engine_pro] OK score=%.2f flag=%s -> %s", score, flag, data_path("analysis", "signal_quality_engine_pro.json"))
    return out


if __name__ == "__main__":
    print(main())

    try:
        # Prefer main(), else run_execution_engine_pro(DATA_DIR)
        if 'main' in globals() and callable(globals().get('main')):
            globals()['main']()
        elif 'run_execution_engine_pro' in globals() and callable(globals().get('run_execution_engine_pro')):
            globals()['run_execution_engine_pro'](DATA_DIR)
        else:
            logger.error('[execution_engine_pro] No entrypoint found (main/run_execution_engine_pro)')
    except SystemExit:
        raise
    except Exception:
        logger.exception('[execution_engine_pro] Crash in entrypoint')
    finally:
        existing = _read_existing_plan(_data_dir)
        if not isinstance(existing, dict):
            existing = {}

        # WRITE_GUARANTEE: ne force un plan blocked QUE si run() n'a pas écrit.
        if not globals().get('_EXEC_PLAN_WROTE', False):
            blocked = {
                'writer': 'execution_engine_pro',
                'status': 'blocked',
                'run_id': existing.get('run_id'),
                'generated_at': _now_utc_iso(),
                'governance': {
                    'source': 'execution_engine_pro',
                    'reasons': ['execution_engine_pro_no_write_guard'],
                    'note': 'WRITE_GUARANTEE: engine exited without writing plan; forcing blocked plan to avoid stale writer'
                },
                'orders': []
            }
            _write_plan_force(_data_dir, blocked)


import os
from datetime import datetime, timezone

REPORT_DIR = "data/v2/reports"
os.makedirs(REPORT_DIR, exist_ok=True)

def generate_html_capital_report(current_balances: dict) -> str:
    today = datetime.now().strftime("%Y-%m-%d")
    total = sum(current_balances.values())
    rows = ""
    for account, value in current_balances.items():
        pct = (value / total) * 100 if total > 0 else 0
        rows += f"<tr><td>{account.capitalize()}</td><td>{value:.2f} €</td><td>{pct:.1f}%</td></tr>"

    html = f"""
    <html>
    <head>
        <style>
            body {{ font-family: Arial, sans-serif; }}
            table {{ border-collapse: collapse; width: 100%; }}
            th, td {{ border: 1px solid #ccc; padding: 8px; text-align: left; }}
            th {{ background-color: #f5f5f5; }}
        </style>
    </head>
    <body>
        <h2>🧾 Rapport Capital - {today}</h2>
        <table>
            <tr><th>Sous-compte</th><th>Montant</th><th>% du total</th></tr>
            {rows}
        </table>
        <p><strong>Total :</strong> {total:.2f} €</p>
    </body>
    </html>
    """
    return html

def save_html_report(content: str) -> str:
    today = datetime.now().strftime("%Y-%m-%d")
    path = os.path.join(REPORT_DIR, f"capital_report_{today}.html")
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    return path

# Exemple local
if __name__ == "__main__":
    balances = {
        "trading": 12500,
        "securite": 4000,
        "impots": 2300,
        "entreprise": 700
    }
    html_report = generate_html_capital_report(balances)
    file_path = save_html_report(html_report)
    print(f"✅ Rapport capital sauvegardé dans : {file_path}")

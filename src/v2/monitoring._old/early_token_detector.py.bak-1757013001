import os
import json
import requests
from datetime import datetime, timezone, timedelta
from src.v2.utils.logger import get_logger

logger = get_logger("early_token_detector")

OUTPUT_PATH = "src/v2/data/risk/early_tokens.json"

DEXTOOLS_API_URL = "https://api.dextools.io/bsc/v1/token/pairs"  # ⚠️ Exemple (non officielle)
MIN_VOLUME_USD = 10000
MAX_AGE_DAYS = 7


def fetch_tokens_from_dextools():
    try:
        # ⚠️ À adapter selon API réelle (Moralis, DexTools Pro ou CoinGecko API)
        response = requests.get(DEXTOOLS_API_URL)
        response.raise_for_status()
        data = response.json()
        return data.get("pairs", [])
    except Exception as e:
        logger.warning(f"Échec API DEX: {e}")
        return []


def is_recent_token(created_at_str):
    try:
        created_at = datetime.fromisoformat(created_at_str)
        return (datetime.now(timezone.utc) - created_at).days <= MAX_AGE_DAYS
    except:
        return False


def process_tokens(pairs: list):
    results = []

    for pair in pairs:
        symbol = pair.get("baseToken", {}).get("symbol")
        created_at = pair.get("createdAt", "")
        volume_usd = float(pair.get("volumeUSD", 0))

        if not symbol or not created_at:
            continue

        age_days = (datetime.now(timezone.utc) - datetime.fromisoformat(created_at)).days
        is_flagged = age_days <= MAX_AGE_DAYS and volume_usd >= MIN_VOLUME_USD

        results.append({
            "symbol": symbol,
            "age_days": age_days,
            "volume_24h": round(volume_usd, 2),
            "is_flagged": is_flagged
        })

    return results


def run_early_token_detection():
    logger.info("Début détection tokens récents...")
    tokens = fetch_tokens_from_dextools()
    processed = process_tokens(tokens)

    with open(OUTPUT_PATH, "w") as f:
        json.dump(processed, f, indent=2)

    flagged = [t for t in processed if t["is_flagged"]]
    logger.info(f"{len(flagged)} tokens récents identifiés.")

    return flagged


if __name__ == "__main__":
    run_early_token_detection()
import csv
import os
from datetime import datetime, timezone
from src.v2.integrations.binance_api import get_binance_subaccount_balances
from src.v2.integrations.kucoin_api import get_kucoin_subaccount_balances
from src/v2.utils.logger import get_logger

logger = get_logger("subaccount_tracker")

OUTPUT_FILE = "src/v2/data/risk/subaccount_balances.csv"

# Liste des sous-comptes à suivre
SUBACCOUNTS = ["trading", "securite", "entreprise", "bfr"]

def write_balances_to_csv(platform, balances):
    date_str = datetime.now().strftime("%Y-%m-%d")

    # Vérifie si le fichier existe
    file_exists = os.path.isfile(OUTPUT_FILE)

    with open(OUTPUT_FILE, mode="a", newline="") as csvfile:
        writer = csv.writer(csvfile)

        # En-têtes (écrits une seule fois)
        if not file_exists:
            writer.writerow(["date", "platform", "subaccount", "total_usdt"])

        for subaccount in SUBACCOUNTS:
            total = balances.get(subaccount, 0)
            writer.writerow([date_str, platform, subaccount, total])

def track_all_subaccounts():
    logger.info("📊 Démarrage du suivi des sous-comptes...")

    try:
        binance_balances = get_binance_subaccount_balances(SUBACCOUNTS)
        write_balances_to_csv("binance", binance_balances)
        logger.info("✅ Suivi Binance terminé.")
    except Exception as e:
        logger.exception("❌ Erreur Binance :")

    try:
        kucoin_balances = get_kucoin_subaccount_balances(SUBACCOUNTS)
        write_balances_to_csv("kucoin", kucoin_balances)
        logger.info("✅ Suivi KuCoin terminé.")
    except Exception as e:
        logger.exception("❌ Erreur KuCoin :")

if __name__ == "__main__":
    track_all_subaccounts()
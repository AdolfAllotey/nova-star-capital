import os
import asyncio
from datetime import datetime, timezone
from telethon.sync import TelegramClient
from telethon.errors import SessionPasswordNeededError
from telethon.tl.types import PeerChannel

from src.v2.utils.file_utils import (
    load_json_file,
    save_json_file,
    ensure_directory_exists,
)
from src.v2.utils.logger import get_logger

# Configuration
LOG_PATH = "src/v2/logs/telegram_scraper.log"
GROUPS_FILE_PATH = "src/v2/groups.json"
OUTPUT_PATH = "src/v2/data/social/telegram_data.json"
logger = get_logger("telegram_scraper")

# Chargement des identifiants depuis les variables d’environnement
API_ID = os.getenv("TELEGRAM_API_ID")
API_HASH = os.getenv("TELEGRAM_API_HASH")
PHONE = os.getenv("TELEGRAM_PHONE")

async def scrape_telegram():
    logger.info("🚀 Connexion au client Telegram...")
    client = TelegramClient("session_name", API_ID, API_HASH)

    await client.start(PHONE)

    # Chargement des groupes
    raw_groups = load_json_file(GROUPS_FILE_PATH, fallback=[])

    # Gestion du format : liste de strings (IDs) ou liste d’objets avec "name"/"id"
    group_ids = []
    for group in raw_groups:
        if isinstance(group, dict):
            group_id = group.get("id") or group.get("chat_id")
        elif isinstance(group, str) or isinstance(group, int):
            group_id = group
        else:
            continue
        group_ids.append(group_id)

    logger.info(f"📥 {len(group_ids)} groupes à scraper")

    all_messages = []

    for group_id in group_ids:
        try:
            logger.info(f"🔍 Scraping groupe : {group_id}")
            entity = await client.get_entity(PeerChannel(int(group_id)))
            messages = []
            async for message in client.iter_messages(entity, limit=100):
                if message.text:
                    messages.append({
                        "date": message.date.isoformat(),
                        "sender_id": getattr(message.sender_id, "user_id", None),
                        "text": message.text,
                        "group_id": group_id,
                    })
            logger.info(f"✅ {len(messages)} messages collectés pour {group_id}")
            all_messages.extend(messages)
        except Exception as e:
            logger.warning(f"⚠️ Erreur lors du scraping de {group_id} : {e}")

    # Sauvegarde des données
    ensure_directory_exists(OUTPUT_PATH)
    save_json_file(all_messages, OUTPUT_PATH)
    logger.info(f"📦 Données Telegram sauvegardées dans {OUTPUT_PATH}")
import os
import json
from datetime import datetime, timezone
from utils.telegram_bot import send_telegram_message  # Correction import

DATA_FOLDER = "data/v2/earnings"
os.makedirs(DATA_FOLDER, exist_ok=True)

def fetch_earnings_signals():
    """
    Exemple de récupération des signaux depuis une API ou fichier local.
    """
    try:
        with open("data/samples/earnings_signals_sample.json") as f:
            return json.load(f)
    except FileNotFoundError:
        print("❌ Fichier de signaux Earnings non trouvé.")
        return []

def scan_earnings():
    today = datetime.now().strftime("%Y-%m-%d")
    signals = fetch_earnings_signals()

    # Exemple de filtrage basique
    valid_earnings = [s for s in signals if s.get("impact", 0) > 5]

    # Sauvegarde
    out_path = os.path.join(DATA_FOLDER, f"earnings_{today}.json")
    with open(out_path, "w") as f:
        json.dump(valid_earnings, f, indent=2)

    # Envoi Telegram
    if valid_earnings:
        message = f"📡 **Earnings Tracker - {today}**\n"
        message += f"{len(valid_earnings)} signaux détectés :\n"
        for e in valid_earnings[:10]:
            message += f"• {e['token']} - Impact estimé : {e['impact']}\n"
        send_telegram_message(message)
    else:
        send_telegram_message(f"📡 Earnings Tracker - {today} : aucun signal détecté.")

if __name__ == "__main__":
    scan_earnings()
[Unit]
Description=NSC Market Discovery Provider Refresh
Documentation=https://local.nsc.invalid/rc1-02-data-providers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nsc/app

Environment=PYTHONPATH=/opt/nsc/app
Environment=NSC_ENV=PREPROD
Environment=NSC_DATA_DIR=/opt/nsc/data/preprod
Environment=DATA_DIR=/opt/nsc/data/preprod
Environment=NSC_DATA_ROOT=/opt/nsc/data/preprod
Environment=DATA_ROOT=/opt/nsc/data/preprod

EnvironmentFile=-/etc/nsc/nsc.env
EnvironmentFile=-/etc/nsc/preprod.env
EnvironmentFile=-/etc/nsc/bitpanda.env

ExecStart=/opt/nsc/app/scripts/run_market_discovery_refresh.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadWritePaths=/opt/nsc/data
ReadWritePaths=/opt/nsc/data/preprod
ReadWritePaths=/run/lock

StandardOutput=journal
StandardError=journal

TimeoutStartSec=300

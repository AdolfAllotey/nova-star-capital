[Unit]
Description=NSC Offensive Equities Provider-Only Refresh
Documentation=file:/opt/nsc/app/src/v2/equities_offensive/market/providers/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nsc/app

EnvironmentFile=-/etc/nsc/nsc.env
EnvironmentFile=-/etc/nsc/preprod.env
EnvironmentFile=-/etc/nsc/equities-offensive.env

Environment=PYTHONUNBUFFERED=1
Environment=NSC_EQU_ACTION_POLICY=NO_EXECUTION
Environment=NSC_EQU_PROVIDER_REFRESH_ONLY=1

ExecStart=/opt/nsc/app/scripts/nsc-equities-provider-refresh.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/opt/nsc/data/preprod/equities_offensive/market/providers
ReadWritePaths=/run/lock

StandardOutput=journal
StandardError=journal

TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target

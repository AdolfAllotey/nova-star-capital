#!/usr/bin/env bash
set -euo pipefail

cd /opt/nsc/app
export NSC_ENV="${NSC_ENV:-PREPROD}"

ERR_FILE="/tmp/nsc_preprod_check.err"
OUT_JSON="data/telemetry/preprod_check.json"
OUT_MD="data/telemetry/preprod_check.md"

mkdir -p "$(dirname "$OUT_JSON")"
rm -f "$ERR_FILE"

run_step () {
  name="$1"
  mod="$2"
  set +e
  python -m "$mod" 1>/dev/null 2>>"$ERR_FILE"
  rc=$?
  set -e
  echo "$rc"
}

rc_gov=$(run_step "governance"       "src.v2.analysis.governance_engine_pro" || echo 1)
rc_exec=$(run_step "execution"       "src.v2.analysis.execution_engine_pro"  || echo 1)
rc_pm=$(run_step "position_manager"  "src.v2.trading.position_manager"       || echo 1)
rc_te=$(run_step "trading_executor"  "src.v2.trading.trading_executor"       || echo 1)
rc_tf=$(run_step "transfer_funds"    "src.v2.operations.transfer_funds"      || echo 1)

# --- Assertions (métier) ---
gov_ok=false
plan_ok=false
exec_ok=false

nomut_ok=null
nomut_detail="n/a"
reasons_gov="[]"

simplan_ok=false
simplan_mode_ok=false
simplan_schema_ok=null
simplan_fresh_ok=null
simplan_consistency_ok=null
simplan_schema_detail="n/a"
simplan_fresh_detail="n/a"
simplan_consistency_detail="n/a"

exchange_router_ok=null
exchange_router_detail="n/a"

transfer_funds_frozen_ok=null
transfer_funds_frozen_value="n/a"

knowplan_ok=false
knowplan_detail="n/a"

# governance hard_block
if [ -f data/analysis/governance_engine_pro.json ]; then
  if jq -e '.hard_block == true' data/analysis/governance_engine_pro.json >/dev/null 2>&1; then
    gov_ok=true
  fi
  reasons_gov="$(jq -c '.reasons // []' data/analysis/governance_engine_pro.json 2>/dev/null || echo '[]')"
fi

# execution_plan blocked + orders=0
if [ -f data/trading/execution_plan.json ]; then
  if jq -e '.status == "blocked" and (.orders|type=="array") and (.orders|length == 0)' data/trading/execution_plan.json >/dev/null 2>&1; then
    plan_ok=true
  fi
fi

# execution_engine blocked
if [ -f data/analysis/execution_engine_pro.json ]; then
  if jq -e '(.stats.global_flag == "blocked") and (.stats.orders_out == 0)' data/analysis/execution_engine_pro.json >/dev/null 2>&1; then
    exec_ok=true
  fi
fi

# open_positions no mutation (idempotence)
if [ -f data/trading/open_positions.json ]; then
  sha_before="$(sha256sum data/trading/open_positions.json | awk '{print $1}')"
  python -m src.v2.trading.position_manager 1>/dev/null 2>>"$ERR_FILE" || true
  sha_after="$(sha256sum data/trading/open_positions.json | awk '{print $1}')"
  if [ "$sha_before" = "$sha_after" ]; then
    nomut_ok=true
  else
    nomut_ok=false
  fi
  nomut_detail="before=$sha_before after=$sha_after"
fi

# --- PREPROD simulated plan assertions (optional but enforced if PREPROD_SIMULATE_ORDERS=true) ---
if [ "${PREPROD_SIMULATE_ORDERS:-false}" = "true" ]; then
  if [ -f data/trading/execution_plan_simulated.json ]; then
    if jq -e '(.orders|type=="array") and (.orders|length > 0)' data/trading/execution_plan_simulated.json >/dev/null 2>&1; then
      simplan_ok=true
    fi
    if jq -e '(.execution_mode == "SIMULATED_ONLY") and (.status == "simulated")' data/trading/execution_plan_simulated.json >/dev/null 2>&1; then
      simplan_mode_ok=true
    fi

    # schema minimal orders: chaque ordre a symbol/side/qty (ou quantity) + type
    set +e
    python - <<'PY' 1>/dev/null 2>>/tmp/nsc_preprod_check.err
import json
p="data/trading/execution_plan_simulated.json"
d=json.load(open(p,"r",encoding="utf-8"))
orders=d.get("orders") or []
ok=True
for o in orders:
    if not isinstance(o, dict):
        ok=False; break
    sym=o.get("symbol") or o.get("ticker")
    side=o.get("side")
    qty=o.get("qty") or o.get("quantity") or o.get("amount")
    typ=o.get("type") or o.get("order_type") or "market"
    if not sym or not side or qty is None:
        ok=False; break
print("OK" if ok else "FAIL")
PY
    rc_schema=$?
    set -e
    if [ "$rc_schema" -eq 0 ]; then
      simplan_schema_ok=true
      simplan_schema_detail="ok"
    else
      simplan_schema_ok=false
      simplan_schema_detail="schema_check_failed"
    fi

    # freshness: timestamp/ generated_at present + aligns with execution_engine timestamp (if available)
    ts_exec="$(jq -r '.stats.timestamp // .timestamp // ""' data/analysis/execution_engine_pro.json 2>/dev/null || echo "")"
    ts_plan="$(jq -r '.timestamp // .generated_at // ""' data/trading/execution_plan_simulated.json 2>/dev/null || echo "")"
    if [ -n "$ts_exec" ] && [ -n "$ts_plan" ]; then
      # accept equality or very small drift (<=60s) if both are ISO
      # compare only if python can parse
      set +e
      diff_s="$(python - <<PY 2>/dev/null
from datetime import datetime
def parse(x):
    return datetime.fromisoformat(x.replace("Z","+00:00"))
try:
    a=parse("$ts_exec"); b=parse("$ts_plan")
    print(int(abs((a-b).total_seconds())))
except Exception:
    print("999999")
PY
)"
      set -e
      if [ "$diff_s" -le 60 ]; then
        simplan_fresh_ok=true
      else
        simplan_fresh_ok=false
      fi
      simplan_fresh_detail="ts_exec=$ts_exec ts_plan=$ts_plan diff_s=$diff_s"
    else
      simplan_fresh_ok=false
      simplan_fresh_detail="missing_timestamp ts_exec=$ts_exec ts_plan=$ts_plan"
    fi

    # consistency: orders_candidate == orders_len
    oc="$(jq -r '.stats.orders_candidate // ""' data/analysis/execution_engine_pro.json 2>/dev/null || echo "")"
    ol="$(jq -r '(.orders|length)' data/trading/execution_plan_simulated.json 2>/dev/null || echo "")"
    if [ -n "$oc" ] && [ -n "$ol" ] && [ "$oc" = "$ol" ]; then
      simplan_consistency_ok=true
    else
      simplan_consistency_ok=false
    fi
    simplan_consistency_detail="orders_candidate=$oc orders_len=$ol"
  else
    simplan_ok=false
    simplan_mode_ok=false
    simplan_schema_ok=false
    simplan_fresh_ok=false
    simplan_consistency_ok=false
  fi
fi

# exchange_router hard-gate blocks (should block in PREPROD)
set +e
exr="$(python - <<'PY' 2>/dev/null
from src.v2.integrations.exchange_router import place_order
print(place_order("BTCUSDT", 0.001, "buy"))
PY
)"
rc_exr=$?
set -e
if [ "$rc_exr" -eq 0 ] && echo "$exr" | grep -q '"status": "blocked"'; then
  exchange_router_ok=true
else
  exchange_router_ok=false
fi
exchange_router_detail="$(echo "$exr" | tr '\n' ' ' | sed 's/"/\\"/g')"

# transfer_funds frozen (must be True)
set +e
tf_frozen="$(python - <<'PY' 2>/dev/null
import importlib
m=importlib.import_module("src.v2.operations.transfer_funds")
print(getattr(m,"FROZEN",None))
PY
)"
rc_tfrozen=$?
set -e
if [ "$rc_tfrozen" -eq 0 ] && [ "$tf_frozen" = "True" ]; then
  transfer_funds_frozen_ok=true
else
  transfer_funds_frozen_ok=false
fi
transfer_funds_frozen_value="$tf_frozen"

# knowledge uses effective execution_plan path
if [ -f data/knowledge/knowledge_daily.json ]; then
  want="execution_plan.json"
  if [ "${PREPROD_SIMULATE_ORDERS:-false}" = "true" ] && [ -f data/trading/execution_plan_simulated.json ]; then
    want="execution_plan_simulated.json"
  fi
  got="$(jq -r '.trading.execution_plan_path // ""' data/knowledge/knowledge_daily.json 2>/dev/null || echo "")"
  if echo "$got" | grep -q "$want"; then
    knowplan_ok=true
  else
    knowplan_ok=false
  fi
  knowplan_detail="want=$want got=$got"
fi

ok=true
for rc in "$rc_gov" "$rc_exec" "$rc_pm" "$rc_te" "$rc_tf"; do
  if [ "$rc" -ne 0 ]; then ok=false; fi
done

# base assertions always required
if [ "$gov_ok" != "true" ] || [ "$plan_ok" != "true" ] || [ "$exec_ok" != "true" ]; then
  ok=false
fi
if [ "$nomut_ok" = "false" ]; then
  ok=false
fi

# additional safety assertions always required
if [ "$exchange_router_ok" != "true" ] || [ "$transfer_funds_frozen_ok" != "true" ] || [ "$knowplan_ok" != "true" ]; then
  ok=false
fi

# if sim mode enabled => require simplan checks
if [ "${PREPROD_SIMULATE_ORDERS:-false}" = "true" ]; then
  if [ "$simplan_ok" != "true" ] || [ "$simplan_mode_ok" != "true" ] || [ "$simplan_schema_ok" != "true" ] || [ "$simplan_fresh_ok" != "true" ] || [ "$simplan_consistency_ok" != "true" ]; then
    ok=false
  fi
fi

cat > "$OUT_JSON" <<JSON
{
  "ok": $ok,
  "env": "$(echo "$NSC_ENV" | tr '[:lower:]' '[:upper:]')",
  "return_codes": {
    "governance": $rc_gov,
    "execution": $rc_exec,
    "position_manager": $rc_pm,
    "trading_executor": $rc_te,
    "transfer_funds": $rc_tf
  },
  "assertions": {
    "governance_hard_block_true": $gov_ok,
    "execution_plan_blocked_orders0": $plan_ok,
    "execution_engine_blocked_orders_out0": $exec_ok,
    "open_positions_no_mutation": $nomut_ok,

    "execution_plan_simulated_exists_orders_gt0": $simplan_ok,
    "execution_plan_simulated_mode_ok": $simplan_mode_ok,
    "execution_plan_simulated_orders_schema_ok": $simplan_schema_ok,
    "execution_plan_simulated_fresh_vs_execution_engine": $simplan_fresh_ok,
    "execution_plan_simulated_consistent_orders_candidate": $simplan_consistency_ok,

    "exchange_router_hard_gate_blocks": $exchange_router_ok,
    "transfer_funds_is_frozen": $transfer_funds_frozen_ok,
    "knowledge_execution_plan_path_matches_effective": $knowplan_ok
  },
  "details": {
    "open_positions_no_mutation": "$(echo "$nomut_detail" | sed 's/"/\\"/g')",
    "execution_plan_simulated_schema_detail": "$(echo "$simplan_schema_detail" | sed 's/"/\\"/g')",
    "execution_plan_simulated_fresh_detail": "$(echo "$simplan_fresh_detail" | sed 's/"/\\"/g')",
    "execution_plan_simulated_consistency_detail": "$(echo "$simplan_consistency_detail" | sed 's/"/\\"/g')",
    "exchange_router_place_order_result": "$(echo "$exchange_router_detail" | sed 's/"/\\"/g')",
    "transfer_funds_frozen_value": "$(echo "$transfer_funds_frozen_value" | sed 's/"/\\"/g')",
    "knowledge_execution_plan_path_detail": "$(echo "$knowplan_detail" | sed 's/"/\\"/g')",
    "governance_reasons": $reasons_gov
  }
}
JSON

{
  echo "# NSC PREPROD CHECK"
  echo
  echo "- env: \`$NSC_ENV\`"
  echo "- ok: \`$ok\`"
  echo
  echo "## Return codes"
  echo "- governance: $rc_gov"
  echo "- execution: $rc_exec"
  echo "- position_manager: $rc_pm"
  echo "- trading_executor: $rc_te"
  echo "- transfer_funds: $rc_tf"
  echo
  echo "## Assertions"
  echo "- governance hard_block = true: $gov_ok"
  echo "- execution_plan blocked + orders=0: $plan_ok"
  echo "- execution_engine blocked + orders_out=0: $exec_ok"
  echo "- open_positions no mutation: $nomut_ok"
  echo "- simulated plan ok: $simplan_ok"
  echo "- simulated mode ok: $simplan_mode_ok"
  echo "- simulated schema ok: $simplan_schema_ok"
  echo "- simulated fresh ok: $simplan_fresh_ok"
  echo "- simulated consistent ok: $simplan_consistency_ok"
  echo "- exchange_router hard-gate blocks: $exchange_router_ok"
  echo "- transfer_funds frozen: $transfer_funds_frozen_ok"
  echo "- knowledge uses effective execution_plan path: $knowplan_ok"
  echo
  echo "## Details"
  echo "- $knowplan_detail"
  echo "- simplan_fresh: $simplan_fresh_detail"
  echo "- simplan_consistency: $simplan_consistency_detail"
  echo "- exchange_router: $exchange_router_detail"
  echo "- transfer_funds FROZEN: $transfer_funds_frozen_value"
  echo
  echo "## Governance reasons"
  echo "$reasons_gov" | jq -r '.[]' 2>/dev/null | sed 's/^/- /' || true
  echo
  echo "## Stderr (last 80 lines)"
  tail -n 80 "$ERR_FILE" 2>/dev/null || true
} > "$OUT_MD"

echo "✅ wrote $OUT_JSON"
echo "✅ wrote $OUT_MD"

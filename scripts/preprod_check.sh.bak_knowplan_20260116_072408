#!/usr/bin/env bash
set -euo pipefail

# NSC_PATCH: audit_grade_assertions BEGIN
cd /opt/nsc/app
export NSC_ENV="${NSC_ENV:-PREPROD}"

ERR_FILE="/tmp/nsc_preprod_check.err"
OUT_JSON="data/telemetry/preprod_check.json"
OUT_MD="data/telemetry/preprod_check.md"

mkdir -p "$(dirname "$OUT_JSON")"
rm -f "$ERR_FILE"

run_step () {
  name="$1"
  mod="$2"
  # IMPORTANT: ne pas laisser set -e tuer le script si le module échoue
  set +e
  python -m "$mod" 1>/dev/null 2>>"$ERR_FILE"
  rc=$?
  set -e
  echo "$rc"
}

rc_gov=$(run_step "governance"       "src.v2.analysis.governance_engine_pro" || echo 1)
rc_exec=$(run_step "execution"       "src.v2.analysis.execution_engine_pro"  || echo 1)
rc_pm=$(run_step "position_manager"  "src.v2.trading.position_manager"       || echo 1)
rc_te=$(run_step "trading_executor"  "src.v2.trading.trading_executor"       || echo 1)
rc_tf=$(run_step "transfer_funds"    "src.v2.operations.transfer_funds"      || echo 1)

# --- Assertions (métier) ---
gov_ok=false
plan_ok=false
exec_ok=false
simplan_ok=false
simplan_mode_ok=false
simplan_schema_ok=false
simplan_schema_detail="n/a"
fresh_ok=false
fresh_detail="n/a"
consistency_ok=false
consistency_detail="n/a"
nomut_ok=null
nomut_detail="n/a"
reasons_gov="[]"

exrouter_ok=false
exrouter_detail="n/a"

tf_frozen_ok=false
tf_frozen_detail="n/a"

if [ -f data/analysis/governance_engine_pro.json ]; then
  if jq -e '.hard_block == true' data/analysis/governance_engine_pro.json >/dev/null 2>&1; then
    gov_ok=true
  fi
  reasons_gov="$(jq -c '.reasons // []' data/analysis/governance_engine_pro.json 2>/dev/null || echo '[]')"
fi

if [ -f data/trading/execution_plan.json ]; then
  if jq -e '.status == "blocked" and (.orders|type=="array") and (.orders|length == 0)' data/trading/execution_plan.json >/dev/null 2>&1; then
    plan_ok=true
  fi
fi

if [ -f data/analysis/execution_engine_pro.json ]; then
  if jq -e '(.stats.global_flag == "blocked") and (.stats.orders_out == 0)' data/analysis/execution_engine_pro.json >/dev/null 2>&1; then
    exec_ok=true
  fi
fi

# --- Simulated execution plan assertions (PREPROD) ---
if [ -f data/trading/execution_plan_simulated.json ]; then
  if jq -e '(.status=="simulated") and (.execution_mode=="SIMULATED_ONLY") and (.orders|type=="array") and (.orders|length > 0)' data/trading/execution_plan_simulated.json >/dev/null 2>&1; then
    simplan_ok=true
  fi
  if jq -e '(.execution_mode=="SIMULATED_ONLY")' data/trading/execution_plan_simulated.json >/dev/null 2>&1; then
    simplan_mode_ok=true
  fi
fi

# --- Simulated orders schema check (audit-grade) ---
if [ -f data/trading/execution_plan_simulated.json ]; then
  # Contrat minimal:
  # - symbol: string non vide
  # - side: buy|sell
  # - amount ou quantity: number > 0
  # NB: on tolère amount OU quantity selon les modules.
  if jq -e '
      (.orders|type=="array") and (.orders|length>0) and
      (all(.orders[]?;
        (.symbol|type=="string" and length>0) and
        (.side|type=="string" and (ascii_downcase=="buy" or ascii_downcase=="sell")) and
        (
          ((.amount? // empty) | (type=="number" and .>0)) or
          ((.quantity? // empty) | (type=="number" and .>0))
        )
      ))
    ' data/trading/execution_plan_simulated.json >/dev/null 2>&1; then
    simplan_schema_ok=true
  else
    simplan_schema_ok=false
    # capture une ligne utile (1er ordre invalide)
    simplan_schema_detail="$(jq -c '
      (.orders // []) as $o
      | ( [range(0; ($o|length))] | map(select(
          ($o[.] | (.symbol|type!="string" or (.symbol|length==0))) or
          ($o[.] | (.side|type!="string" or ((.side|ascii_downcase)!="buy" and (.side|ascii_downcase)!="sell"))) or
          ($o[.] | ( ((.amount? // null) == null and (.quantity? // null) == null) or
                    ((.amount? // null) != null and ((.amount|type)!="number" or (.amount<=0))) or
                    ((.quantity? // null) != null and ((.quantity|type)!="number" or (.quantity<=0)))
                  ))
        )) | .[0] // null ) as $idx
      | {first_bad_index:$idx, first_bad_order: (if $idx==null then null else $o[$idx] end)}
    ' data/trading/execution_plan_simulated.json 2>/dev/null || echo '{}')"
  fi
fi

# --- Freshness / anti-stale (audit-grade) ---
# Compare execution_engine.stats.timestamp with execution_plan_simulated.{timestamp|generated_at}
if [ -f data/analysis/execution_engine_pro.json ] && [ -f data/trading/execution_plan_simulated.json ]; then
  ts_exec="$(jq -r '.stats.timestamp // empty' data/analysis/execution_engine_pro.json 2>/dev/null || true)"
  ts_plan="$(jq -r '.timestamp // .generated_at // empty' data/trading/execution_plan_simulated.json 2>/dev/null || true)"

  if [ -n "$ts_exec" ] && [ -n "$ts_plan" ]; then
    # Convert ISO8601 -> epoch (seconds). If parsing fails => freshness false.
    exec_epoch="$(date -d "$ts_exec" +%s 2>/dev/null || echo "")"
    plan_epoch="$(date -d "$ts_plan" +%s 2>/dev/null || echo "")"
    if [ -n "$exec_epoch" ] && [ -n "$plan_epoch" ]; then
      diff=$(( exec_epoch > plan_epoch ? exec_epoch - plan_epoch : plan_epoch - exec_epoch ))
      # threshold: 600s (10 min)
      if [ "$diff" -le 600 ]; then
        fresh_ok=true
      else
        fresh_ok=false
      fi
      fresh_detail="ts_exec=$ts_exec ts_plan=$ts_plan diff_s=$diff"
    else
      fresh_ok=false
      fresh_detail="cannot_parse_epoch ts_exec=$ts_exec ts_plan=$ts_plan"
    fi
  else
    fresh_ok=false
    fresh_detail="missing_timestamp ts_exec=$ts_exec ts_plan=$ts_plan"
  fi
fi

# --- Consistency (candidate orders vs simulated plan orders) ---
if [ -f data/analysis/execution_engine_pro.json ] && [ -f data/trading/execution_plan_simulated.json ]; then
  cand="$(jq -r '.stats.orders_candidate // empty' data/analysis/execution_engine_pro.json 2>/dev/null || true)"
  olen="$(jq -r '.orders | length' data/trading/execution_plan_simulated.json 2>/dev/null || true)"
  if [[ "$cand" =~ ^[0-9]+$ ]] && [[ "$olen" =~ ^[0-9]+$ ]]; then
    # tolérance: exact match
    if [ "$cand" -eq "$olen" ]; then
      consistency_ok=true
    else
      consistency_ok=false
    fi
    consistency_detail="orders_candidate=$cand orders_len=$olen"
  else
    consistency_ok=false
    consistency_detail="missing_or_nonint cand=$cand olen=$olen"
  fi
fi


# Position manager must not mutate open_positions.json
if [ -f data/trading/open_positions.json ]; then
  sha_before="$(sha256sum data/trading/open_positions.json | awk '{print $1}')"
  python -m src.v2.trading.position_manager 1>/dev/null 2>>"$ERR_FILE" || true
  sha_after="$(sha256sum data/trading/open_positions.json | awk '{print $1}')"
  if [ "$sha_before" = "$sha_after" ]; then
    nomut_ok=true
  else
    nomut_ok=false
  fi
  nomut_detail="before=$sha_before after=$sha_after"
fi

# Exchange router hard-gate should block (defense-in-depth)
set +e
exrouter_out="$(python - <<'PY'
import json, sys
from src.v2.integrations.exchange_router import place_order
r = place_order("BTCUSDT", 0.001, "buy")
print(json.dumps(r, ensure_ascii=False))
ok = isinstance(r, dict) and r.get("status") == "blocked"
sys.exit(0 if ok else 2)
PY
)"
rc_exrouter=$?
set -e

if [ "$rc_exrouter" -eq 0 ]; then
  exrouter_ok=true
else
  exrouter_ok=false
fi
exrouter_detail="$exrouter_out"

# transfer_funds must be frozen (no-op)
set +e
tf_frozen_out="$(python - <<'PY'
import sys
import src.v2.operations.transfer_funds as tf
v = getattr(tf, "FROZEN", None)
print(v)
sys.exit(0 if v is True else 2)
PY
)"
rc_tff=$?
set -e

if [ "$rc_tff" -eq 0 ]; then
  tf_frozen_ok=true
else
  tf_frozen_ok=false
fi
tf_frozen_detail="$tf_frozen_out"

# Global ok
ok=true
for rc in "$rc_gov" "$rc_exec" "$rc_pm" "$rc_te" "$rc_tf"; do
  if [ "$rc" -ne 0 ]; then ok=false; fi
done

if [ "$gov_ok" != "true" ] || [ "$plan_ok" != "true" ] || [ "$exec_ok" != "true" ] || [ "$simplan_ok" != "true" ] || [ "$simplan_mode_ok" != "true" ] || [ "$simplan_schema_ok" != "true" ] || [ "$fresh_ok" != "true" ] || [ "$consistency_ok" != "true" ]; then
  ok=false
fi
if [ "$nomut_ok" = "false" ]; then
  ok=false
fi
if [ "$exrouter_ok" != "true" ]; then
  ok=false
fi
if [ "$tf_frozen_ok" != "true" ]; then
  ok=false
fi

cat > "$OUT_JSON" <<JSON
{
  "ok": $ok,
  "env": "$(echo "$NSC_ENV" | tr '[:lower:]' '[:upper:]')",
  "return_codes": {
    "governance": $rc_gov,
    "execution": $rc_exec,
    "position_manager": $rc_pm,
    "trading_executor": $rc_te,
    "transfer_funds": $rc_tf
  },
  "assertions": {
    "governance_hard_block_true": $gov_ok,
    "execution_plan_blocked_orders0": $plan_ok,
    "execution_engine_blocked_orders_out0": $exec_ok,
    "open_positions_no_mutation": $nomut_ok,
    "execution_plan_simulated_exists_orders_gt0": $simplan_ok,
    "execution_plan_simulated_mode_ok": $simplan_mode_ok,
    "execution_plan_simulated_orders_schema_ok": $simplan_schema_ok,
    "execution_plan_simulated_fresh_vs_execution_engine": $fresh_ok,
    "execution_plan_simulated_consistent_orders_candidate": $consistency_ok,
    "exchange_router_hard_gate_blocks": $exrouter_ok,
    "transfer_funds_is_frozen": $tf_frozen_ok
  },
  "details": {
    "open_positions_no_mutation": "$(echo "$nomut_detail" | sed 's/"/\\"/g')",
    "execution_plan_simulated_schema_detail": "$(echo "$simplan_schema_detail" | sed 's/"/\\\"/g')",
    "execution_plan_simulated_fresh_detail": "$(echo "$fresh_detail" | sed 's/"/\\\"/g')",
    "execution_plan_simulated_consistency_detail": "$(echo "$consistency_detail" | sed 's/"/\\\"/g')",
    "governance_reasons": $reasons_gov,
    "exchange_router_place_order_result": "$(echo "$exrouter_detail" | sed 's/"/\\"/g')",
    "transfer_funds_frozen_value": "$(echo "$tf_frozen_detail" | sed 's/"/\\"/g')"
  }
}
JSON

{
  echo "# NSC PREPROD CHECK"
  echo
  echo "- env: \`$NSC_ENV\`"
  echo "- ok: \`$ok\`"
  echo
  echo "## Return codes"
  echo "- governance: $rc_gov"
  echo "- execution: $rc_exec"
  echo "- position_manager: $rc_pm"
  echo "- trading_executor: $rc_te"
  echo "- transfer_funds: $rc_tf"
  echo
  echo "## Assertions"
  echo "- governance hard_block = true: $gov_ok"
  echo "- execution_plan blocked + orders=0: $plan_ok"
  echo "- execution_engine blocked + orders_out=0: $exec_ok"
  echo "- open_positions no mutation: $nomut_ok"
  echo "- execution_plan_simulated exists + orders>0: $simplan_ok"
  echo "- execution_plan_simulated mode SIMULATED_ONLY: $simplan_mode_ok"
  echo "- execution_plan_simulated orders schema OK: $simplan_schema_ok"
  echo
  echo "## Freshness / consistency"
  echo "- simulated plan fresh vs execution_engine (<=10min): $fresh_ok"
  echo "- detail: $fresh_detail"
  echo "- simulated plan consistent with orders_candidate: $consistency_ok"
  echo "- detail: $consistency_detail"
  echo
  echo "## Simulated schema detail (if any)"
  echo "$simplan_schema_detail"

  echo "- exchange_router hard-gate blocks: $exrouter_ok"
  echo "- transfer_funds frozen: $tf_frozen_ok"
  echo
  echo "## Governance reasons"
  echo "$reasons_gov" | jq -r '.[]' 2>/dev/null | sed 's/^/- /' || true
  echo
  echo "## exchange_router place_order result"
  echo "- $exrouter_detail"
  echo
  echo "## transfer_funds FROZEN"
  echo "- $tf_frozen_detail"
  echo
  echo "## Stderr (last 80 lines)"
  tail -n 80 "$ERR_FILE" 2>/dev/null || true
} > "$OUT_MD"

echo "✅ wrote $OUT_JSON"
echo "✅ wrote $OUT_MD"
# NSC_PATCH: audit_grade_assertions END

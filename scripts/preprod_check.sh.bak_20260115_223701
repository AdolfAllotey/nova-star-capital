#!/usr/bin/env bash
set -uo pipefail

cd /opt/nsc/app
export NSC_ENV="${NSC_ENV:-PREPROD}"

ERR_FILE="/tmp/nsc_preprod_check.err"
OUT_JSON="data/telemetry/preprod_check.json"
OUT_MD="data/telemetry/preprod_check.md"

mkdir -p data/telemetry
rm -f "$ERR_FILE"

# Timeout global par step (secondes)
STEP_TIMEOUT="${STEP_TIMEOUT:-20}"

run_step () {
  local name="$1"
  local mod="$2"
  echo "== $name =="

  # Forcer certains modules à ne pas daemoniser pendant le check
  if [ "$name" = "transfer_funds" ]; then
    export TRANSFER_FUNDS_DAEMON="false"
  fi

  timeout "${STEP_TIMEOUT}s" python -m "$mod" 1>/dev/null 2>>"$ERR_FILE"
  local rc=$?

  if [ $rc -eq 0 ]; then
    echo "OK"
  elif [ $rc -eq 124 ]; then
    echo "TIMEOUT rc=124 (>${STEP_TIMEOUT}s)"
  else
    echo "FAIL rc=$rc"
  fi
  echo
  echo "$rc"
}

rc_gov=$(run_step "governance"       "src.v2.analysis.governance_engine_pro" | tail -n 1)
rc_exec=$(run_step "execution"        "src.v2.analysis.execution_engine_pro" | tail -n 1)
rc_pm=$(run_step  "position_manager" "src.v2.trading.position_manager" | tail -n 1)
rc_te=$(run_step  "trading_executor" "src.v2.trading.trading_executor" | tail -n 1)
rc_tf=$(run_step  "transfer_funds"   "src.v2.operations.transfer_funds" | tail -n 1)

gov=$(jq -c '.' data/analysis/governance_engine_pro.json 2>/dev/null || echo '{}')
plan=$(jq -c '.' data/trading/execution_plan.json 2>/dev/null || echo '{}')
exec=$(jq -c '.' data/analysis/execution_engine_pro.json 2>/dev/null || echo '{}')
ks=$(jq -c '.' data/trading/kill_switch.json 2>/dev/null || echo '{}')
stats=$(echo "$exec" | jq -c '.stats // . // {}' 2>/dev/null || echo '{}')

ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

jq -n \
  --arg ts "$ts" \
  --arg env "$NSC_ENV" \
  --argjson rc_gov "$rc_gov" \
  --argjson rc_exec "$rc_exec" \
  --argjson rc_pm "$rc_pm" \
  --argjson rc_te "$rc_te" \
  --argjson rc_tf "$rc_tf" \
  --argjson governance "$gov" \
  --argjson execution_plan "$plan" \
  --argjson kill_switch "$ks" \
  --argjson execution_engine "$exec" \
  --argjson stats "$stats" \
  --arg stderr_tail "$(tail -n 120 "$ERR_FILE" 2>/dev/null || true)" \
  '{
    timestamp_utc: $ts,
    env: $env,
    return_codes: {
      governance: $rc_gov,
      execution: $rc_exec,
      position_manager: $rc_pm,
      trading_executor: $rc_te,
      transfer_funds: $rc_tf
    },
    ok: (([$rc_gov,$rc_exec,$rc_pm,$rc_te,$rc_tf] | map(.==0) | all)),
    governance: $governance,
    execution_plan: $execution_plan,
    kill_switch: $kill_switch,
    execution_engine: $execution_engine,
    stats: $stats,
    stderr_tail: $stderr_tail
  }' > "$OUT_JSON"

{
  echo "# NSC PREPROD CHECK"
  echo
  echo "- Timestamp (UTC): $ts"
  echo "- NSC_ENV: $NSC_ENV"
  echo "- STEP_TIMEOUT: ${STEP_TIMEOUT}s"
  echo
  echo "## Return codes"
  echo "- governance: $rc_gov"
  echo "- execution: $rc_exec"
  echo "- position_manager: $rc_pm"
  echo "- trading_executor: $rc_te"
  echo "- transfer_funds: $rc_tf"
  echo
  echo "## Governance"
  echo '```json'
  jq '{hard_block,reasons,correlation_gate_active:(.correlation.gate.active // null)}' data/analysis/governance_engine_pro.json 2>/dev/null || echo "{}"
  echo '```'
  echo
  echo "## Execution plan"
  echo '```json'
  jq '{status,orders,reasons}' data/trading/execution_plan.json 2>/dev/null || echo "{}"
  echo '```'
  echo
  echo "## Execution engine stats"
  echo '```json'
  jq '.stats // . // {}' data/analysis/execution_engine_pro.json 2>/dev/null || echo "{}"
  echo '```'
  echo
  echo "## stderr tail"
  echo '```'
  tail -n 120 "$ERR_FILE" 2>/dev/null || true
  echo '```'
} > "$OUT_MD"

echo "✅ wrote $OUT_JSON"
echo "✅ wrote $OUT_MD"
